<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Vulkan compute backend for dotLLM — cross-vendor GPU path (AMD, NVIDIA, Intel) via SPIR-V compute shaders loaded through raw vulkan-1 P/Invoke. Complements DotLLM.Cuda (NVIDIA-only) with a portable target per the Silk.NET/Vulkan analysis in docs/CUDA.md.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotLLM.Tests.Unit" />
    <InternalsVisibleTo Include="IoProbe" />
    <InternalsVisibleTo Include="VerifyRowCurve" />
    <InternalsVisibleTo Include="DotLLM.Tests.Integration" />
    <InternalsVisibleTo Include="DotLLM.Benchmarks" />
    <InternalsVisibleTo Include="DotLLM.Cuda" />
    <InternalsVisibleTo Include="Qwen4ExpRowProbe" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotLLM.Core\DotLLM.Core.csproj" />
    <ProjectReference Include="..\DotLLM.Cpu\DotLLM.Cpu.csproj" />
    <ProjectReference Include="..\DotLLM.Models\DotLLM.Models.csproj" />
  </ItemGroup>

  <!-- #1304: Windows DirectStorage weight loading. The package is native-only (no managed assembly), so it is referenced for
       restore only (no assets flow, not a nuspec dependency) and its two DLLs are copied next to the assembly for local and
       development builds. They are NOT redistributed in release artifacts: the Microsoft DirectStorage SDK licence permits
       redistribution only with flow-down end-user terms and an indemnity to Microsoft (section 2.b), which an open-source
       release should not take on by default. Release builds set DotLLMBundleDirectStorage=false (release.yml); users who want
       the feature obtain the DLLs themselves (add the Microsoft.Direct3D.DirectStorage package, or copy the two DLLs next to
       the executable). When the DLLs are absent at run time the loader falls back to the staging path, so a missing DLL is never an error. -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <PackageReference Include="Microsoft.Direct3D.DirectStorage" PrivateAssets="all" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(OS)' == 'Windows_NT' And '$(PkgMicrosoft_Direct3D_DirectStorage)' != '' And '$(DotLLMBundleDirectStorage)' != 'false'">
    <Content Include="$(PkgMicrosoft_Direct3D_DirectStorage)\native\bin\x64\dstorage.dll" Link="dstorage.dll" CopyToOutputDirectory="PreserveNewest" Pack="false" />
    <Content Include="$(PkgMicrosoft_Direct3D_DirectStorage)\native\bin\x64\dstoragecore.dll" Link="dstoragecore.dll" CopyToOutputDirectory="PreserveNewest" Pack="false" />
  </ItemGroup>

  <!-- Pre-compiled SPIR-V shaders ship alongside the managed assembly.
       End users need the Vulkan SDK (glslc) only to rebuild shaders from source;
       the .spv blobs checked into native/vulkan/spv/ are loaded verbatim at runtime. -->
  <ItemGroup>
    <Content Include="..\..\native\vulkan\spv\*.spv" Link="spv\%(Filename)%(Extension)" Condition="Exists('..\..\native\vulkan\spv\')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- GLSL to SPIR-V compilation: .comp to .spv via glslc (Vulkan SDK).
       Runs automatically during build if glslc is in PATH.
       Skipped when Vulkan SDK is not installed (end users get pre-compiled SPIR-V from the repo). -->
  <PropertyGroup>
    <VulkanShaderDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', '..', 'native', 'vulkan', 'shaders'))</VulkanShaderDir>
    <SpvOutputDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', '..', 'native', 'vulkan', 'spv'))</SpvOutputDir>
    <VulkanTargetEnv>vulkan1.2</VulkanTargetEnv>
  </PropertyGroup>

  <ItemGroup>
    <VulkanShader Include="$(VulkanShaderDir)\*.comp" />
  </ItemGroup>

  <!-- glslc pin (#1364). SPIR-V bytes depend on the glslc version, so tracked .spv are only (re)written by the
       toolchain recorded in native/vulkan/glslc.version. A different glslc would rewrite ~30 tracked blobs with
       equivalent-but-different bytes and dirty every worktree/PR, so an ordinary build SKIPS compiling (with a
       warning) on a mismatch. Opt-ins:
         -p:DotLLMStrictSpv=true         mismatch is an error (CI / release)
         dotnet msbuild -t:RegenerateVulkanShaders   rebuild EVERY .spv now (warns on mismatch; use after
                                          changing a .comp, then bump glslc.version if the toolchain changed) -->
  <PropertyGroup>
    <GlslcPinFile>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', '..', 'native', 'vulkan', 'glslc.version'))</GlslcPinFile>
  </PropertyGroup>

  <Target Name="_DetectGlslc">
    <ReadLinesFromFile File="$(GlslcPinFile)" Condition="Exists('$(GlslcPinFile)')">
      <Output TaskParameter="Lines" ItemName="_GlslcPinLine" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_GlslcPin>@(_GlslcPinLine)</_GlslcPin>
    </PropertyGroup>
    <Exec Command="glslc --version" IgnoreExitCode="true" ConsoleToMSBuild="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_GlslcExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="_GlslcVersionLine" />
    </Exec>
    <PropertyGroup>
      <_GlslcAllLines>@(_GlslcVersionLine->'%(Identity)', '|')</_GlslcAllLines>
      <_GlslcFirstLine Condition="'$(_GlslcAllLines)' != ''">$(_GlslcAllLines.Split('|')[0])</_GlslcFirstLine>
      <_GlslcMatchesPin Condition="'$(_GlslcExitCode)' == '0' And '$(_GlslcPin)' != '' And $(_GlslcFirstLine.StartsWith('$(_GlslcPin)'))">true</_GlslcMatchesPin>
    </PropertyGroup>
  </Target>

  <!-- Incremental compile of stale .comp files. Writes only when glslc matches the pin. -->
  <Target Name="CompileVulkanShaders"
          BeforeTargets="BeforeBuild"
          DependsOnTargets="_DetectGlslc"
          Inputs="@(VulkanShader)"
          Outputs="@(VulkanShader->'$(SpvOutputDir)\%(Filename).spv')">
    <Message Condition="'$(_GlslcExitCode)' != '0'" Importance="high"
             Text="WARNING: .comp source is newer than .spv but glslc not found in PATH. Pre-compiled SPIR-V may be stale. Install the Vulkan SDK to auto-compile shaders." />
    <Error Condition="'$(_GlslcExitCode)' == '0' And '$(_GlslcMatchesPin)' != 'true' And '$(DotLLMStrictSpv)' == 'true'"
           Text="glslc '$(_GlslcFirstLine)' does not match the pinned '$(_GlslcPin)' (native/vulkan/glslc.version). Install the pinned shaderc or run -t:RegenerateVulkanShaders and bump the pin (#1364)." />
    <Warning Condition="'$(_GlslcExitCode)' == '0' And '$(_GlslcMatchesPin)' != 'true'"
             Text="glslc '$(_GlslcFirstLine)' does not match the pinned '$(_GlslcPin)' (native/vulkan/glslc.version); NOT recompiling tracked .spv so the tree stays clean (#1364). Use -t:RegenerateVulkanShaders to force." />

    <MakeDir Condition="'$(_GlslcMatchesPin)' == 'true'" Directories="$(SpvOutputDir)" />
    <Message Condition="'$(_GlslcMatchesPin)' == 'true'" Importance="high" Text="Compiling %(VulkanShader.Filename).comp to SPIR-V" />
    <Exec Condition="'$(_GlslcMatchesPin)' == 'true'"
          Command="glslc --target-env=$(VulkanTargetEnv) -O -o &quot;$(SpvOutputDir)/%(VulkanShader.Filename).spv&quot; &quot;%(VulkanShader.FullPath)&quot;"
          StandardOutputImportance="low" />
  </Target>

  <!-- Explicit regenerate: rebuilds every .spv regardless of timestamps or glslc version. -->
  <Target Name="RegenerateVulkanShaders" DependsOnTargets="_DetectGlslc">
    <Error Condition="'$(_GlslcExitCode)' != '0'" Text="glslc not found in PATH." />
    <Warning Condition="'$(_GlslcMatchesPin)' != 'true'"
             Text="Regenerating with glslc '$(_GlslcFirstLine)' != pinned '$(_GlslcPin)': every changed .spv will need review and glslc.version must be bumped (#1364)." />
    <MakeDir Directories="$(SpvOutputDir)" />
    <Exec Command="glslc --target-env=$(VulkanTargetEnv) -O -o &quot;$(SpvOutputDir)/%(VulkanShader.Filename).spv&quot; &quot;%(VulkanShader.FullPath)&quot;"
          StandardOutputImportance="low" />
  </Target>

</Project>
