<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Not packed yet: becomes a package when DotLLM.Server references it (chunk-cache execution PR). -->
    <IsPackable>false</IsPackable>
    <Description>Chunk-level KV reuse for dotLLM — encode a token chunk's per-layer K/V in isolation, then assemble cached chunks into a KV-cache at new offsets with RoPE re-rotation of the keys; chunk keys and text-first chunkers. No Roslyn and no Vulkan dependency.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotLLM.Core\DotLLM.Core.csproj" />
    <ProjectReference Include="..\DotLLM.Cpu\DotLLM.Cpu.csproj" />
    <ProjectReference Include="..\DotLLM.Engine\DotLLM.Engine.csproj" />
    <ProjectReference Include="..\DotLLM.Models\DotLLM.Models.csproj" />
    <ProjectReference Include="..\DotLLM.Tokenizers\DotLLM.Tokenizers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotLLM.Tests.Unit" />
  </ItemGroup>

</Project>
