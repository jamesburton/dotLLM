<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Not packed yet: becomes a package when DotLLM.Server references it (chunk-cache execution PR). -->
    <IsPackable>false</IsPackable>
    <Description>Chunk-level KV reuse for dotLLM — encode a token chunk's per-layer K/V in isolation, then assemble cached chunks into a KV-cache at new offsets with RoPE re-rotation of the keys; chunk keys, text-first chunkers and the on-disk chunk store. No Roslyn and no Vulkan dependency (see DotLLM.ChunkReuse.CSharp and DotLLM.ChunkReuse.Vulkan).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotLLM.Core\DotLLM.Core.csproj" />
    <ProjectReference Include="..\DotLLM.Cpu\DotLLM.Cpu.csproj" />
    <ProjectReference Include="..\DotLLM.Engine\DotLLM.Engine.csproj" />
    <ProjectReference Include="..\DotLLM.Models\DotLLM.Models.csproj" />
    <ProjectReference Include="..\DotLLM.Tokenizers\DotLLM.Tokenizers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- FileChunkStore.BeforeRenameForTest: lets tests hold the destination open between write and rename. -->
    <InternalsVisibleTo Include="DotLLM.Tests.Unit" />
    <InternalsVisibleTo Include="DotLLM.ChunkReuse.CSharp" />
    <!-- The chunkcache CLI resolves its store root option through StorePaths.CanonicalRoot before a destructive pass. -->
    <InternalsVisibleTo Include="chunkcache" />
    <!-- VulkanChunkBackend reads CpuChunkBackend.RowCount. -->
    <InternalsVisibleTo Include="DotLLM.ChunkReuse.Vulkan" />
  </ItemGroup>

</Project>
