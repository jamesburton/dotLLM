<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>CUDA GPU backend for dotLLM — PTX kernels loaded via the CUDA Driver API for attention, dequant, matmul, RoPE, softmax, and RMSNorm. Supports CPU/GPU hybrid offloading and KV-cache quantization.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotLLM.Tests.Unit" />
    <InternalsVisibleTo Include="DotLLM.Tests.Integration" />
    <InternalsVisibleTo Include="DotLLM.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotLLM.Core\DotLLM.Core.csproj" />
    <ProjectReference Include="..\DotLLM.Cpu\DotLLM.Cpu.csproj" />
    <ProjectReference Include="..\DotLLM.Engine\DotLLM.Engine.csproj" />
    <ProjectReference Include="..\DotLLM.Models\DotLLM.Models.csproj" />
    <ProjectReference Include="..\DotLLM.Vulkan\DotLLM.Vulkan.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\native\ptx\*.ptx" Link="ptx\%(Filename)%(Extension)" Condition="Exists('..\..\native\ptx\')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- CUDA PTX compilation: .cu to .ptx via nvcc (native/msbuild/CudaPtx.targets).
       Default mode uses the committed PTX and compiles only new/modified kernels; it never fails
       the build when no or a newer toolkit is installed (CPU-only users get pre-compiled PTX). -->
  <PropertyGroup>
    <CudaKernelDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', '..', 'native', 'kernels'))</CudaKernelDir>
    <PtxOutputDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', '..', 'native', 'ptx'))</PtxOutputDir>
    <!-- compute_75 = Turing, the CUDA 13 floor (CUDA 13 dropped Pascal/Volta sm_61/7.0).
         PTX is forward-compatible so this runs on Turing/Ampere/Ada/Hopper/Blackwell. -->
    <CudaArch>compute_75</CudaArch>
  </PropertyGroup>

  <!-- All .cu kernel files, default to precise math and the global arch -->
  <ItemGroup>
    <CudaKernel Include="$(CudaKernelDir)\*.cu">
      <FastMathFlag></FastMathFlag>
      <FmadFlag></FmadFlag>
      <CxxStdFlag></CxxStdFlag>
      <Arch>$(CudaArch)</Arch>
    </CudaKernel>
    <!-- Kernels using CUDA Cooperative Groups (grid.sync()) need libcu++ (cccl), which requires
         at least C++17 — nvcc's default dialect for this MSVC toolchain is lower, failing with
         "libcu++ requires at least C++ 17" otherwise. Mirrors build_ptx.bat's CXX17 list
         (issue #180's gdn_scan_step_f32_coop_split4; issue #183's attention_f32_split_kv adds
         the same need to attention_f32.cu). Scoped to only the kernels that need it. -->
    <CudaKernel Update="$(CudaKernelDir)\gated_delta_net_scan.cu;$(CudaKernelDir)\attention_f32.cu;$(CudaKernelDir)\attention_flash_mma_decode_gqa_split.cu;$(CudaKernelDir)\attention_flash_mma_decode_gqa_split_kvq.cu;$(CudaKernelDir)\attention_flash_mma_prefill_hd256.cu;$(CudaKernelDir)\attention_flash_mma_prefill_hd256_kvq.cu">
      <CxxStdFlag>-std=c++17</CxxStdFlag>
    </CudaKernel>
    <!-- Ampere-only kernels (mma.sync.m16n8k16 / cp.async is sm_80+): the global compute_75
         default cannot express these instructions, so nvcc silently produces a PTX file that
         parses fine at build time but fails to JIT at module-load time on the actual device
         (CudaKernels.cs catches that as CudaException and leaves the kernel unloaded/disabled —
         no build error, no crash, just the kernel silently never dispatching). Found 2026-08-01
         when editing attention_flash_mma.cu for a bank-conflict fix: dotnet build alone (without
         this override) regenerated wrong-arch PTX and the flash-attention parity test failed with
         "Flash mma kernel not loaded" — build_ptx.bat's ARCH_86 list already had the fix, this
         mirrors it into the MSBuild path so plain `dotnet build` cannot silently regress it again.
         These kernels are dispatch-gated to GeForce-Ampere-or-newer devices in C# (see
         CudaFlashAttention.ConfigureDefault / CudaAttentionMmaDecodeGqaSplit), so raising their
         arch does not reduce portability for the rest of the PTX tree. -->
    <CudaKernel Update="$(CudaKernelDir)\pq2_0_mmq_mma.cu;$(CudaKernelDir)\attention_flash_mma.cu;$(CudaKernelDir)\attention_flash_mma_decode_gqa_split.cu;$(CudaKernelDir)\attention_flash_mma_decode_gqa_split_kvq.cu;$(CudaKernelDir)\attention_flash_mma_prefill_hd256.cu;$(CudaKernelDir)\attention_flash_mma_prefill_hd256_kvq.cu">
      <Arch>compute_86</Arch>
    </CudaKernel>
    <!-- Element-wise kernels: safe for fast_math (no expf/rsqrtf/sinf/cosf accumulation) -->
    <CudaKernel Update="$(CudaKernelDir)\add.cu;$(CudaKernelDir)\add_f32.cu;$(CudaKernelDir)\swiglu.cu;$(CudaKernelDir)\swiglu_f32.cu;$(CudaKernelDir)\convert.cu;$(CudaKernelDir)\bias_add.cu;$(CudaKernelDir)\bias_add_f32.cu;$(CudaKernelDir)\embedding.cu;$(CudaKernelDir)\embedding_f32out.cu;$(CudaKernelDir)\dequant.cu;$(CudaKernelDir)\quant_kv.cu">
      <FastMathFlag>--use_fast_math</FastMathFlag>
    </CudaKernel>
    <!-- Kernels requiring fmad=false for bit-perfect / numerical parity with the CPU
         scalar reference. .NET RyuJIT does not emit FMA from `a*b+c` patterns without
         an explicit MathF.FusedMultiplyAdd call, so leaving nvcc's default (fmad=true)
         produces ~1 ULP drift per accumulation versus the CPU's separate mul+add. The
         Qwen3MoeHybrid recurrence (GDN) compounds those tiny errors over time steps,
         so the kernels backing it must be compiled with FMA fusion disabled.
         elementwise_f32.cu hosts sigmoid/silu/sigmoid_mul (host fallbacks the agent
         is replacing) and is here for the same reason. -->
    <CudaKernel Update="$(CudaKernelDir)\lfm2.cu;$(CudaKernelDir)\conv1d_causal.cu;$(CudaKernelDir)\gated_delta_net_scan.cu;$(CudaKernelDir)\elementwise_f32.cu;$(CudaKernelDir)\mamba2_selective_scan.cu;$(CudaKernelDir)\mamba3_data_rope_f32.cu;$(CudaKernelDir)\mamba3_chunk_boundary_f32.cu;$(CudaKernelDir)\mamba3_ssd_scan_siso_f32.cu;$(CudaKernelDir)\mamba3_ssd_scan_mimo_f32.cu;$(CudaKernelDir)\hadamard_fwht.cu">
      <FmadFlag>-fmad=false</FmadFlag>
    </CudaKernel>
  </ItemGroup>

  <!-- The CompileCudaPtx target (toolkit/host-compiler resolution, PTX ISA pinning, never failing the
       build on a newer CUDA SDK or Visual Studio) lives in native/msbuild/CudaPtx.targets. Modes and
       knobs: DotLLMCudaBuildMode=auto|committed|compile|skip, DotLLMCudaToolkitPath, DotLLMMsvcBinDir,
       DotLLMPtxVersionPolicy=pin|native|strict. See docs/CUDA.md "Building on newer CUDA SDKs" (#1635). -->
  <Import Project="..\..\native\msbuild\CudaPtx.targets" />

</Project>
