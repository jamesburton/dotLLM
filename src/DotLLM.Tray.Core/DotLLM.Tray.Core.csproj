<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-only by design (#455 v1 scope is a Windows system tray). A `-windows` TFM rather
         than plain `net10.0` plus the deprecated Microsoft.Win32.Registry package, because the
         autostart store and the job-object process runner are both Win32.
         EnableWindowsTargeting keeps `dotnet build` green on the ubuntu-latest CI runner, which
         builds the whole solution. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
    <RootNamespace>DotLLM.Tray</RootNamespace>
  </PropertyGroup>

</Project>
