<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>chunkcache</ToolCommandName>
    <!-- The release workflow passes the repo variable CHUNKCACHE_TOOL_PACKAGE_ID as ChunkCacheToolPackageId (unset keeps this id).
         The command stays `chunkcache` whatever the package is called. See docs/PACKAGING.md. -->
    <PackageId>dotllm-chunkcache</PackageId>
    <PackageId Condition="'$(ChunkCacheToolPackageId)' != ''">$(ChunkCacheToolPackageId)</PackageId>
    <PackageTags>llm;kv-cache;chunk-cache;dotllm;agents;mcp;dotnet-tool</PackageTags>
    <AssemblyName>chunkcache</AssemblyName>
    <RootNamespace>DotLLM.ChunkCache</RootNamespace>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <Description>chunkcache (research): build, select, status, evict and compare for dotLLM chunk-level KV reuse over a .NET solution or a source directory.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Version from the git tag, like every project under src/ (tools/ does not inherit src/Directory.Build.props). -->
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotLLM.ChunkCache.Client\DotLLM.ChunkCache.Client.csproj" />
    <ProjectReference Include="..\..\src\DotLLM.ChunkReuse\DotLLM.ChunkReuse.csproj" />
    <ProjectReference Include="..\..\src\DotLLM.ChunkReuse.CSharp\DotLLM.ChunkReuse.CSharp.csproj" />
    <ProjectReference Include="..\..\src\DotLLM.ChunkReuse.Solution\DotLLM.ChunkReuse.Solution.csproj" />
    <ProjectReference Include="..\..\src\DotLLM.Models\DotLLM.Models.csproj" />
    <ProjectReference Include="..\..\src\DotLLM.Tokenizers\DotLLM.Tokenizers.csproj" />
    <ProjectReference Include="..\..\src\DotLLM.Engine\DotLLM.Engine.csproj" />
    <ProjectReference Include="..\..\src\DotLLM.Cpu\DotLLM.Cpu.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotLLM.Tests.Unit" />
  </ItemGroup>

</Project>
