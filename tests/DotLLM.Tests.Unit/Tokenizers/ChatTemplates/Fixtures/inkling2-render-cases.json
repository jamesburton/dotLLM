 {
  "name": "multi_turn_reasoning",
  "context": {
   "messages": [
    {
     "role": "user",
     "content": "Hi"
    },
    {
     "role": "assistant",
     "content": "Hello!",
     "reasoning_content": "greet"
    },
    {
     "role": "user",
     "content": "Again"
    }
   ]
  },
  "expected": "<|message_system|><|content_text|>Thinking effort level: 0.9<|end_message|><|message_user|><|content_text|>Hi<|end_message|><|message_model|><|content_thinking|>greet<|end_message|><|message_model|><|content_text|>Hello!<|end_message|><|content_model_end_sampling|><|message_user|><|content_text|>Again<|end_message|>"
 },
