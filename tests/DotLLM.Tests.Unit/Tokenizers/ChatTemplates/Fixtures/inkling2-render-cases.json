  "expected": "<|message_system|><|content_text|>Thinking effort level: 0.9<|end_message|><|message_user|><|content_text|>Hi<|end_message|><|message_model|>Ada<|content_text|>Hello!<|end_message|><|content_model_end_sampling|><|message_user|><|content_text|>Again<|end_message|>"
 },
 {
  "name": "tools_declared",
  "context": {
   "messages": [
    {
     "role": "user",
     "content": "Weather in Paris?"
    }
   ],
   "tools": [
    {
     "type": "function",
     "function": {
      "name": "get_weather",
      "description": "Météo ☃ lookup",
      "parameters": {
       "type": "object",
       "properties": {
        "city": {
         "type": "string"
        },
        "days": {
         "type": "integer"
        }
       },
       "required": [
        "city"
       ]
      }
     }
    }
   ]
  },
  "expected": "<|message_system|>tool_declare<|content_xml|>[{\"description\":\"Météo ☃ lookup\",\"name\":\"get_weather\",\"parameters\":{\"properties\":{\"city\":{\"type\":\"string\"},\"days\":{\"type\":\"integer\"}},\"required\":[\"city\"],\"type\":\"object\"},\"type\":\"function\"}]<|end_message|><|message_system|><|content_text|>Thinking effort level: 0.9<|end_message|><|message_user|><|content_text|>Weather in Paris?<|end_message|>"
 },
 {
  "name": "tool_call_roundtrip",
  "context": {
   "messages": [
    {
     "role": "user",
     "content": "Weather in Paris?"
    },
    {
     "role": "assistant",
     "content": "",
     "tool_calls": [
      {
       "id": "c1",
       "type": "function",
       "function": {
        "name": "get_weather",
        "arguments": {
         "days": 3,
         "city": "Paris"
        }
       }
      }
     ]
    },
    {
     "role": "tool",
     "content": "sunny",
     "tool_call_id": "c1"
    },
    {
     "role": "user",
     "content": "thanks"
    }
   ],
   "tools": [
    {
     "type": "function",
     "function": {
      "name": "get_weather",
      "description": "Météo ☃ lookup",
      "parameters": {
       "type": "object",
       "properties": {
        "city": {
         "type": "string"
        },
        "days": {
         "type": "integer"
        }
       },
       "required": [
        "city"
       ]
      }
     }
    }
   ]
  },
  "expected": "<|message_system|>tool_declare<|content_xml|>[{\"description\":\"Météo ☃ lookup\",\"name\":\"get_weather\",\"parameters\":{\"properties\":{\"city\":{\"type\":\"string\"},\"days\":{\"type\":\"integer\"}},\"required\":[\"city\"],\"type\":\"object\"},\"type\":\"function\"}]<|end_message|><|message_system|><|content_text|>Thinking effort level: 0.9<|end_message|><|message_user|><|content_text|>Weather in Paris?<|end_message|><|message_model|>get_weather<|content_invoke_tool_json|>{\"name\":\"get_weather\",\"args\":{\"city\":\"Paris\",\"days\":3}}<|end_message|><|content_model_end_sampling|><|message_tool|>get_weather<|content_text|>sunny<|end_message|><|message_user|><|content_text|>thanks<|end_message|>"
 },
