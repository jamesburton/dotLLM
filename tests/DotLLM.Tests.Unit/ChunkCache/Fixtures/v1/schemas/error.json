{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CLI --json error document (Task 17 known divergence c): the only property is error; exit_code is a CLI extra inside it",
  "type": "object",
  "required": ["error"],
  "additionalProperties": false,
  "properties": {
    "error": {"type": "object", "required": ["code", "message"], "properties": {
      "code": {"type": "string"}, "message": {"type": "string"}, "exit_code": {"type": "integer"}}}
  }
}
