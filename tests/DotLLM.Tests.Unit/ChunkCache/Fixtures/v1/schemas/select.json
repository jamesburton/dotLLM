      "tokens": {"type": "integer"}, "hash": {"type": "string"}, "reason": {"type": "string"}, "detail": {"type": "string"},
      "hop": {"type": "integer"}, "stored": {"type": "boolean"}, "text": {"type": "string"}}}},
