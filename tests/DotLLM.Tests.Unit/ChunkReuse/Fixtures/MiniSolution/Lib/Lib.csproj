<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Multi-targeted: scanned once (net10.0, the first Roslyn project by name), the other target reported. -->
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Greeter.Greet exists only with this project's symbol: a BCL-only compilation (no defines) cannot see it. -->
    <DefineConstants>$(DefineConstants);MINI_GREETING</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- Also compiled by App: one file, two projects. -->
    <Compile Include="..\Shared\BuildInfo.cs" Link="BuildInfo.cs" />
  </ItemGroup>
</Project>