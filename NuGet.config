<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Preview track only. The SDK pinned in global.json is a dogfood build, and its
         matching Microsoft.NET.ILLink.Tasks is published to the .NET nightly feed rather
         than nuget.org. Without this source NuGet resolves forward to whichever preview
         nuget.org happens to carry, and NU1603 (escalated by TreatWarningsAsErrors)
         fails the build. Do NOT port this file to dev/main. -->
    <add key="dotnet11" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet11/nuget/v3/index.json" protocolVersion="3" />
    <!-- Locally built dotnet/runtime (C:\dotnet-runtime, branch `dev`) Shipping packages.
         `Avx512Bf16` (VDPBF16PS) exists ONLY in our fork — no nightly SDK ships it — so the
         targeting/runtime packs for this track must come from that local build:
             cd C:\dotnet-runtime
             build.cmd -c Release -s clr+libs+packs+host -clrinterpreter
         Version is fixed at 11.0.0-dev (see Directory.Build.targets). Machine-specific path;
         adjust if the runtime fork lives elsewhere. Do NOT port this file to dev/main. -->
    <add key="local-dotnet-runtime" value="C:\dotnet-runtime\artifacts\packages\Release\Shipping" />
  </packageSources>
  <!-- Central package management makes source mapping mandatory once there is more than
       one source (NU1507). Only the SDK-band packages come from the nightly feed;
       everything else must still resolve from nuget.org so an unexpected nightly build
       cannot silently substitute itself for a normal dependency. -->
  <packageSourceMapping>
    <!-- The local runtime build wins for the framework packs it actually produces; the
         nightly feed still covers the rest of the SDK band. Both sources declare the
         Microsoft.NETCore.App.* pattern, so NuGet queries both and the local 11.0.0-dev
         version is only chosen because Directory.Build.targets asks for it by exact version. -->
    <packageSource key="local-dotnet-runtime">
      <package pattern="Microsoft.NETCore.App.*" />
      <package pattern="Microsoft.DotNet.ILCompiler*" />
      <package pattern="runtime.*.Microsoft.*" />
    </packageSource>
    <packageSource key="dotnet11">
      <package pattern="Microsoft.NET.ILLink.*" />
      <package pattern="Microsoft.NETCore.App.*" />
      <package pattern="Microsoft.AspNetCore.App.*" />
      <package pattern="Microsoft.DotNet.ILCompiler*" />
      <package pattern="runtime.*.Microsoft.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
