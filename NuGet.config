<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Preview track only. The SDK pinned in global.json is a dogfood build, and its
         matching Microsoft.NET.ILLink.Tasks is published to the .NET nightly feed rather
         than nuget.org. Without this source NuGet resolves forward to whichever preview
         nuget.org happens to carry, and NU1603 (escalated by TreatWarningsAsErrors)
         fails the build. Do NOT port this file to dev/main. -->
    <add key="dotnet11" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet11/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- Central package management makes source mapping mandatory once there is more than
       one source (NU1507). Only the SDK-band packages come from the nightly feed;
       everything else must still resolve from nuget.org so an unexpected nightly build
       cannot silently substitute itself for a normal dependency. -->
  <packageSourceMapping>
    <packageSource key="dotnet11">
      <package pattern="Microsoft.NET.ILLink.*" />
      <package pattern="Microsoft.NETCore.App.*" />
      <package pattern="Microsoft.AspNetCore.App.*" />
      <package pattern="Microsoft.DotNet.ILCompiler*" />
      <package pattern="runtime.*.Microsoft.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
