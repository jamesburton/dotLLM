#version 450
// TurboQuant (MSE stage) KV encode from FP32 — the GPU port of
// DotLLM.Engine.KvCache.Codecs.TurboQuantCodec.Encode (useQjl = false).
//
// Per fresh K/V head-vector x (dimension headDim, a power of two <= 256):
//   norm   = ||x||
//   unit   = x / norm                              (zero vector -> zeros, norm 0)
//   s      = (1/sqrt(d)) * H * (D * unit)          // forward RHT: sign-flip, WHT, normalize
//   code_i = argmin_j |s_i - centroids[j]|         // nearest Lloyd-Max centroid
// then pack code_i (mseBits each, LSB-first) into the vector's uint-aligned code slot and
// store norm in the cache's norm format (0 = F32, 1 = F16, 2 = BF16; the codec is
// DotLLM.Engine.KvCache.Codecs.TurboQuantNormCodec).
//
// BYTE-EXACT with the CPU codec and the CUDA kernel (#1892): the norm's sum of squares is the same
// fixed pairwise tree (lane t holds x_t^2, then l[t] += l[t+r] for r = d/2 .. 1), sqrt and the
// per-element divide are IEEE single, and nothing in the normalise / rotate / distance arithmetic may
// contract to FMA (every such value is `precise`, i.e. NoContraction). An exact equidistant tie
// between two centroids picks the LOWER index (strict `<` in an ascending scan).
//
// Dispatch: one workgroup per head-vector (gl_WorkGroupID.x = wg), local_size_x = 256, one
// thread per coordinate. Source rows are contiguous activation K/V [seqLen, numKvHeads*headDim];
// wg -> srcRow = wg/numKvHeads, h = wg%numKvHeads; destination head-vector index is
// (startPos + srcRow)*numKvHeads + h. Each workgroup writes its own (disjoint, uint-aligned)
// code uints, so output uints are single-writer — no atomics, no pre-zeroing required.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufSrc  { float src[]; };
layout(set = 0, binding = 1, std430) readonly  buffer BufCent { float centroids[]; };
layout(set = 0, binding = 2, std430) readonly  buffer BufSign { float signs[]; };
layout(set = 0, binding = 3, std430) writeonly buffer BufCode { uint  codes[]; };
layout(set = 0, binding = 4, std430) coherent buffer BufNorm { uint norms[]; }; // F32: 1 uint/vec; F16/BF16: 2 vecs/uint

layout(push_constant) uniform PushConstants {
    uint headDim;          // power of two, <= 256
    uint numKvHeads;
    uint mseBits;          // 1..8
    uint codeUintsPerVec;  // ceil(codeBytes/4) — uint stride between head-vectors' codes
    uint levelCount;       // 1 << mseBits
    uint startPos;         // position of srcRow 0 (contiguous append)
    float invSqrtD;        // 1/sqrt(headDim)
    uint normFormat;       // 0 = F32, 1 = F16, 2 = BF16
} pc;

shared float sh[256];   // working buffer: x^2 reduction, then rotated coords
shared uint  idx[256];  // per-coordinate centroid index

// GLSL sqrt and `/` are only 1-3 ULP accurate (AMD's sqrt and divide are not correctly rounded), but the CPU codec and the CUDA
// kernel use IEEE round-to-nearest. These refine the hardware result to the correctly rounded value: take the
// hardware answer, score its +-2 ULP neighbours by the residual (computed with a fused multiply-add) and keep the
// smallest. sqrt picks the min |c*c - x| (monotone in |c - sqrt(x)|; two candidates are only confused when equally
// close to within ~2^-24 relative, a ~1e-7 event). Division picks the min |a - c*b| exactly, ties to even.
// Always 0, but not provably so to the shader compiler (levelCount <= 256).
uint opaqueZero() { return pc.levelCount >> 9u; }

float sqrtRn(float x) {
    if (!(x > 0.0) || isinf(x)) return sqrt(x);
    uint yb = floatBitsToUint(sqrt(x)) + opaqueZero();   // opaque: the driver folds fma(sqrt(x),sqrt(x),-x) to 0
    float y = uintBitsToFloat(yb);
    float best = y;
    precise float bestR = abs(fma(y, y, -x));
    for (int k = -2; k <= 2; k++) {
        if (k == 0) continue;
        float c = uintBitsToFloat(yb + uint(k));
        precise float r = abs(fma(c, c, -x));
        if (r < bestR) { bestR = r; best = c; }
    }
    return best;
}

// a >= 0, b > 0, both finite normal.
float divRnPos(float a, float b) {
    if (a == 0.0) return 0.0;
    uint qb = floatBitsToUint(a / b) + opaqueZero();    // opaque: fma(-q,b,a) would be folded to 0
    float q = uintBitsToFloat(qb);
    float best = q;
    precise float bestR = abs(fma(-q, b, a));
    for (int k = -2; k <= 2; k++) {
        if (k == 0) continue;
        uint cb = qb + uint(k);
        float c = uintBitsToFloat(cb);
        precise float r = abs(fma(-c, b, a));
        if (r < bestR || (r == bestR && (cb & 1u) == 0u && (floatBitsToUint(best) & 1u) != 0u)) { bestR = r; best = c; }
    }
    return best;
}

// IEEE binary16 round-to-nearest-even of a finite x in [0, 65504] (the caller saturates).
uint floatToHalfRne(float x) {
    uint b = floatBitsToUint(x);
    uint e = (b >> 23u) & 0xFFu;
    if (e < 113u) {
        // subnormal half (or zero): units of 2^-24; the scale is exact, roundEven is RNE.
        return uint(roundEven(x * 16777216.0));
    }
    uint m = b & 0x7FFFFFu;
    uint mant = m >> 13u;
    uint rem  = m & 0x1FFFu;
    uint r = ((e - 112u) << 10u) | mant;
    if (rem > 0x1000u || (rem == 0x1000u && (mant & 1u) != 0u)) r += 1u;
    return r;
}

void main() {
    uint wg = gl_WorkGroupID.x;
    uint t  = gl_LocalInvocationID.x;
    uint d  = pc.headDim;
    bool live = t < d;

    uint srcRow = wg / pc.numKvHeads;
    uint h      = wg - srcRow * pc.numKvHeads;
    uint stride = pc.numKvHeads * d;
    uint srcOff = srcRow * stride + h * d;

    // --- norm = ||x|| via shared tree reduction ---
    float xt = live ? src[srcOff + t] : 0.0;
    precise float xsq = xt * xt;
    sh[t] = xsq;
    barrier();
    for (uint s = d >> 1u; s > 0u; s >>= 1u) {
        if (t < s) { precise float acc = sh[t] + sh[t + s]; sh[t] = acc; }
        barrier();
    }
    precise float norm = sqrtRn(sh[0]);
    barrier(); // sh[0] read complete before sh is reused

    // --- unit direction → forward RHT (sign-flip, WHT, normalize) ---
    precise float unit = 0.0;
    if (norm > 0.0 && live) {
        float q = divRnPos(abs(xt), norm);
        unit = xt < 0.0 ? -q : q;
    }
    precise float flipped = live ? unit * signs[t] : 0.0;
    sh[t] = flipped;
    barrier();
    for (uint len = 1u; len < d; len <<= 1u) {
        if (live && (t & len) == 0u) {
            float u = sh[t];
            float v = sh[t + len];
            precise float sum  = u + v;
            precise float diff = u - v;
            sh[t]       = sum;
            sh[t + len] = diff;
        }
        barrier();
    }

    // --- nearest centroid (ascending centroids; argmin |s - c|) ---
    if (live) {
        precise float val = sh[t] * pc.invSqrtD;
        uint best = 0u;
        precise float bestD = abs(val - centroids[0]);
        for (uint j = 1u; j < pc.levelCount; j++) {
            precise float dist = abs(val - centroids[j]);
            if (dist < bestD) { bestD = dist; best = j; }
        }
        idx[t] = best;
    }
    barrier();

    // --- assemble code uints (one writer per uint: this workgroup owns them) ---
    uint vecHv      = (pc.startPos + srcRow) * pc.numKvHeads + h;
    uint vecBaseUint = vecHv * pc.codeUintsPerVec;
    if (t < pc.codeUintsPerVec) {
        uint word = 0u;
        uint wordLoBit = t * 32u;          // global bit range [wordLoBit, wordLoBit+32) within the vector
        uint wordHiBit = wordLoBit + 32u;
        // Each coordinate c contributes mseBits at bit offset c*mseBits within the vector.
        uint cStart = wordLoBit / pc.mseBits;                      // first coord that can touch this word
        for (uint c = cStart; c < d; c++) {
            uint cBit = c * pc.mseBits;
            if (cBit >= wordHiBit) break;                          // past this word
            uint code = idx[c];
            // bits of `code` that land in this word
            if (cBit >= wordLoBit) {
                word |= code << (cBit - wordLoBit);
            } else {
                // straddle: low part went to the previous word; high part lands here
                word |= code >> (wordLoBit - cBit);
            }
        }
        codes[vecBaseUint + t] = word;
    }

    if (t == 0u) {
        if (pc.normFormat == 0u) {
            norms[vecHv] = floatBitsToUint(norm);
        } else {
            uint h;
            if (pc.normFormat == 1u) {
                h = floatToHalfRne(min(norm, 65504.0));
            } else {
                uint bits = floatBitsToUint(min(norm, uintBitsToFloat(0x7F7F0000u)));
                bits += 0x7FFFu + ((bits >> 16u) & 1u);
                h = min(bits >> 16u, 0x7F7Fu);
            }
            // two vectors share a uint; each workgroup owns one 16-bit half
            uint shift = (vecHv & 1u) * 16u;
            atomicAnd(norms[vecHv >> 1u], ~(0xFFFFu << shift));
            atomicOr(norms[vecHv >> 1u], h << shift);
        }
    }
}
