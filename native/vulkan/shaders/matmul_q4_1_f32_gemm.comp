#version 450
// Q4_1 (issue #1171, Recursive Flint): the Q4_0 kernel (#1018) with the 20-byte block, value = d * nibble + m.
// Q4_1 batched matrix multiplication (prefill-path GEMM).
//
//   C[N, M] = B[N, K] @ W_q4_1[M, K]^T      with W_q4_1 dequantized on the fly.
//
// Companion to matmul_q4_1_f32_gemv.comp. The byte layout is identical:
// each weight row holds (K / 32) Q4_1 blocks of 20 bytes each (every block word aligned):
//   bytes [0,1]   = fp16 d
//   bytes [2,3]   = fp16 m
//   bytes [4..19] = qs[16] — 32 unsigned nibbles, value = d * nibble + m
//
// Tiling:
//   Output tile  = 16 rows of C (TILE_N) x 16 cols of C (TILE_M) = 256 cells.
//   Workgroup    = (16, 16, 1) = 256 threads, one thread per output cell.
//   K-chunk      = 32 elements (one Q4_1 block).
//
// Per K-chunk we dequantise a 16x32 weight tile into shared memory once and
// reuse it across all 16 token rows of B.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufW { uint  weight[]; };
layout(set = 0, binding = 1, std430) readonly  buffer BufB { float b[]; };
layout(set = 0, binding = 2, std430) writeonly buffer BufC { float c[]; };

layout(push_constant) uniform PushConstants {
    uint M;
    uint K;             // multiple of 32
    uint N;
    uint blocksPerRow;  // = K / 32
    uint rowUints;
} pc;

const uint TILE_M = 16u;
const uint TILE_N = 16u;
const uint CHUNK  = 32u;             // K-chunk = one Q4_1 block
const uint Q4_1_BLOCK_BYTES = 20u;

shared float sharedB[TILE_N * CHUNK];
shared float sharedW[TILE_M * CHUNK];

uint readByte(uint absByteOff) {
    uint u = weight[absByteOff >> 2u];
    uint shift = (absByteOff & 3u) * 8u;
    return (u >> shift) & 0xFFu;
}

void main() {
    uint m = gl_WorkGroupID.x * TILE_M + gl_LocalInvocationID.x;
    uint t = gl_WorkGroupID.y * TILE_N + gl_LocalInvocationID.y;
    uint tid = gl_LocalInvocationID.y * TILE_M + gl_LocalInvocationID.x;

    uint mBase = gl_WorkGroupID.x * TILE_M;
    uint tBase = gl_WorkGroupID.y * TILE_N;

    uint rowByteStride = pc.blocksPerRow * Q4_1_BLOCK_BYTES;

    float acc = 0.0;

    for (uint chunk = 0u; chunk < pc.blocksPerRow; chunk++) {
        uint kBase = chunk * CHUNK;

        // ── 1. Stage sharedB[TILE_N, 32] (16x32 floats). 256 threads load 2 each. ──
        {
            uint flat0 = tid * 2u;
            uint flat1 = flat0 + 1u;

            uint row0 = flat0 >> 5u;
            uint col0 = flat0 - (row0 << 5u);
            uint row1 = flat1 >> 5u;
            uint col1 = flat1 - (row1 << 5u);

            uint tGlobal0 = tBase + row0;
            uint tGlobal1 = tBase + row1;

            float v0 = 0.0;
            float v1 = 0.0;
            if (tGlobal0 < pc.N) v0 = b[tGlobal0 * pc.K + kBase + col0];
            if (tGlobal1 < pc.N) v1 = b[tGlobal1 * pc.K + kBase + col1];
            sharedB[flat0] = v0;
            sharedB[flat1] = v1;
        }

        // ── 2. Dequantize sharedW[TILE_M, 32]. ──
        // 16 weight rows. 16 threads per row, each lane handles 2 columns.
        {
            uint mLocal  = tid >> 4u;             // 0..15
            uint lane    = tid - (mLocal << 4u);  // 0..15
            uint mGlobal = mBase + mLocal;

            vec2 dm = vec2(0.0);
            uint qsBase = 0u;
            bool rowValid = mGlobal < pc.M;
            if (rowValid) {
                uint blockByteBase = mGlobal * rowByteStride + chunk * Q4_1_BLOCK_BYTES;
                dm = unpackHalf2x16(weight[blockByteBase >> 2u]);
                qsBase = blockByteBase + 4u;
            }

            // Each thread writes the lo / hi nibble pair for `lane` -> columns
            // (lane, lane + 16). qs[j]'s low nibble feeds element j; high
            // nibble feeds element j + 16.
            uint colLo = lane;
            uint colHi = lane + 16u;
            float wLo = 0.0;
            float wHi = 0.0;
            if (rowValid) {
                uint byteVal = readByte(qsBase + lane);
                uint nLo = byteVal & 0xFu;
                uint nHi = byteVal >> 4u;
                wLo = dm.x * float(nLo) + dm.y;
                wHi = dm.x * float(nHi) + dm.y;
            }

            uint sBase = mLocal * CHUNK;
            sharedW[sBase + colLo] = wLo;
            sharedW[sBase + colHi] = wHi;
        }

        barrier();

        // ── 3. Partial dot product for this K-chunk. ──
        {
            uint bOff = gl_LocalInvocationID.y * CHUNK;
            uint wOff = gl_LocalInvocationID.x * CHUNK;
            float chunkSum = 0.0;
            for (uint j = 0u; j < CHUNK; j++) {
                chunkSum += sharedB[bOff + j] * sharedW[wOff + j];
            }
            acc += chunkSum;
        }

        barrier();
    }

    if (m < pc.M && t < pc.N) {
        c[t * pc.M + m] = acc;
    }
}
