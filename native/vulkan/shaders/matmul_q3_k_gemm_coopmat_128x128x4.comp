#version 450
// Q3_K batched GEMM on the shared 128x128 blocked coopmat template (issue #598).
//
//   C[N, M] = B[N, K] @ W_q3k[M, K]^T,  W dequantised on the fly.
//
// Weight layout (matches matmul_q3_k_f32_gemm.comp / llama.cpp dequantize_row_q3_K): rows of (K / 256)
// super-blocks of 110 bytes -- hmask[32] [0..31], qs[64] [32..95], scales[12] [96..107] (16 six-bit
// scales, biased by 32), fp16 d [108..109]. 110 is 2 (mod 4), so a block starts on a word boundary or
// 2 bytes into one; every field offset is even, so 16-byte spans are one funnel shift from aligned.
// Element (half h, shift-group j, part p, l) = h*128 + j*32 + p*16 + l: 2 low bits in qs[h*32+p*16+l] at
// bit 2j, high bit in hmask[p*16+l] bit (h*4+j), scale index h*8+j*2+p;
// value = d*(scale-32) * ((qs2 | hbit<<2) - 4). A BK=32 chunk is one (h, j) pair (chunk ch -> super-block
// ch/8, sub = ch%8, h = sub/4, j = sub%4); lane p stages its 16 columns.
//
// PRECISION: as for Q8_0/Q5_0, d*scale*code - dmin*min is folded into the F16 A operand (~2^-11).

#define BM  128
#define BN  128
#define WM  64
#define WN  64
#define NSG 4
#define WAVE 64

#extension GL_GOOGLE_include_directive : require

layout(set = 0, binding = 0, std430) readonly  buffer BufW { uint  weight[]; }; // Q3_K blob
layout(set = 0, binding = 1, std430) readonly  buffer BufB { vec4 b4[]; };      // [N*K]
layout(set = 0, binding = 2, std430) writeonly buffer BufC { float c[]; };      // [N*M]

layout(push_constant) uniform PushConstants {
    uint M;             // output dim (number of weight rows)
    uint K;             // contraction dim (must be a multiple of 256)
    uint N;             // batch size (number of input rows)
    uint blocksPerRow;  // = K / 256 (super-blocks)
    uint rowUints;      // per-row uint stride
} pc;

#include "gemm_coopmat_blocked_decl.glsl"

const uint Q3K_BLOCK_BYTES = 110u;  // Q3_K super-block

const uint A_LANES_PER_ROW = BLOCK_SIZE / BM;        // 2 threads cooperate on one weight row
const uint A_COLS_PER_THR  = BK / A_LANES_PER_ROW;   // 16 codes per thread

uint readByte(uint absByteOff) {
    return (weight[absByteOff >> 2u] >> ((absByteOff & 3u) * 8u)) & 0xFFu;
}

// 16 bytes at EVEN byte offset `o` as four aligned words (funnel shift; the 5th word is loaded only when
// the span is 2 bytes into a word, so nothing past the span -- and never past the blob -- is read).
void load16(uint o, out uint r[4]) {
    uint wi = o >> 2u;
    bool hi = (o & 2u) != 0u;
    uint w[5];
    [[unroll]] for (uint i = 0u; i < 4u; i++) w[i] = weight[wi + i];
    w[4] = hi ? weight[wi + 4u] : 0u;
    [[unroll]] for (uint i = 0u; i < 4u; i++) r[i] = hi ? ((w[i] >> 16) | (w[i + 1u] << 16)) : w[i];
}

void gemmStageA(uint ch) {
    uint rowLocal  = g_tid / A_LANES_PER_ROW;
    uint laneOfRow = g_tid % A_LANES_PER_ROW;      // part p
    uint mGlobal   = g_mBase + rowLocal;
    uint sBase     = rowLocal * STRIDE + laneOfRow * A_COLS_PER_THR;

    if (mGlobal >= pc.M) {
        for (uint j = 0u; j < A_COLS_PER_THR; j++) sharedA[sBase + j] = float16_t(0.0);
        return;
    }

    uint kBlock = ch >> 3u;
    uint sub    = ch & 7u;
    uint h      = sub >> 2u;
    uint jj     = sub & 3u;
    uint blockBase = mGlobal * (pc.blocksPerRow * Q3K_BLOCK_BYTES) + kBlock * Q3K_BLOCK_BYTES;

    // fp16 d at blockBase+108 (even offset => within one word).
    float d = unpackHalf2x16((weight[(blockBase + 108u) >> 2u] >> (((blockBase + 108u) & 2u) * 8u)) & 0xFFFFu).x;

    uint si = h * 8u + jj * 2u + laneOfRow;        // 0..15 scale index
    uint lowNib = (si < 8u) ? (readByte(blockBase + 96u + si) & 0xFu)
                            : ((readByte(blockBase + 96u + si - 8u) >> 4u) & 0xFu);
    uint hiBits = (readByte(blockBase + 96u + 8u + (si & 3u)) >> ((si >> 2u) * 2u)) & 0x3u;
    float scl = d * float(int(lowNib | (hiBits << 4u)) - 32);

    uint qsw[4], hmw[4];
    load16(blockBase + 32u + h * 32u + laneOfRow * 16u, qsw);
    load16(blockBase + laneOfRow * 16u, hmw);

    uint qShift = jj * 2u;
    uint hShift = h * 4u + jj;
    [[unroll]] for (uint i = 0u; i < 4u; i++) {
        uint qv = qsw[i] >> qShift;
        uint hv = hmw[i] >> hShift;
        [[unroll]] for (uint jb = 0u; jb < 4u; jb++) {
            uint q2 = (qv >> (jb * 8u)) & 3u;
            uint hb = (hv >> (jb * 8u)) & 1u;
            sharedA[sBase + i * 4u + jb] = float16_t(scl * float(int(q2 | (hb << 2u)) - 4));
        }
    }
}

#define GEMM_M          pc.M
#define GEMM_K          pc.K
#define GEMM_CHUNKS     (pc.blocksPerRow * 8u)
#define GEMM_ROW_BASE   0u
#define GEMM_ROW_LIMIT  pc.N
#define GEMM_B_BUF      b4
#define GEMM_B_VEC4
#define GEMM_C_BUF      c

#include "gemm_coopmat_blocked_main.glsl"
