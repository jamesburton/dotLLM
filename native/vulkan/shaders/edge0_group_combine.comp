#version 450
// Edge0 latent MoE (G3, #1981): routing-weighted sum of the expert down outputs of ONE D/U group.
//
//   z_g[t, c] = sum_{j < k, labels[indices[t*k+j]] == g} weights[t*k+j] * down[t*k+j, c]      (slot order j ascending, like the CPU oracle)
//
// One dispatch per group g (the push constant); a token with no expert in g gets exact zeros, so U_g z_g = 0 for it.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufDown    { float down[]; };
layout(set = 0, binding = 1, std430) readonly  buffer BufIdx     { int   indices[]; };
layout(set = 0, binding = 2, std430) readonly  buffer BufWeights { float weights[]; };
layout(set = 0, binding = 3, std430) readonly  buffer BufLabels  { int   labels[]; };
layout(set = 0, binding = 4, std430) writeonly buffer BufZ       { float z[]; };

layout(push_constant) uniform PushConstants {
    uint L;
    uint K;
    uint g;
    uint T;
    uint numExperts;
} pc;

void main() {
    uint c = gl_GlobalInvocationID.x;
    uint t = gl_WorkGroupID.y;
    if (c >= pc.L || t >= pc.T) return;
    float acc = 0.0;
    for (uint j = 0u; j < pc.K; j++) {
        uint v = t * pc.K + j;
        uint e = uint(indices[v]);
        if (e < pc.numExperts && uint(labels[e]) == pc.g)
            acc += weights[v] * down[v * pc.L + c];
    }
    z[t * pc.L + c] = acc;
}
