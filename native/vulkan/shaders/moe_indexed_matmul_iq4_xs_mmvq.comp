#version 450
#extension GL_EXT_integer_dot_product        : require
#extension GL_KHR_shader_subgroup_basic      : require
#extension GL_KHR_shader_subgroup_arithmetic : require
// MoE INDEXED IQ4_XS MMVQ decode GEMV (issue #823): the dense matmul_iq4_xs_mmvq.comp lane layout over a packed IQ4_XS expert bank.
//
//   y[n, m] = sum_k dequant_iq4_xs(bank[indices[n], m, k]) * x[n, k]
//
// x is pre-quantized to Q8_1. IQ4_XS = the 16-entry signed-int8 codebook kvalues_iq4nl + a per-32-element signed 6-bit sub-block scale
// dl = d*(ls-32): sum_i w_i*x_i = dl * d_x * dp4a(kvalues[q], xq) per sub-block (= one Q8_1 block). One wave32 subgroup per cell (n, m);
// lane L = sub-block ib = L/4, word w = L%4 over the 32-uint qs region. Reduction: one subgroupAdd.
//
// IQ4_XS super-block (136 bytes / 256 elements): [0,1] fp16 d | [2,3] scales_h | [4..7] scales_l[4] | [8..135] qs[128].
// NOT bit-exact (x is int8-quantized). Dispatch: 2D grid - x = m, y = n.

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufBank { uint  bank[]; };      // IQ4_XS blob [numExperts, M, K/256 x 136 B]
layout(set = 0, binding = 1, std430) readonly  buffer BufXq   { uint  xq[]; };        // [N * K/4]
layout(set = 0, binding = 2, std430) readonly  buffer BufXds  { vec2  xds[]; };       // [N * K/32]
layout(set = 0, binding = 3, std430) readonly  buffer BufIdx  { int   indices[]; };   // [N]
layout(set = 0, binding = 4, std430) writeonly buffer BufY    { float y[]; };         // [N * M]

layout(push_constant) uniform PushConstants {
    uint M;
    uint K;
    uint N;
    uint numExperts;
    uint blocksPerRow;  // K / 256
    uint xDiv;          // activation row = n / xDiv (1 = per-row input; topK = one row broadcast to its topK expert slots)
} pc;

const uint IQ4_XS_BLOCK_BYTES = 136u;

const int KV[16] = int[16](
    -127, -104, -83, -65, -49, -35, -22, -10,
       1,   13,  25,  38,  53,  69,  89, 113
);

uint readByte(uint absByteOff) {
    uint u = bank[absByteOff >> 2u];
    return (u >> ((absByteOff & 3u) * 8u)) & 0xFFu;
}

float readHalf(uint absByteOff) {
    uint alignedIdx = absByteOff >> 2u;
    uint byteInWord = absByteOff & 3u;
    uint u = bank[alignedIdx];
    uint half16;
    if (byteInWord <= 2u) {
        half16 = (u >> (byteInWord * 8u)) & 0xFFFFu;
    } else {
        uint uNext = bank[alignedIdx + 1u];
        half16 = ((u >> 24) & 0xFFu) | ((uNext & 0xFFu) << 8);
    }
    return unpackHalf2x16(half16).x;
}

uint packCB(uint cur, uint s0, uint s1, uint s2, uint s3) {
    return (uint(KV[(cur >> s0) & 0xFu]) & 0xFFu)
         | ((uint(KV[(cur >> s1) & 0xFu]) & 0xFFu) << 8u)
         | ((uint(KV[(cur >> s2) & 0xFu]) & 0xFFu) << 16u)
         | ((uint(KV[(cur >> s3) & 0xFu]) & 0xFFu) << 24u);
}

void main() {
    uint m = gl_WorkGroupID.x;
    uint n = gl_WorkGroupID.y;
    if (m >= pc.M || n >= pc.N) return;

    uint expert = uint(indices[n]);
    if (expert >= pc.numExperts) return;

    uint lane = gl_LocalInvocationID.x;   // 0..31
    uint ib = lane >> 2u;                 // sub-block 0..7
    uint w  = lane & 3u;                  // qs word 0..3

    uint rowByteBase = (expert * pc.M + m) * pc.blocksPerRow * IQ4_XS_BLOCK_BYTES;
    uint xRow        = n / pc.xDiv;
    uint xqRowBase   = xRow * (pc.K >> 2u);
    uint xdsRowBase  = xRow * (pc.K >> 5u);
    float acc = 0.0;

    for (uint blk = 0u; blk < pc.blocksPerRow; blk++) {
        uint blockByteBase = rowByteBase + blk * IQ4_XS_BLOCK_BYTES;
        float d = readHalf(blockByteBase);

        uint scalesH = readByte(blockByteBase + 2u) | (readByte(blockByteBase + 3u) << 8u);
        uint scalesLByte = readByte(blockByteBase + 4u + (ib >> 1u));
        uint low  = (scalesLByte >> (4u * (ib & 1u))) & 0xFu;
        uint high = (scalesH >> (2u * ib)) & 0x3u;
        float dl = d * float(int(low | (high << 4u)) - 32);

        uint cur = bank[((blockByteBase + 8u) >> 2u) + lane];
        uint wLo = packCB(cur, 0u, 8u, 16u, 24u);
        uint wHi = packCB(cur, 4u, 12u, 20u, 28u);

        uint xBase = xqRowBase + blk * 64u + ib * 8u;
        int dotI = dotPacked4x8AccSatEXT(int(wLo), int(xq[xBase + w]), 0);
        dotI = dotPacked4x8AccSatEXT(int(wHi), int(xq[xBase + 4u + w]), dotI);

        float dX = xds[xdsRowBase + blk * 8u + ib].x;
        acc += dl * (dX * float(dotI));
    }

    float total = subgroupAdd(acc);
    if (subgroupElect())
        y[n * pc.M + m] = total;
}
