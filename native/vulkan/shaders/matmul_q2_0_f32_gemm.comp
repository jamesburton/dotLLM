#version 450
// Upstream ggml Q2_0 (issue #2074): derived from matmul_q4_0_f32_gemm.comp. 18-byte blocks of 64 elements: fp16 d + qs[16], element j =
// code (qs[j/4] >> 2*(j%4)) & 3, value = d * (code - 1). The K-chunk stays 32 (half a block), so chunk c is block c/2, half c%2 (bytes 8*half..+7).
// Batched matrix multiplication: C[N, M] = B[N, K] @ W_q2_0[M, K]^T, weights dequantised on the fly into shared memory, never widened.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufW { uint  weight[]; };
layout(set = 0, binding = 1, std430) readonly  buffer BufB { float b[]; };
layout(set = 0, binding = 2, std430) writeonly buffer BufC { float c[]; };

layout(push_constant) uniform PushConstants {
    uint M;
    uint K;             // multiple of 64
    uint N;
    uint blocksPerRow;  // = K / 64
    uint rowUints;
} pc;

const uint TILE_M = 16u;
const uint TILE_N = 16u;
const uint CHUNK  = 32u;             // K-chunk = half a Q2_0 block
const uint Q2_0_BLOCK_BYTES = 18u;

shared float sharedB[TILE_N * CHUNK];
shared float sharedW[TILE_M * CHUNK];

uint readByte(uint absByteOff) {
    uint u = weight[absByteOff >> 2u];
    uint shift = (absByteOff & 3u) * 8u;
    return (u >> shift) & 0xFFu;
}

float readHalf(uint absByteOff) {
    uint alignedIdx = absByteOff >> 2u;
    uint byteInWord = absByteOff & 3u;
    uint u = weight[alignedIdx];
    uint half16;
    if (byteInWord <= 2u) {
        half16 = (u >> (byteInWord * 8u)) & 0xFFFFu;
    } else {
        uint uNext = weight[alignedIdx + 1u];
        half16 = ((u >> 24) & 0xFFu) | ((uNext & 0xFFu) << 8);
    }
    return unpackHalf2x16(half16).x;
}

void main() {
    uint m = gl_WorkGroupID.x * TILE_M + gl_LocalInvocationID.x;
    uint t = gl_WorkGroupID.y * TILE_N + gl_LocalInvocationID.y;
    uint tid = gl_LocalInvocationID.y * TILE_M + gl_LocalInvocationID.x;

    uint mBase = gl_WorkGroupID.x * TILE_M;
    uint tBase = gl_WorkGroupID.y * TILE_N;

    uint rowByteStride = pc.blocksPerRow * Q2_0_BLOCK_BYTES;

    float acc = 0.0;

    for (uint chunk = 0u; chunk < pc.blocksPerRow * 2u; chunk++) {
        uint kBase = chunk * CHUNK;

        // ── 1. Stage sharedB[TILE_N, 32] (16x32 floats). 256 threads load 2 each. ──
        {
            uint flat0 = tid * 2u;
            uint flat1 = flat0 + 1u;

            uint row0 = flat0 >> 5u;
            uint col0 = flat0 - (row0 << 5u);
            uint row1 = flat1 >> 5u;
            uint col1 = flat1 - (row1 << 5u);

            uint tGlobal0 = tBase + row0;
            uint tGlobal1 = tBase + row1;

            float v0 = 0.0;
            float v1 = 0.0;
            if (tGlobal0 < pc.N) v0 = b[tGlobal0 * pc.K + kBase + col0];
            if (tGlobal1 < pc.N) v1 = b[tGlobal1 * pc.K + kBase + col1];
            sharedB[flat0] = v0;
            sharedB[flat1] = v1;
        }

        // ── 2. Dequantize sharedW[TILE_M, 32]. ──
        // 16 weight rows. 16 threads per row, each lane handles 2 columns.
        {
            uint mLocal  = tid >> 4u;             // 0..15
            uint lane    = tid - (mLocal << 4u);  // 0..15
            uint mGlobal = mBase + mLocal;

            float d = 0.0;
            uint qsBase = 0u;
            bool rowValid = mGlobal < pc.M;
            if (rowValid) {
                uint blockByteBase = mGlobal * rowByteStride + (chunk >> 1u) * Q2_0_BLOCK_BYTES;
                d = readHalf(blockByteBase);
                qsBase = blockByteBase + 2u;
            }

            // Each lane writes columns (2*lane, 2*lane+1) of this 32-element half block: elements 32*half + 2*lane + {0,1}.
            float w0 = 0.0;
            float w1 = 0.0;
            if (rowValid) {
                uint e  = (chunk & 1u) * 32u + lane * 2u;           // element index within the 64-element block
                uint bv = readByte(qsBase + (e >> 2u));
                uint sh = (e & 3u) * 2u;                            // lane*2 is even, so both codes sit in the same byte
                w0 = d * float(int((bv >> sh) & 3u) - 1);
                w1 = d * float(int((bv >> (sh + 2u)) & 3u) - 1);
            }
            uint colLo = lane * 2u;
            uint colHi = colLo + 1u;
            float wLo = w0;
            float wHi = w1;

            uint sBase = mLocal * CHUNK;
            sharedW[sBase + colLo] = wLo;
            sharedW[sBase + colHi] = wHi;
        }

        barrier();

        // ── 3. Partial dot product for this K-chunk. ──
        {
            uint bOff = gl_LocalInvocationID.y * CHUNK;
            uint wOff = gl_LocalInvocationID.x * CHUNK;
            float chunkSum = 0.0;
            for (uint j = 0u; j < CHUNK; j++) {
                chunkSum += sharedB[bOff + j] * sharedW[wOff + j];
            }
            acc += chunkSum;
        }

        barrier();
    }

    if (m < pc.M && t < pc.N) {
        c[t * pc.M + m] = acc;
    }
}
