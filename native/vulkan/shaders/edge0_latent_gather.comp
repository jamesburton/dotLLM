#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
// Edge0 latent MoE (G3, #1981): per-(token, expert) gather of the group latent row with the column scale applied.
//
//   out[v, c] = xl[t, g(e_v) * L + c] * inv[c],   v = t * k + j,  e_v = indices[v],  g(e) = labels[e],  t = v / k
//
// xl = D x for all G groups of a token ([T, G*L], the D matmul output, stored as F16: the F32 accumulator is rounded once at the store); inv = 1 / s (the per-layer column scale, ones for a pack without one).
// Multiplying while gathering is bit-identical to scaling xl first (one multiply per element either way). The output rows feed the Q8_1 quantizer
// and the indexed / grouped Q3_K expert kernels with K = L.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufXl     { float16_t xl[]; };   // F16 storage (James's rule-1 ruling, #1981)
layout(set = 0, binding = 1, std430) readonly  buffer BufIdx    { int   indices[]; };
layout(set = 0, binding = 2, std430) readonly  buffer BufLabels { int   labels[]; };
layout(set = 0, binding = 3, std430) readonly  buffer BufInv    { float inv[]; };
layout(set = 0, binding = 4, std430) writeonly buffer BufOut    { float outv[]; };

layout(push_constant) uniform PushConstants {
    uint L;
    uint G;
    uint K;           // experts per token
    uint rows;        // T * K
    uint numExperts;
} pc;

void main() {
    uint c = gl_GlobalInvocationID.x;
    uint v = gl_WorkGroupID.y;
    if (c >= pc.L || v >= pc.rows) return;
    uint e = uint(indices[v]);
    if (e >= pc.numExperts) { outv[v * pc.L + c] = 0.0; return; }
    uint g = uint(labels[e]);
    uint t = v / pc.K;
    outv[v * pc.L + c] = float(xl[(t * pc.G + g) * pc.L + c]) * inv[c];
}
