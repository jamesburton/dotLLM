#version 450
// BERT post-LN block on F16 activations: out[r, :] = LayerNorm(x[r, :] + bias[:] + res[r, :]) * w + b, one workgroup per row (issue #1474).
//
// Twin of bert_layernorm_f32.comp with the activation tensors (x, res, out) stored F16; bias / w / b stay F32 (tiny vectors). Every sum,
// mean and variance is F32 in registers / LDS, and v = (x + bias) + res is formed in F32 in that order, so the only new rounding point
// versus the F32 kernel is the stored F16 result (docs/PRECISION.md: F16 storage, F32 in-register accumulation).
// flags bit0 = add bias, bit1 = add residual (unused bindings must still be bound to any valid buffer).
// Dispatch: local_size_x = 256, groupCount.x = rows. Any width up to 16 * 256 = 4096 (strided loop).

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufX    { float16_t x[]; };     // [rows, n] GEMM output (F16)
layout(set = 0, binding = 1, std430) readonly  buffer BufBias { float bias[]; };      // [n]
layout(set = 0, binding = 2, std430) readonly  buffer BufRes  { float16_t res[]; };   // [rows, n] (F16)
layout(set = 0, binding = 3, std430) readonly  buffer BufW    { float w[]; };         // [n]
layout(set = 0, binding = 4, std430) readonly  buffer BufB    { float lb[]; };        // [n]
layout(set = 0, binding = 5, std430) writeonly buffer BufOut  { float16_t outp[]; };  // [rows, n] (F16)

layout(push_constant) uniform PushConstants {
    uint  n;
    uint  flags;
    float eps;
} pc;

shared float red[256];

float blockSum(float v, uint tid) {
    red[tid] = v;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (tid < s) red[tid] += red[tid + s];
        barrier();
    }
    float r = red[0];
    barrier();
    return r;
}

float load(uint base, uint i) {
    float v = float(x[base + i]);
    if ((pc.flags & 1u) != 0u) v += bias[i];
    if ((pc.flags & 2u) != 0u) v += float(res[base + i]);
    return v;
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint base = gl_WorkGroupID.x * pc.n;

    float s = 0.0;
    for (uint i = tid; i < pc.n; i += 256u) s += load(base, i);
    float mean = blockSum(s, tid) / float(pc.n);

    float q = 0.0;
    for (uint i = tid; i < pc.n; i += 256u) {
        float d = load(base, i) - mean;
        q += d * d;
    }
    float inv = 1.0 / sqrt(blockSum(q, tid) / float(pc.n) + pc.eps);

    for (uint i = tid; i < pc.n; i += 256u)
        outp[base + i] = float16_t((load(base, i) - mean) * inv * w[i] + lb[i]);
}
