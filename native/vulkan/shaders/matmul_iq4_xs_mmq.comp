#version 450
#extension GL_EXT_integer_dot_product : require
// IQ4_XS MMQ prefill GEMM: integer-dot (dp4a) batched matrix multiply.
//
//   C[N, M] = B[N, K] @ W_iq4xs[M, K]^T
//
// The activation B[N,K] is pre-quantized to Q8_1 row-wise. IQ4_XS uses the 16-entry
// signed-int8 codebook (kvalues_iq4nl) + a per-32-element sub-block signed 6-bit scale
// dl = d·(ls−32). Symmetric — no min term. Per 32-element sub-block j:
//   sum_i w_i·x_i = dl[j] · d_x · dp4a(KV[q_i], xq)
//
// The seqLen>1 analogue of matmul_iq4_xs_mmvq.comp (decode); structurally the
// codebook sibling of matmul_q4_k_mmq.comp without the min term. NOT bit-exact vs the
// F32-in GEMM (B is int8-quantized first); validated against the CPU F32 oracle.
//
// Tiling: 16 token rows × 16 weight cols of C, one thread per cell. Per K-super-block
// the 16-row weight tile is codebook-decoded into shared int8 once (reused across 16
// tokens).
//
// IQ4_XS super-block layout (136 bytes / 256; matches matmul_iq4_xs_mmvq.comp):
//   [0,1]=fp16 d  [2,3]=scales_h (u16: top 2 bits of 8 sub-block scales)
//   [4..7]=scales_l[4] (low 4 bits)  [8..135]=qs[128] (low nibble → elem j, high → j+16).

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufW   { uint  weight[]; }; // IQ4_XS blob
layout(set = 0, binding = 1, std430) readonly  buffer BufXq  { uint  xq[]; };      // [N*K/4]
layout(set = 0, binding = 2, std430) readonly  buffer BufXds { vec2  xds[]; };     // [N*K/32]
layout(set = 0, binding = 3, std430) writeonly buffer BufC   { float c[]; };       // [N*M]

layout(push_constant) uniform PushConstants {
    uint M;
    uint K;            // multiple of 256
    uint N;
    uint blocksPerRow; // = K / 256
    uint rowUints;     // unused
} pc;

const uint TILE_M = 16u;
const uint TILE_N = 16u;
const uint SB_BYTES     = 136u;  // IQ4_XS super-block bytes
const uint SUBS         = 8u;    // 32-element sub-blocks per super-block
const uint UINTS_PER_SB = 64u;   // 256 int8 / 4

const int KV[16] = int[16](
    -127, -104, -83, -65, -49, -35, -22, -10,
       1,   13,  25,  38,  53,  69,  89, 113
);

shared uint  sharedWq[TILE_M * UINTS_PER_SB]; // codebook-decoded int8 weights, element order
shared uint  sharedXq[TILE_N * UINTS_PER_SB]; // Q8_1 activations
shared float sharedWdl[TILE_M * SUBS];        // dl = d·(ls−32) per (row, sub-block)
shared float sharedXd[TILE_N * SUBS];         // d_x per (token, sub-block)

uint readByte(uint absByteOff) {
    uint u = weight[absByteOff >> 2u];
    return (u >> ((absByteOff & 3u) * 8u)) & 0xFFu;
}

float readHalf(uint absByteOff) {
    uint alignedIdx = absByteOff >> 2u;
    uint byteInWord = absByteOff & 3u;
    uint u = weight[alignedIdx];
    uint half16;
    if (byteInWord <= 2u) {
        half16 = (u >> (byteInWord * 8u)) & 0xFFFFu;
    } else {
        uint uNext = weight[alignedIdx + 1u];
        half16 = ((u >> 24) & 0xFFu) | ((uNext & 0xFFu) << 8);
    }
    return unpackHalf2x16(half16).x;
}

// 4 codebook int8 values from nibbles at shifts s0..s3 of `cur`, packed for dp4a.
uint packCB(uint cur, uint s0, uint s1, uint s2, uint s3) {
    return (uint(KV[(cur >> s0) & 0xFu]) & 0xFFu)
         | ((uint(KV[(cur >> s1) & 0xFu]) & 0xFFu) << 8u)
         | ((uint(KV[(cur >> s2) & 0xFu]) & 0xFFu) << 16u)
         | ((uint(KV[(cur >> s3) & 0xFu]) & 0xFFu) << 24u);
}

void main() {
    uint m = gl_WorkGroupID.x * TILE_M + gl_LocalInvocationID.x;
    uint t = gl_WorkGroupID.y * TILE_N + gl_LocalInvocationID.y;
    uint tid = gl_LocalInvocationID.y * TILE_M + gl_LocalInvocationID.x;

    uint mBase = gl_WorkGroupID.x * TILE_M;
    uint tBase = gl_WorkGroupID.y * TILE_N;

    uint rowByteStride = pc.blocksPerRow * SB_BYTES;
    float acc = 0.0;

    for (uint kSB = 0u; kSB < pc.blocksPerRow; kSB++) {
        // ---- 1. Stage weights: 16 rows × 32 qs-uints → codebook int8, element order. ----
        for (uint s = 0u; s < 2u; s++) {
            uint idx = tid + s * 256u;       // 0..511
            uint rLocal = idx >> 5u;         // 0..15 weight row
            uint lane   = idx & 31u;         // 0..31 qs uint within super-block
            uint ib = lane >> 2u;            // sub-block 0..7
            uint w  = lane & 3u;             // qs word 0..3
            uint mGlobal = mBase + rLocal;
            uint cur = 0u;
            if (mGlobal < pc.M) {
                uint blockByteBase = mGlobal * rowByteStride + kSB * SB_BYTES;
                cur = weight[((blockByteBase + 8u) >> 2u) + lane]; // qs word-aligned at +8
            }
            uint wLo = packCB(cur, 0u, 8u, 16u, 24u);  // elems 4w..4w+3 of sub-block
            uint wHi = packCB(cur, 4u, 12u, 20u, 28u); // elems 16+4w..
            sharedWq[rLocal * UINTS_PER_SB + ib * 8u + w]        = wLo;
            sharedWq[rLocal * UINTS_PER_SB + ib * 8u + 4u + w]   = wHi;
        }

        // ---- 2. Stage weight scales: 16 rows × 8 sub-blocks dl = d·(ls−32). ----
        if (tid < TILE_M * SUBS) {
            uint rLocal = tid >> 3u;
            uint ib     = tid & 7u;
            uint mGlobal = mBase + rLocal;
            float dl = 0.0;
            if (mGlobal < pc.M) {
                uint blockByteBase = mGlobal * rowByteStride + kSB * SB_BYTES;
                float d = readHalf(blockByteBase);
                uint scalesH = readByte(blockByteBase + 2u) | (readByte(blockByteBase + 3u) << 8u);
                uint scalesLByte = readByte(blockByteBase + 4u + (ib >> 1u));
                uint low  = (scalesLByte >> (4u * (ib & 1u))) & 0xFu;
                uint high = (scalesH >> (2u * ib)) & 0x3u;
                dl = d * float(int(low | (high << 4u)) - 32);
            }
            sharedWdl[rLocal * SUBS + ib] = dl;
        }

        // ---- 3. Stage activations: 16 token rows × 64 int8-uints. ----
        for (uint s = 0u; s < 4u; s++) {
            uint idx = tid + s * 256u;
            uint rLocal = idx >> 6u;
            uint u      = idx & 63u;
            uint tGlobal = tBase + rLocal;
            uint v = 0u;
            if (tGlobal < pc.N) {
                uint xqRowBase = tGlobal * (pc.K >> 2u);
                v = xq[xqRowBase + kSB * UINTS_PER_SB + u];
            }
            sharedXq[rLocal * UINTS_PER_SB + u] = v;
        }

        // ---- 4. Stage activation scales: 16 rows × 8 d_x. ----
        if (tid < TILE_N * SUBS) {
            uint rLocal = tid >> 3u;
            uint ib     = tid & 7u;
            uint tGlobal = tBase + rLocal;
            float dx = 0.0;
            if (tGlobal < pc.N) {
                dx = xds[tGlobal * (pc.K >> 5u) + kSB * SUBS + ib].x;
            }
            sharedXd[rLocal * SUBS + ib] = dx;
        }

        barrier();

        // ---- 5. dp4a over this super-block for output cell (t, m). ----
        {
            uint wRow = gl_LocalInvocationID.x;
            uint tRow = gl_LocalInvocationID.y;
            for (uint ib = 0u; ib < SUBS; ib++) {
                uint wbase = wRow * UINTS_PER_SB + ib * 8u;
                uint xbase = tRow * UINTS_PER_SB + ib * 8u;
                int dotI = 0;
                for (uint g = 0u; g < 8u; g++) {
                    dotI = dotPacked4x8AccSatEXT(
                        int(sharedWq[wbase + g]), int(sharedXq[xbase + g]), dotI);
                }
                float dl = sharedWdl[wRow * SUBS + ib];
                float dx = sharedXd[tRow * SUBS + ib];
                acc += dl * (dx * float(dotI));
            }
        }

        barrier();
    }

    if (m < pc.M && t < pc.N) {
        c[t * pc.M + m] = acc;
    }
}
