#version 450
// Expert-grouped MoE Q8_0 x Q8_1 GEMM on int8 cooperative matrices, 16-row token tile (issue #2041); see mmq_cm1_main.glsl (MMQ_GROUPED).
// Same arithmetic as moe_grouped_q8_0_mmq_cm1 (each output row is an independent int32 dot per 32-block, so the result is bit-identical);
// only the row tile shrinks, for batches that put few rows on each expert (nemotron_h_moe at 512 tokens: 24 rows/expert on Nano geometry,
// where a 64-row tile is mostly padding).
#extension GL_GOOGLE_include_directive : require
#define MMQ_Q8_0 1
#define MMQ_GROUPED 1
#define MMQ_BM 64u
#define MMQ_BN 16u
#define MMQ_WM 32u
#define MMQ_WN 16u
#define MMQ_THREADS 128
#include "mmq_cm1_main.glsl"
