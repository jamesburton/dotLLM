#version 450
#extension GL_EXT_control_flow_attributes : require

// Q4_K multi-column GEMV (1..8 activation rows, #902; NR output rows per workgroup, #1220): Y[col, m] = sum_k W[m, k] * X[col, k].
//
// #1220: NR (constant_id 1) output rows share each workgroup's activation loads. With one row per workgroup every row re-read all NC
// activation rows (4 B of FP32 x per 0.56 B of Q4_K weight), which made the kernel cache-bandwidth bound well below DRAM speed on Strix.
// A row's arithmetic is unchanged (same lane -> (block, sub-block, q) map, same order), so every NR / NC gives the same bits per column
// as the 1-row coalesced decode GEMV; NC = 1 is the decode GEMV itself.
//
// matmul_q4_k_gemv_f32_coalesced.comp for NC columns at once: every lane decodes its weights ONCE and FMAs them against all NC FP32 activation
// rows, so a 2..8-token verify batch costs about one GEMV instead of the 128x128 coopmat / tiled GEMM it replaces. NC is a
// specialization constant; X is [NC, K], Y is [NC, M]. Per-column accumulation order equals the single-column kernel's.

// Q4_K decode GEMV with an FP32 activation, COALESCED lane=K-position layout (issue #574).
//
//   y[m] = sum_k W_q4k[m,k] * x[k]
//
// Same contract and bindings as matmul_q4_k_gemv_f32.comp, with the memory layout of
// matmul_q8_0_coalesced.comp (#471): consecutive lanes read consecutive words instead of one lane
// walking a whole 144-byte super-block.
//
// Super-block (144 bytes = 36 uint, every field word-aligned): word 0 = fp16 d | fp16 dmin << 16,
// words 1..3 = scales[12] (8 x 6-bit scale + 8 x 6-bit min), words 4..35 = qs[128].
// Sub-block sb (0..7) of 32 elements: codes are nibble (sb & 1) of qs[(sb >> 1) * 32 + j], j = 0..31,
// value = d*scale[sb]*code - dmin*min[sb].
// Lane l (0..31) of a super-block owns sub-block sb = l / 4 and 8 consecutive j = 8q .. 8q+7
// (q = l % 4), i.e. two words of qs and two vec4 of activations. A 64-lane workgroup covers two
// super-blocks per window step.
//
// Dispatch: one workgroup of 64 threads per NR output rows; a fixed shared-memory tree reduction.

#define WG_SIZE 64u
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const uint NC = 2u;
layout(constant_id = 1) const uint NR = 1u;

layout(set = 0, binding = 0, std430) readonly  buffer BufW { uint weight[]; };  // Q4_K blob
layout(set = 0, binding = 1, std430) readonly  buffer BufX { vec4 x4[]; };      // [NC, K/4]
layout(set = 0, binding = 2, std430) writeonly buffer BufY { float y[]; };      // [NC, M]

layout(push_constant) uniform PushConstants {
    uint M;
    uint K;
    uint blocksPerRow;   // = K / 256 (super-blocks)
    uint rowUints;       // unused; kept for parity with matmul_q4_k_gemv_f32
} pc;

const uint UINTS_PER_BLOCK = 36u;
const uint WINDOW_BLOCKS   = WG_SIZE / 32u;

// Byte i (0..11) of the 12-byte scales region held in words s0..s2.
uint scaleByte(uint s0, uint s1, uint s2, uint i) {
    uint w = (i < 4u) ? s0 : ((i < 8u) ? s1 : s2);
    return (w >> ((i & 3u) * 8u)) & 0xFFu;
}

// (scale, min) pair j (0..7); mirrors llama.cpp get_scale_min_k4.
uvec2 scaleMin(uint s0, uint s1, uint s2, uint j) {
    if (j < 4u)
        return uvec2(scaleByte(s0, s1, s2, j) & 63u, scaleByte(s0, s1, s2, j + 4u) & 63u);
    uint hiByte = scaleByte(s0, s1, s2, j + 4u);
    uint sc = (hiByte & 0xFu)        | (((scaleByte(s0, s1, s2, j - 4u) >> 6u) & 0x3u) << 4u);
    uint mn = ((hiByte >> 4u) & 0xFu) | (((scaleByte(s0, s1, s2, j)      >> 6u) & 0x3u) << 4u);
    return uvec2(sc, mn);
}

vec4 nibbles(uint u, uint shift) {
    return vec4(float((u >> shift) & 0xFu), float((u >> (shift + 8u)) & 0xFu),
                float((u >> (shift + 16u)) & 0xFu), float((u >> (shift + 24u)) & 0xFu));
}

shared float partials[NR * NC][WG_SIZE];

void main() {
    uint m0 = gl_WorkGroupID.x * NR;
    if (m0 >= pc.M) return;

    uint lane = gl_LocalInvocationID.x;
    uint blockInWindow = lane >> 5u;
    uint l32 = lane & 31u;
    uint sb  = l32 >> 2u;
    uint q   = l32 & 3u;
    uint shift = (sb & 1u) * 4u;

    // Rows past M (last workgroup) duplicate row M-1 and are not stored.
    uint rowBase[NR];
    [[unroll]] for (uint r = 0u; r < NR; ++r) rowBase[r] = min(m0 + r, pc.M - 1u) * pc.blocksPerRow * UINTS_PER_BLOCK;

    uint xRow4 = pc.K >> 2u;   // vec4 per activation row
    precise float acc[NR * NC];
    [[unroll]] for (uint i = 0u; i < NR * NC; ++i) acc[i] = 0.0;
    for (uint w0 = 0u; w0 < pc.blocksPerRow; w0 += WINDOW_BLOCKS) {
        uint blk = w0 + blockInWindow;
        if (blk >= pc.blocksPerRow)
            continue;

        vec4 wA[NR];
        vec4 wB[NR];
        [[unroll]] for (uint r = 0u; r < NR; ++r) {
            uint b = rowBase[r] + blk * UINTS_PER_BLOCK;
            vec2 dd = unpackHalf2x16(weight[b]);
            uvec2 sm = scaleMin(weight[b + 1u], weight[b + 2u], weight[b + 3u], sb);
            float sc = dd.x * float(sm.x);
            float mn = dd.y * float(sm.y);
            uint qw = b + 4u + (sb >> 1u) * 8u + 2u * q;
            // Dequantise once per row (w = sc * code - mn), shared by every column: 8 FMAs per column instead of dot + sum(x) + 2 FMAs (#1220).
            wA[r] = fma(vec4(sc), nibbles(weight[qw],      shift), vec4(-mn));
            wB[r] = fma(vec4(sc), nibbles(weight[qw + 1u], shift), vec4(-mn));
        }

        // Explicit fma chain under `precise`: the driver may not contract or reorder, so a row's bits do not depend on NR / NC (the unroll
        // width changed Intel's contraction choices at NR = 4 without it).
        uint xi = blk * 64u + sb * 8u + 2u * q;
        [[unroll]] for (uint cc = 0u; cc < NC; ++cc) {
            vec4 xa = x4[cc * xRow4 + xi];
            vec4 xb = x4[cc * xRow4 + xi + 1u];
            [[unroll]] for (uint r = 0u; r < NR; ++r) {
                precise float a = acc[r * NC + cc];
                a = fma(wA[r].x, xa.x, a); a = fma(wA[r].y, xa.y, a); a = fma(wA[r].z, xa.z, a); a = fma(wA[r].w, xa.w, a);
                a = fma(wB[r].x, xb.x, a); a = fma(wB[r].y, xb.y, a); a = fma(wB[r].z, xb.z, a); a = fma(wB[r].w, xb.w, a);
                acc[r * NC + cc] = a;
            }
        }
    }

    // Fixed shared-memory tree over the 64 lanes, NOT subgroupAdd: a driver may compile each NR / NC pipeline at a different subgroup width
    // (Intel picks SIMD8/16/32 by register pressure), which changes a subgroup reduction's order and so the bits.
    [[unroll]] for (uint i = 0u; i < NR * NC; ++i) partials[i][lane] = acc[i];
    barrier();
    [[unroll]] for (uint stride = WG_SIZE / 2u; stride > 0u; stride >>= 1u) {
        if (lane < stride)
            [[unroll]] for (uint i = 0u; i < NR * NC; ++i) partials[i][lane] = partials[i][lane] + partials[i][lane + stride];
        barrier();
    }
    if (lane < NR * NC) {
        uint r = lane / NC, cc = lane - r * NC;
        if (m0 + r < pc.M)
            y[cc * pc.M + m0 + r] = partials[lane][0];
    }
}
