#version 450
#extension GL_EXT_integer_dot_product        : require
#extension GL_KHR_shader_subgroup_basic      : require
#extension GL_KHR_shader_subgroup_arithmetic : require
// Q4_K MMVQ decode GEMV: integer-dot (dp4a) matrix-vector multiply.
//
//   y[m] = sum_k W_q4k[m,k] * x[k]
//
// The activation x[] is pre-quantized to Q8_1 (int8 qs + fp32 scale d_x + fp32
// block-sum s, one block per 32 elements) by quantize_q8_1.comp. Q4_K stores a
// 4-bit nibble q (0..15) per weight with per-sub-block (scale, min) and a
// super-block (d, dmin):  w_i = d·scale·q_i - dmin·min.  So per 32-element
// sub-block (aligned 1:1 with a Q8_1 block):
//   sum_i w_i·x_i = d·scale·sum_i(q_i·x_i) - dmin·min·sum_i(x_i)
//                 = d·scale·d_x·dp4a(q_nibbles, xq) - dmin·min·s
// The integer dp4a (dotPacked4x8AccSatEXT, OpSDotAccSat) replaces the per-element
// float dequant+madd of the F32-in Q4_K GEMV — Q4_K decode is the largest gap vs
// llama.cpp, and the dequant float work was a big part of it.
//
// NOT bit-exact (x is int8-quantized); validated argmax + tolerance vs CPU F32.
//
// ── COALESCED lane=K-position layout (issue #338) ─────────────────────────────
// The previous layout mapped lane -> WHOLE super-block (thread `tid` owned 256
// elements), so at one load instruction the warp lanes read words 144 bytes
// apart => uncoalesced (~34% of peak BW; the #1 decode gap). This shader mirrors
// llama.cpp `mul_mat_vec`: one wave32 subgroup computes ONE output row, and the
// 32 lanes COOPERATIVELY consume one super-block per iteration. The super-block's
// qs is exactly 128 bytes = 32 uints, so lane L reads qs uint L => consecutive
// lanes read consecutive words = a fully coalesced 128-byte region.
//
//   lane L: pairIdx p = L/8, group g = L%8.  Lane reads qs uint (p*8 + g), whose
//   4 bytes hold 4 low-nibble weights of sub-block j0=2p AND 4 high-nibble
//   weights of sub-block j1=2p+1 (elements [g*4 .. g*4+4)). It dp4a's each
//   against the matching 4 activations and adds the FULLY-SCALED contribution.
//   The per-sub-block min term (-dmin·min·s) is independent of the weights and
//   must be counted once per sub-block, so each of a sub-block's 8 lanes adds
//   1/8 of it; the final subgroupAdd then yields exactly one min term per
//   sub-block. d/dmin (4 B) and scales[12] are read uniformly (cached) by all
//   lanes. Reduction: a single subgroupAdd (no shared memory, no barriers).
//
// Q4_K super-block layout (144 bytes / 256 elements; mirrors matmul_q4_k_gemv_f32.comp):
//   [0,1]=fp16 d   [2,3]=fp16 dmin   [4..15]=scales[12] (8×6-bit sc + 8×6-bit mn)
//   [16..143]=qs[128] (two 4-bit values per byte; low nibble → even sub-block,
//                      high nibble → odd sub-block of the pair). 144 % 4 == 0 ⇒
//                      no straddle; qs is word-aligned.

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufW   { uint  weight[]; }; // Q4_K blob
layout(set = 0, binding = 1, std430) readonly  buffer BufXq  { uint  xq[]; };      // [K/4] packed int8 activations
layout(set = 0, binding = 2, std430) readonly  buffer BufXds { vec2  xds[]; };     // [K/32] (d_x, s)
layout(set = 0, binding = 3, std430) writeonly buffer BufY   { float y[]; };       // [M]

layout(push_constant) uniform PushConstants {
    uint M;            // output rows
    uint K;            // columns (multiple of 256)
    uint blocksPerRow; // = K / 256 (super-blocks)
    uint pad;
} pc;

const uint Q4K_BLOCK_BYTES = 144u;

uint readByte(uint absByteOff) {
    uint u = weight[absByteOff >> 2u];
    return (u >> ((absByteOff & 3u) * 8u)) & 0xFFu;
}

float readHalf(uint absByteOff) {
    uint alignedIdx = absByteOff >> 2u;
    uint byteInWord = absByteOff & 3u;
    uint u = weight[alignedIdx];
    uint half16;
    if (byteInWord <= 2u) {
        half16 = (u >> (byteInWord * 8u)) & 0xFFFFu;
    } else {
        uint uNext = weight[alignedIdx + 1u];
        half16 = ((u >> 24) & 0xFFu) | ((uNext & 0xFFu) << 8);
    }
    return unpackHalf2x16(half16).x;
}

// j-th (0..7) (scale, min) pair from the 12-byte scales[] — get_scale_min_k4.
uvec2 unpackScaleMin(uint scalesByteBase, uint j) {
    uint sc, mn;
    if (j < 4u) {
        sc = readByte(scalesByteBase + j) & 63u;
        mn = readByte(scalesByteBase + j + 4u) & 63u;
    } else {
        uint scLow  = readByte(scalesByteBase + j + 4u) & 0xFu;
        uint scHigh = (readByte(scalesByteBase + j - 4u) >> 6u) & 0x3u;
        sc = scLow | (scHigh << 4u);
        uint mnLow  = (readByte(scalesByteBase + j + 4u) >> 4u) & 0xFu;
        uint mnHigh = (readByte(scalesByteBase + j) >> 6u) & 0x3u;
        mn = mnLow | (mnHigh << 4u);
    }
    return uvec2(sc, mn);
}

void main() {
    uint m = gl_WorkGroupID.x;
    if (m >= pc.M) return;

    uint lane = gl_LocalInvocationID.x;   // 0..31 (one subgroup per workgroup)
    uint p = lane >> 3u;                  // pairIdx 0..3
    uint g = lane & 7u;                   // group 0..7 (which 4-element quartet)
    uint j0 = p * 2u;                     // low-nibble sub-block
    uint j1 = j0 + 1u;                    // high-nibble sub-block

    uint rowByteBase = m * pc.blocksPerRow * Q4K_BLOCK_BYTES;
    float acc = 0.0;

    for (uint b = 0u; b < pc.blocksPerRow; b++) {
        uint blockByteBase = rowByteBase + b * Q4K_BLOCK_BYTES;
        float d    = readHalf(blockByteBase);
        float dmin = readHalf(blockByteBase + 2u);
        uint scalesBase = blockByteBase + 4u;
        uvec2 sm0 = unpackScaleMin(scalesBase, j0);
        uvec2 sm1 = unpackScaleMin(scalesBase, j1);

        // This lane's qs uint: qs starts at +16 bytes (word-aligned). Lane L owns
        // uint (p*8 + g) = lane, so the 32 lanes read 32 consecutive uints.
        uint cur = weight[((blockByteBase + 16u) >> 2u) + lane];
        uint lo = ( cur        & 0x0Fu)
                | ((cur >>  8u) & 0x0Fu) << 8u
                | ((cur >> 16u) & 0x0Fu) << 16u
                | ((cur >> 24u) & 0x0Fu) << 24u;
        uint hi = ((cur >>  4u) & 0x0Fu)
                | ((cur >> 12u) & 0x0Fu) << 8u
                | ((cur >> 20u) & 0x0Fu) << 16u
                | ((cur >> 28u) & 0x0Fu) << 24u;

        uint xqBlockBase = b * 64u;       // (b*256)/4 = first activation uint of this super-block
        uint xdsBase     = b * 8u;        // first Q8_1 block of this super-block
        vec2 ds0 = xds[xdsBase + j0];     // (d_x, s) for sub-block j0
        vec2 ds1 = xds[xdsBase + j1];

        int dot0 = dotPacked4x8AccSatEXT(int(lo), int(xq[xqBlockBase + j0 * 8u + g]), 0);
        int dot1 = dotPacked4x8AccSatEXT(int(hi), int(xq[xqBlockBase + j1 * 8u + g]), 0);

        // d·sc·(d_x·dot)  minus  1/8 of the per-sub-block min term (8 lanes share it).
        acc += (d * float(sm0.x)) * (ds0.x * float(dot0)) - (dmin * float(sm0.y)) * ds0.y * 0.125;
        acc += (d * float(sm1.x)) * (ds1.x * float(dot1)) - (dmin * float(sm1.y)) * ds1.y * 0.125;
    }

    // The subgroup IS the row: one reduction yields y[m] (no shared mem, no barrier).
    float total = subgroupAdd(acc);
    if (subgroupElect())
        y[m] = total;
}
