#version 450
// Weighted combine of the expert outputs of a nomic-bert-moe layer (issue #1471):
//   out[t, c] = f16( sum_k f32(y[invPerm[t * topK + k], c]) * weights[t * topK + k] )
// Gather form (no atomics): fixed k order, one F16 rounding. The optional learned experts.bias is added by the following
// bias + residual + LayerNorm, in the CPU encoder's order (after the weighted sum).
// Dispatch: groupCount.x = ceil(tokens * hidden / 256).

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufY   { float16_t y[]; };     // [rows, hidden] packed expert outputs
layout(set = 0, binding = 1, std430) readonly  buffer BufInv { uint invPerm[]; };    // [tokens * topK]
layout(set = 0, binding = 2, std430) readonly  buffer BufW   { float weights[]; };   // [tokens * topK]
layout(set = 0, binding = 3, std430) writeonly buffer BufOut { float16_t outv[]; };  // [tokens, hidden]

layout(push_constant) uniform PushConstants {
    uint total;    // tokens * hidden
    uint hidden;
    uint topK;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.total) return;
    uint t = i / pc.hidden;
    uint c = i - t * pc.hidden;
    float acc = 0.0;
    for (uint k = 0u; k < pc.topK; k++) {
        uint r = t * pc.topK + k;
        acc += float(y[invPerm[r] * pc.hidden + c]) * weights[r];
    }
    outv[i] = float16_t(acc);
}
