#version 450
#extension GL_EXT_integer_dot_product        : require
#extension GL_KHR_shader_subgroup_basic      : require
#extension GL_KHR_shader_subgroup_arithmetic : require
// MoE INDEXED Q6_K MMVQ decode GEMV: integer-dot (dp4a) matrix-vector multiply over a packed expert bank.
//
//   y[n, m] = sum_k dequant(bank[indices[n], m, k]) * x[n, k]
//
// The gathered/indexed variant of matmul_q6_k_mmvq.comp, generated from it by gen_idx_mmvq.py (same recipe as the existing
// moe_indexed_matmul_q4_k_mmvq.comp): the weight row is looked up through the per-row expert index and the activation row n comes
// from the Q8_1-quantized expanded MoE input (quantize_q8_1_rows.comp). The lane layout, per-sub-block math and subgroupAdd are
// unchanged. The scalar one-thread-per-cell moe_indexed_matmul_*_q8_1/_f32 kernels read adjacent rows a whole row apart
// (uncoalesced) and were ~1.5 ms/layer for Q6_K on Qwen3.6-35B-A3B decode.
//
// Dispatch: gl_WorkGroupID.x = m, gl_WorkGroupID.y = n; one wave32 subgroup per output cell.

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufBank { uint  bank[]; }; // Q6_K blob
layout(set = 0, binding = 1, std430) readonly  buffer BufXq  { uint  xq[]; };      // [N * K/4] packed int8 activations
layout(set = 0, binding = 2, std430) readonly  buffer BufXds { vec2  xds[]; };     // [N * K/32] (d_x, s)
layout(set = 0, binding = 3, std430) readonly  buffer BufIdx  { int   indices[]; };// [N]
layout(set = 0, binding = 4, std430) writeonly buffer BufY    { float y[]; };      // [N * M]

layout(push_constant) uniform PushConstants {
    uint M;             // output dim   (per-expert weight row count)
    uint K;             // input dim    (multiple of 256)
    uint N;             // total rows   (typically seqLen * topK)
    uint numExperts;    // bank's first axis size - bounds-check only
    uint blocksPerRow;  // = K / 256
} pc;

const uint Q6K_BLOCK_BYTES = 210u;

int readSByte(uint absByteOff) {
    uint u = bank[absByteOff >> 2u];
    uint b = (u >> ((absByteOff & 3u) * 8u)) & 0xFFu;
    return int(b) - int((b & 0x80u) << 1);   // sign-extend int8
}

// 4 consecutive bytes LE, funnelled across the word boundary (210-byte stride
// makes ql/qh bases 2-mod-4 on alternate blocks).
uint read4Bytes(uint absByteOff) {
    uint idx = absByteOff >> 2u;
    uint ph  = absByteOff & 3u;
    uint lo  = bank[idx];
    if (ph == 0u) return lo;
    uint hi = bank[idx + 1u];
    return (lo >> (ph * 8u)) | (hi << ((4u - ph) * 8u));
}

float readHalf(uint absByteOff) {
    uint alignedIdx = absByteOff >> 2u;
    uint byteInWord = absByteOff & 3u;
    uint u = bank[alignedIdx];
    uint half16;
    if (byteInWord <= 2u) {
        half16 = (u >> (byteInWord * 8u)) & 0xFFFFu;
    } else {
        uint uNext = bank[alignedIdx + 1u];
        half16 = ((u >> 24) & 0xFFu) | ((uNext & 0xFFu) << 8);
    }
    return unpackHalf2x16(half16).x;
}

// Assemble 4 signed (q6-32) bytes from one ql word + one qh word into a uint
// ready for dp4a. useHigh selects the high nibble of each ql byte; shift selects
// the 2-bit qh field (group*2).
uint packQ6Signed(uint ql4, uint qh4, bool useHigh, uint shift) {
    uint res = 0u;
    for (uint e = 0u; e < 4u; e++) {
        uint qlb = (ql4 >> (e * 8u)) & 0xFFu;
        uint qhb = (qh4 >> (e * 8u)) & 0xFFu;
        uint nib = useHigh ? ((qlb >> 4u) & 0xFu) : (qlb & 0xFu);
        uint high2 = (qhb >> shift) & 3u;
        int q6 = int(nib | (high2 << 4u)) - 32;     // -32..31
        res |= (uint(q6) & 0xFFu) << (e * 8u);
    }
    return res;
}

void main() {
    uint m = gl_WorkGroupID.x;
    uint n = gl_WorkGroupID.y;
    if (m >= pc.M || n >= pc.N) return;

    uint expert = uint(indices[n]);
    if (expert >= pc.numExperts) return; // defensive: bad index leaves y untouched
    uint xqRowBase  = n * (pc.K >> 2u);  // uint index of row n's packed activations
    uint xdsRowBase = n * (pc.K >> 5u);  // vec2 index of row n's (d_x, s)

    uint lane  = gl_LocalInvocationID.x;   // 0..31 (one subgroup per workgroup)
    uint c     = lane >> 2u;               // chunk 0..7
    uint q     = lane & 3u;                // quarter 0..3 (8 elements each)
    uint hf    = c >> 2u;                  // super-block half 0..1
    uint group = c & 3u;                   // group 0..3
    bool useHigh = (group >= 2u);          // groups 2,3 take the ql high nibble
    uint shift   = group * 2u;             // qh field shift 0,2,4,6
    uint isc     = q >> 1u;                // which of the chunk's two 16-elem scales
    uint scIdx   = hf * 8u + isc + 2u * group;       // 0..15
    uint qlChunkOff = hf * 64u + (group & 1u) * 32u; // within ql[128]
    uint qhChunkOff = hf * 32u;                       // within qh[64]

    uint rowByteBase = (expert * pc.M + m) * pc.blocksPerRow * Q6K_BLOCK_BYTES;
    float acc = 0.0;

    for (uint b = 0u; b < pc.blocksPerRow; b++) {
        uint blockByteBase = rowByteBase + b * Q6K_BLOCK_BYTES;
        float d  = readHalf(blockByteBase + 208u);
        float sc = float(readSByte(blockByteBase + 192u + scIdx));

        // This lane's 8 ql + 8 qh bytes (its quarter of the chunk).
        uint qlByteBase = blockByteBase + qlChunkOff + q * 8u;
        uint qhByteBase = blockByteBase + 128u + qhChunkOff + q * 8u;
        uint w0 = packQ6Signed(read4Bytes(qlByteBase),      read4Bytes(qhByteBase),      useHigh, shift);
        uint w1 = packQ6Signed(read4Bytes(qlByteBase + 4u), read4Bytes(qhByteBase + 4u), useHigh, shift);

        // Matching 8 activations: element index b*256 + c*32 + q*8 → xq uint b*64 + c*8 + q*2.
        uint xqi = xqRowBase + b * 64u + c * 8u + q * 2u;
        int dotI = dotPacked4x8AccSatEXT(int(w0), int(xq[xqi]), 0);
        dotI = dotPacked4x8AccSatEXT(int(w1), int(xq[xqi + 1u]), dotI);

        // Activation scale: the chunk is one Q8_1 block (b*8 + c).
        float dX = xds[xdsRowBase + b * 8u + c].x;
        acc += (d * sc) * (dX * float(dotI));
    }

    float total = subgroupAdd(acc);
    if (subgroupElect())
        y[n * pc.M + m] = total;
}
