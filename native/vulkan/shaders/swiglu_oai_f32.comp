#version 450
// gpt-oss clamped SwiGLU (llama.cpp ggml_swiglu_oai):
//   x = min(gate, limit); y = clamp(up, -limit, limit)
//   out = x * sigmoid(alpha * x) * (y + 1)
// Mirrors DotLLM.Cpu.Kernels.MoeQuantSwiGluMlp.SwiGluOai (alpha = 1.702, limit = 7).
// Pointwise, one thread per element.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufGate   { float gate[];   };
layout(set = 0, binding = 1, std430) readonly  buffer BufUp     { float up[];     };
layout(set = 0, binding = 2, std430) writeonly buffer BufResult { float result[]; };

layout(push_constant) uniform PushConstants {
    uint  n;
    float alpha;
    float limit;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;

    float x = min(gate[i], pc.limit);
    float y = clamp(up[i], -pc.limit, pc.limit);
    float glu = x / (1.0 + exp(-pc.alpha * x));
    result[i] = glu * (y + 1.0);
}
