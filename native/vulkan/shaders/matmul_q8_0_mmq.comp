#version 450
#extension GL_EXT_integer_dot_product : require
// Q8_0 MMQ prefill GEMM: integer-dot (dp4a) batched matrix multiply.
//
//   C[N, M] = B[N, K] @ W_q8[M, K]^T
//
// Both operands are int8 here. The activation B[N, K] has been pre-quantized
// to Q8_1 row-wise (quantize_q8_1_rows.comp) into a packed-int8 tile + per-32-
// block fp32 (scale, sum). The Q8_0 weights are int8 (fp16 scale + 32 int8).
// For each 32-block the raw integer dot product
//   acc = sum_i  w_qs[i] * x_qs[i]            (int8 * int8 -> int32)
// is accumulated with dotPacked4x8AccSatEXT (4 int8 MACs/instruction), then
// scaled by d_w * d_x. Q8_0 is symmetric (no min term) so the Q8_1 block-sum
// is unused; it is carried for the K-quant MMQ kernels that follow.
//
// This is the compute-bound prefill analogue of matmul_q8_0_mmvq.comp. It is
// NOT bit-exact vs the F32-in GEMM: B is int8-quantized first. Per-32-block
// scaling keeps the activation quant near-lossless (validated against the CPU
// F32 oracle with a tolerance + argmax-exact test).
//
// Weight byte layout (identical to matmul_q8_0_gemm.comp):
//   row stride = (K / 32) * 34 bytes; each 34-byte block = 2-byte fp16 scale
//   + 32 signed int8 qs. Read as uint[] with explicit byte shifts.
//
// Activation layout (from quantize_q8_1_rows.comp):
//   xq : uint[N * K/4]  — row r at r*(K/4); 4 int8 lanes/uint, naturally aligned.
//   xds: vec2[N * K/32] — row r at r*(K/32); (.x = d_x, .y = s_x) per 32-block.
//
// Tiling (issue #366 register-tiled rewrite, mirroring the #139 Q4_K/Q6_K/IQ4_XS
// tiling): 64 token rows x 64 weight rows of C per workgroup (16x16 threads,
// each computing a 4x4 register tile, strided by 16 so LDS reads are
// conflict-free with the +1-uint row padding). Per 32-block K-iteration each
// thread performs 2*8 = 16 LDS loads for 4*4*8 = 128 dp4a — 8 dp4a per LDS
// load, vs 0.5 for the pre-#366 one-output-per-thread tiling (matched the
// #139 measurements on Q4_K/Q6_K/IQ4_XS: ~1.5 -> ~13 TFLOP/s effective).
// The pre-#366 16x16 tile is the ONLY MMQ kernel #139 left untouched (its
// scope was iq4_xs/q4_k/q6_k) — profiling on issue #366 showed SmolLM-135M
// (Q8_0) still ~62% of prefill time in these still-untiled q8_0_mmq
// dispatches, so this is the direct extension of #139's coverage.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufW   { uint  weight[]; }; // Q8_0 blob
layout(set = 0, binding = 1, std430) readonly  buffer BufXq  { uint  xq[]; };      // [N*K/4]
layout(set = 0, binding = 2, std430) readonly  buffer BufXds { vec2  xds[]; };     // [N*K/32]
layout(set = 0, binding = 3, std430) writeonly buffer BufC   { float c[]; };       // [N*M]

layout(push_constant) uniform PushConstants {
    uint M;            // output dim (weight rows)
    uint K;            // contraction dim (multiple of 32)
    uint N;            // batch size (input rows)
    uint blocksPerRow; // = K / 32
    uint rowUints;     // per-row uint stride bound (rounded up; unused here)
} pc;

const uint TILE_M = 64u;         // weight rows per workgroup
const uint TILE_N = 64u;         // token rows per workgroup
const uint TM = 4u;              // weight rows per thread (strided by 16)
const uint TN = 4u;              // token rows per thread (strided by 16)
const uint BLOCK = 32u;          // Q8_0 group size
const uint BLOCK_BYTES = 34u;
const uint UINTS_PER_BLOCK = 8u; // 32 int8 / 4 per uint
const uint CHUNK_STRIDE = 9u;    // +1 uint pad -> LDS bank-conflict-free strided reads

// One K-block tile: 64 rows x 8 uints of packed int8 each (padded), for B and W.
shared uint  sharedXq[TILE_N * CHUNK_STRIDE];
shared uint  sharedWq[TILE_M * CHUNK_STRIDE];
shared float sharedDx[TILE_N];                   // per-token activation scale
shared float sharedDw[TILE_M];                   // per-row weight scale

// Read the fp16 scale at absolute byte offset (handles straddled uint words).
float readHalf(uint absByteOff) {
    uint alignedIdx = absByteOff >> 2u;
    uint byteInWord = absByteOff & 3u;
    uint u = weight[alignedIdx];
    uint half16;
    if (byteInWord <= 2u) {
        half16 = (u >> (byteInWord * 8u)) & 0xFFFFu;
    } else {
        uint uNext = weight[alignedIdx + 1u];
        half16 = ((u >> 24) & 0xFFu) | ((uNext & 0xFFu) << 8);
    }
    return unpackHalf2x16(half16).x;
}

void main() {
    uint tx = gl_LocalInvocationID.x;              // 0..15 -> weight-row axis
    uint ty = gl_LocalInvocationID.y;              // 0..15 -> token-row axis
    uint tid = ty * 16u + tx;                      // 0..255

    uint mBase = gl_WorkGroupID.x * TILE_M;
    uint tBase = gl_WorkGroupID.y * TILE_N;

    uint rowByteStride = pc.blocksPerRow * BLOCK_BYTES;

    float acc[TM][TN];
    for (uint i = 0u; i < TM; i++)
        for (uint j = 0u; j < TN; j++)
            acc[i][j] = 0.0;

    for (uint kBlock = 0u; kBlock < pc.blocksPerRow; kBlock++) {
        // ---- 1. Stage sharedXq[64][8] + sharedDx[64]. ----
        // 256 threads, 64*8=512 uints -> two passes of 256 threads each.
        for (uint s = 0u; s < 2u; s++) {
            uint idx = tid + s * 256u;      // 0..511
            uint rLocal = idx >> 3u;        // 0..63 token within tile
            uint lane   = idx & 7u;         // 0..7 uint within block
            uint tGlobal = tBase + rLocal;
            uint v = 0u;
            if (tGlobal < pc.N) {
                uint xqRowBase = tGlobal * (pc.K >> 2u);
                v = xq[xqRowBase + kBlock * UINTS_PER_BLOCK + lane];
            }
            sharedXq[rLocal * CHUNK_STRIDE + lane] = v;
        }
        // d_x scales: 64 values, first 64 threads.
        if (tid < TILE_N) {
            uint tGlobal = tBase + tid;
            float dx = 0.0;
            if (tGlobal < pc.N) {
                dx = xds[tGlobal * pc.blocksPerRow + kBlock].x;
            }
            sharedDx[tid] = dx;
        }

        // ---- 2. Stage sharedWq[64][8] + sharedDw[64]. ----
        // Funnel-read the 32 weight qs bytes of (weight row, kBlock) into 8
        // aligned uints, matching matmul_q8_0_mmvq.comp's phase funnel. The
        // 34-byte block stride makes the qs region (block+2) alternately 0- or
        // 2-aligned (mod 4) across blocks.
        for (uint s = 0u; s < 2u; s++) {
            uint idx = tid + s * 256u;      // 0..511
            uint rLocal = idx >> 3u;        // 0..63 weight row within tile
            uint lane   = idx & 7u;         // 0..7 uint within block
            uint mGlobal = mBase + rLocal;
            uint wWord = 0u;
            if (mGlobal < pc.M) {
                uint blockByteBase = mGlobal * rowByteStride + kBlock * BLOCK_BYTES;
                uint q = blockByteBase + 2u;
                uint ubase = q >> 2u;
                uint ph = q & 3u;       // 0 or 2
                if (ph == 0u) {
                    wWord = weight[ubase + lane];
                } else {
                    uint lo = weight[ubase + lane];
                    uint hi = weight[ubase + lane + 1u];
                    wWord = (lo >> 16u) | (hi << 16u);
                }
            }
            sharedWq[rLocal * CHUNK_STRIDE + lane] = wWord;
        }
        // d_w scales: 64 values, first 64 threads.
        if (tid < TILE_M) {
            uint mGlobal = mBase + tid;
            float dw = 0.0;
            if (mGlobal < pc.M) {
                uint blockByteBase = mGlobal * rowByteStride + kBlock * BLOCK_BYTES;
                dw = readHalf(blockByteBase);
            }
            sharedDw[tid] = dw;
        }

        barrier();

        // ---- 3. dp4a: 4x4 register tile per thread over this block. ----
        {
            int dotI[TM][TN];
            for (uint i = 0u; i < TM; i++)
                for (uint j = 0u; j < TN; j++)
                    dotI[i][j] = 0;
            for (uint g = 0u; g < UINTS_PER_BLOCK; g++) {
                uint wv[TM];
                uint xv[TN];
                for (uint i = 0u; i < TM; i++)
                    wv[i] = sharedWq[(tx + 16u * i) * CHUNK_STRIDE + g];
                for (uint j = 0u; j < TN; j++)
                    xv[j] = sharedXq[(ty + 16u * j) * CHUNK_STRIDE + g];
                for (uint i = 0u; i < TM; i++)
                    for (uint j = 0u; j < TN; j++)
                        dotI[i][j] = dotPacked4x8AccSatEXT(int(wv[i]), int(xv[j]), dotI[i][j]);
            }
            for (uint i = 0u; i < TM; i++) {
                float dw = sharedDw[tx + 16u * i];
                for (uint j = 0u; j < TN; j++) {
                    float dx = sharedDx[ty + 16u * j];
                    acc[i][j] += dw * dx * float(dotI[i][j]);
                }
            }
        }

        barrier();
    }

    // ---- 4. Store output tile if within [N, M] bounds. ----
    for (uint j = 0u; j < TN; j++) {
        uint t = tBase + ty + 16u * j;
        if (t >= pc.N) continue;
        for (uint i = 0u; i < TM; i++) {
            uint m = mBase + tx + 16u * i;
            if (m < pc.M) {
                c[t * pc.M + m] = acc[i][j];
            }
        }
    }
}
