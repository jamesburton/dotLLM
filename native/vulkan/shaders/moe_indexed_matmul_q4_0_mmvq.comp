#version 450
#extension GL_EXT_integer_dot_product        : require
#extension GL_KHR_shader_subgroup_basic      : require
#extension GL_KHR_shader_subgroup_arithmetic : require
// MoE INDEXED Q4_0 MMVQ decode GEMV (issue #1018): the dense matmul_q4_0_mmvq.comp lane layout over a packed Q4_0 expert bank.
//
//   y[n, m] = sum_k dequant_q4_0(bank[indices[n], m, k]) * x[n, k]
//
// x is pre-quantized to Q8_1 (one block per 32 elements = one Q4_0 block). w = d*(nibble-8) is an int8 times the fp16 scale:
// sum_i w_i*x_i = d * d_x * dp4a(nibble-8, xq); no min term.
// One wave32 subgroup per output cell (n, m); 4 lanes per 32-element block, 8 blocks per window; lane L = block bi = L/4, qs word w = L%4
// (4 low-nibble elements [4w..4w+3] + 4 high-nibble elements [16+4w..] -> 2 dp4a). Reduction: one subgroupAdd.
//
// Q4_0 block (18 bytes / 32 elements, NOT word aligned): [0,1] fp16 d | [2..17] qs[16]. K % 32 == 0.
// NOT bit-exact (x is int8-quantized). Dispatch: 2D grid - x = m, y = n.

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufBank { uint  bank[]; };      // Q4_0 blob [numExperts, M, K/32 x 18 B]
layout(set = 0, binding = 1, std430) readonly  buffer BufXq   { uint  xq[]; };        // [N * K/4]
layout(set = 0, binding = 2, std430) readonly  buffer BufXds  { vec2  xds[]; };       // [N * K/32]
layout(set = 0, binding = 3, std430) readonly  buffer BufIdx  { int   indices[]; };   // [N]
layout(set = 0, binding = 4, std430) writeonly buffer BufY    { float y[]; };         // [N * M]

layout(push_constant) uniform PushConstants {
    uint M;
    uint K;
    uint N;
    uint numExperts;
    uint blocksPerRow;  // K / 32
    uint xDiv;          // activation row = n / xDiv (1 = per-row input; topK = one row broadcast to its topK expert slots)
} pc;

const uint Q4_0_BLOCK_BYTES = 18u;
const uint WINDOW_BLOCKS = 8u;   // 32 lanes / 4 lanes-per-block

uint read4Bytes(uint absByteOff) {
    uint idx = absByteOff >> 2u;
    uint ph  = absByteOff & 3u;
    uint lo  = bank[idx];
    if (ph == 0u) return lo;
    uint hi = bank[idx + 1u];
    return (lo >> (ph * 8u)) | (hi << ((4u - ph) * 8u));
}

float readHalf(uint absByteOff) {
    uint alignedIdx = absByteOff >> 2u;
    uint byteInWord = absByteOff & 3u;
    uint u = bank[alignedIdx];
    uint half16;
    if (byteInWord <= 2u) {
        half16 = (u >> (byteInWord * 8u)) & 0xFFFFu;
    } else {
        uint uNext = bank[alignedIdx + 1u];
        half16 = ((u >> 24) & 0xFFu) | ((uNext & 0xFFu) << 8);
    }
    return unpackHalf2x16(half16).x;
}

// Q4_0 value = d * (nibble - 8). Four nibbles (one per byte, 0..15) -> four packed int8 (nibble - 8) without cross-byte borrow:
// (v + 0x78) stays in 0x78..0x87 per byte (no carry), and flipping bit 7 turns that into the two's-complement byte of (nibble - 8).
uint nibblesMinus8(uint v) {
    return (v + 0x78787878u) ^ 0x80808080u;
}

void main() {
    uint m = gl_WorkGroupID.x;
    uint n = gl_WorkGroupID.y;
    if (m >= pc.M || n >= pc.N) return;

    uint expert = uint(indices[n]);
    if (expert >= pc.numExperts) return;

    uint lane = gl_LocalInvocationID.x;   // 0..31
    uint bi = lane >> 2u;                 // block within the 8-block window
    uint w  = lane & 3u;                  // qs word 0..3

    uint rowByteBase = (expert * pc.M + m) * pc.blocksPerRow * Q4_0_BLOCK_BYTES;
    uint xRow        = n / pc.xDiv;
    uint xqRowBase   = xRow * (pc.K >> 2u);
    uint xdsRowBase  = xRow * (pc.K >> 5u);
    float acc = 0.0;

    for (uint w0 = 0u; w0 < pc.blocksPerRow; w0 += WINDOW_BLOCKS) {
        uint blk = w0 + bi;
        if (blk >= pc.blocksPerRow)
            continue;

        uint blockByteBase = rowByteBase + blk * Q4_0_BLOCK_BYTES;
        float d = readHalf(blockByteBase);
        uint cur = read4Bytes(blockByteBase + 2u + w * 4u);

        uint wLo = nibblesMinus8(cur & 0x0F0F0F0Fu);
        uint wHi = nibblesMinus8((cur >> 4u) & 0x0F0F0F0Fu);

        uint xBase = xqRowBase + blk * 8u;
        int dotI = dotPacked4x8AccSatEXT(int(wLo), int(xq[xBase + w]), 0);
        dotI = dotPacked4x8AccSatEXT(int(wHi), int(xq[xBase + 4u + w]), dotI);

        float dX = xds[xdsRowBase + blk].x;
        acc += d * (dX * float(dotI));
    }

    float total = subgroupAdd(acc);
    if (subgroupElect())
        y[n * pc.M + m] = total;
}
