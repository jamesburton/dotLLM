#version 450
// Q4_K token-embedding gather + dequantize (#1174): the Q4_K twin of q8_0_embed_gather_f32.comp
// (#352). Without it a Q4_K token_embd is widened to a vocab x hidden F32 device table at upload
// (Qwen3.8-27B: 682 MiB packed -> 4.85 GiB F32, #919) just to gather one row per token.
//
// The per-element decode is q4_k_dequant_f32.comp's, line for line (same `precise` math, same op
// order), so a gathered row is bit-identical to the CPU dequant and to the widened table.
//
// Dispatch:
//   gl_WorkGroupID.y = token index (0..nTokens-1)
//   gl_WorkGroupID.x = super-block within the row (0..blocksPerRow-1); one element per thread

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufW   { uint  src[]; };  // packed table
layout(set = 0, binding = 1, std430) readonly  buffer BufIds { int   ids[]; };  // [nTokens]
layout(set = 0, binding = 2, std430) writeonly buffer BufY   { float dst[]; };  // [nTokens*hidden]

layout(push_constant) uniform PushConstants {
    uint nTokens;      // number of tokens to gather
    uint hidden;       // row length in elements (multiple of 256)
    uint blocksPerRow; // = hidden / 256
    uint vocabSize;    // row-count bound (defensive clamp)
} pc;

const uint Q4K_BLOCK_BYTES = 144u;
const uint Q4K_GROUP_SIZE  = 256u;

uint readByte(uint absByteOff) {
    uint u = src[absByteOff >> 2u];
    uint shift = (absByteOff & 3u) * 8u;
    return (u >> shift) & 0xFFu;
}

float readHalf(uint absByteOff) {
    uint alignedIdx = absByteOff >> 2u;
    uint byteInWord = absByteOff & 3u;
    uint u = src[alignedIdx];
    uint half16;
    if (byteInWord <= 2u) {
        half16 = (u >> (byteInWord * 8u)) & 0xFFFFu;
    } else {
        uint uNext = src[alignedIdx + 1u];
        half16 = ((u >> 24) & 0xFFu) | ((uNext & 0xFFu) << 8);
    }
    return unpackHalf2x16(half16).x;
}

void main() {
    uint tok = gl_WorkGroupID.y;
    if (tok >= pc.nTokens || gl_WorkGroupID.x >= pc.blocksPerRow) return;

    // Token ids are host-validated before recording; the clamp is a defensive second gate so a bad
    // id can never read outside the table.
    uint row = uint(ids[tok]);
    if (row >= pc.vocabSize) row = 0u;
    uint block = row * pc.blocksPerRow + gl_WorkGroupID.x;

    uint t = gl_LocalInvocationID.x;        // 0..255
    uint blockBase  = block * Q4K_BLOCK_BYTES;
    uint scalesBase = blockBase + 4u;
    uint qsBase     = blockBase + 16u;

    float d    = readHalf(blockBase);
    float dmin = readHalf(blockBase + 2u);

    uint j = t >> 5u;                        // sub-block 0..7
    uint i = t & 31u;

    uint sc, mn;
    if (j < 4u) {
        sc = readByte(scalesBase + j) & 63u;
        mn = readByte(scalesBase + j + 4u) & 63u;
    } else {
        sc = (readByte(scalesBase + j + 4u) & 0xFu) | ((readByte(scalesBase + j - 4u) >> 6u) << 4u);
        mn = (readByte(scalesBase + j + 4u) >> 4u)  | ((readByte(scalesBase + j) >> 6u) << 4u);
    }

    uint qsByte = readByte(qsBase + (j >> 1u) * 32u + i);
    uint nibble = ((j & 1u) == 0u) ? (qsByte & 0xFu) : (qsByte >> 4u);

    precise float scf = d * float(sc);
    precise float mnf = dmin * float(mn);
    precise float v = scf * float(nibble) - mnf;
    dst[tok * pc.hidden + gl_WorkGroupID.x * Q4K_GROUP_SIZE + t] = v;
}
