#version 450
// In-place GeGLU on F16 activations: up[i] = f16(gelu_tanh(gate[i]) * up[i]) (issue #1472, EmbeddingGemma FFN: down(gelu_tanh(gate(x)) * up(x))).
// gelu_tanh(g) = 0.5 * g * (1 + tanh(sqrt(2/pi) * (g + 0.044715 g^3))), F32 in registers; the product is rounded to F16 once.
// Dispatch: local_size_x = 256, groupCount.x = ceil(n / 256).

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer BufGate { float16_t gate[]; };
layout(set = 0, binding = 1, std430)          buffer BufUp   { float16_t up[]; };

layout(push_constant) uniform PushConstants {
    uint n;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    float g = float(gate[i]);
    float t = 0.7978845608028654 * (g + 0.044715 * g * g * g);
    // tanh(t) = (1 - e) / (1 + e), e = exp(-2t): finite for large |t| (a clamp keeps exp from overflowing)
    float e = exp(-2.0 * clamp(t, -20.0, 20.0));
    float th = (1.0 - e) / (1.0 + e);
    up[i] = float16_t(0.5 * g * (1.0 + th) * float(up[i]));
}
