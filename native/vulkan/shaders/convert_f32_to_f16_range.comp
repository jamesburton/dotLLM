#version 450
// F32 -> F16 range convert for the Qwen4-Exp F16 KV / indexer-key caches (issue #437).
//
// dst[dstWordOffset + i] = packHalf2x16(src[2i], src[2i+1]) for i < nWords: two consecutive F32 elements become one 32-bit word of
// the F16 destination (uint-backed, so no 16-bit-storage device feature is needed). The destination element offset and the element
// count are both even by construction (row widths are even). Values are clamped to the finite F16 range so an outlier saturates
// instead of becoming an infinity that would poison a whole softmax row.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufSrc { float src[]; };   // starts at element 0
layout(set = 0, binding = 1, std430) writeonly buffer BufDst { uint  dst[]; };

layout(push_constant) uniform PushConstants {
    uint dstWordOffset;
    uint nWords;
} pc;

// packHalf2x16's rounding is implementation-defined and AMD hardware converts toward zero (a -2.4e-4 relative bias on every cached value).
// Rounding the mantissa to 10 bits in the integer domain first (round-to-nearest-even) makes the pack exact and driver independent.
float roundToHalfRne(float x) {
    uint b = floatBitsToUint(x);
    b += 0xFFFu + ((b >> 13u) & 1u);
    return uintBitsToFloat(b & 0xFFFFE000u);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.nWords) return;
    vec2 v = clamp(vec2(src[2u * i], src[2u * i + 1u]), vec2(-65504.0), vec2(65504.0));
    dst[pc.dstWordOffset + i] = packHalf2x16(vec2(roundToHalfRne(v.x), roundToHalfRne(v.y)));
}
