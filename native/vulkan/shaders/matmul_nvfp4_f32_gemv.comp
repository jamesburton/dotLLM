#version 450
// NVFP4 matrix-vector multiplication (decode-path GEMV, #1038).
//
//   y[m] = scale * sum_k W_nvfp4[m, k] * x[k]
//
// `scale` is the weight's per-tensor X.scale (llama.cpp build_lora_mm: mul_mat(w, x) * w_s), 1 when absent.
// Layout and decode: nvfp4_decode.glsl. x/y are FP32 (no activation quantization).
// One workgroup per output row; 128 threads stride across the row's blocks, then a shared-memory reduce.

#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufW { uint  weight[]; };
layout(set = 0, binding = 1, std430) readonly  buffer BufX { float x[]; };
layout(set = 0, binding = 2, std430) writeonly buffer BufY { float y[]; };

layout(push_constant) uniform PushConstants {
    uint  M;
    uint  K;             // multiple of 64
    uint  blocksPerRow;  // K / 64
    float scale;         // per-tensor X.scale
} pc;

#include "nvfp4_decode.glsl"

shared float partials[128];

void main() {
    uint m = gl_WorkGroupID.x;
    if (m >= pc.M) return;
    uint tid = gl_LocalInvocationID.x;

    float acc = 0.0;
    for (uint b = tid; b < pc.blocksPerRow; b += 128u) {
        uint wb = (m * pc.blocksPerRow + b) * NVFP4_BLOCK_UINTS;
        uint scales = weight[wb];
        uint xb = b * NVFP4_GROUP_SIZE;
        for (uint s = 0u; s < 4u; s++) {
            float d = ue4m3_half((scales >> (8u * s)) & 0xFFu);
            float sub = 0.0;
            for (uint h = 0u; h < 2u; h++) {          // two words = 8 bytes = this sub-block's qs
                uint q = weight[wb + 1u + 2u * s + h];
                uint e = xb + 16u * s + 4u * h;     // element of byte (4h + i) low nibble
                for (uint i = 0u; i < 4u; i++) {
                    uint byteVal = (q >> (8u * i)) & 0xFFu;
                    sub += x[e + i]      * KVALUES_FP4[byteVal & 0xFu]
                         + x[e + i + 8u] * KVALUES_FP4[byteVal >> 4u];
                }
            }
            acc += d * sub;
        }
    }

    partials[tid] = acc;
    barrier();
    for (uint stride = 64u; stride > 0u; stride >>= 1u) {
        if (tid < stride) partials[tid] += partials[tid + stride];
        barrier();
    }
    if (tid == 0u) y[m] = partials[0] * pc.scale;
}
