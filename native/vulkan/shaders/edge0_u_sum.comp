#version 450
// Edge0 latent MoE (G3, #1981): out[i] = u0[i] + u1[i] + ... + u7[i] (the eight per-group U outputs, group order ascending like the CPU oracle).
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer B0 { float u0[]; };
layout(set = 0, binding = 1, std430) readonly  buffer B1 { float u1[]; };
layout(set = 0, binding = 2, std430) readonly  buffer B2 { float u2[]; };
layout(set = 0, binding = 3, std430) readonly  buffer B3 { float u3[]; };
layout(set = 0, binding = 4, std430) readonly  buffer B4 { float u4[]; };
layout(set = 0, binding = 5, std430) readonly  buffer B5 { float u5[]; };
layout(set = 0, binding = 6, std430) readonly  buffer B6 { float u6[]; };
layout(set = 0, binding = 7, std430) readonly  buffer B7 { float u7[]; };
layout(set = 0, binding = 8, std430) writeonly buffer BO { float outv[]; };

layout(push_constant) uniform PushConstants { uint n; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    outv[i] = ((((((u0[i] + u1[i]) + u2[i]) + u3[i]) + u4[i]) + u5[i]) + u6[i]) + u7[i];
}
