#version 450
#extension GL_EXT_integer_dot_product : require
// Q2_K MMQ prefill GEMM: integer-dot (dp4a) batched matrix multiply.
//
//   C[N, M] = B[N, K] @ W_q2k[M, K]^T
//
// Q2_K reconstructs w = d·scale·q2 − dmin·dmCoef with a per-256 (d, dmin) and a per-16
// (4-bit scale, 4-bit dmCoef). Per 16-element sub-block:
//   sum_i w_i·x_i = d·scale·d_x·dp4a(q2, xq) − dmin·dmCoef·d_x·sum(xq)
// The min term needs the PER-16 activation sum (the stored Q8_1 s_x is per-32, spanning
// two Q2_K sub-blocks with different dmCoef), so it is computed in-kernel as
// dp4a(0x01010101, xq). The seqLen>1 analogue of matmul_q2_k_mmvq.comp.
//
// NOT bit-exact vs the F32-in GEMM (B int8-quantized first); validated vs the CPU F32
// oracle (argmax + tolerance). 16×16 tile, weights decoded into shared int8 once/super-block.
//
// Q2_K super-block layout (84 bytes / 256; matches matmul_q2_k_mmvq.comp):
//   [0..15]=scales[16] (low nibble = scale, high = dmCoef)  [16..79]=qs[64] (2-bit, 16/sub)
//   [80,81]=fp16 d  [82,83]=fp16 dmin.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufW   { uint  weight[]; };
layout(set = 0, binding = 1, std430) readonly  buffer BufXq  { uint  xq[]; };
layout(set = 0, binding = 2, std430) readonly  buffer BufXds { vec2  xds[]; };
layout(set = 0, binding = 3, std430) writeonly buffer BufC   { float c[]; };

layout(push_constant) uniform PushConstants {
    uint M;
    uint K;            // multiple of 256
    uint N;
    uint blocksPerRow; // = K / 256
    uint rowUints;     // unused
} pc;

const uint TILE_M = 16u;
const uint TILE_N = 16u;
const uint SB_BYTES     = 84u;
const uint SUBS         = 16u;   // 16-element sub-blocks per super-block
const uint CHUNKS       = 8u;    // 32-element Q8_1 blocks per super-block
const uint UINTS_PER_SB = 64u;   // 256 int8 / 4

shared uint  sharedWq[TILE_M * UINTS_PER_SB]; // q2 weights (0..3), element order
shared uint  sharedXq[TILE_N * UINTS_PER_SB]; // Q8_1 activations
shared float sharedWdsc[TILE_M * SUBS];       // d · scale   per (row, sub-16)
shared float sharedWdmn[TILE_M * SUBS];       // dmin · dmCoef per (row, sub-16)
shared float sharedXd[TILE_N * CHUNKS];       // d_x per (token, 32-block)

uint readByte(uint absByteOff) {
    uint u = weight[absByteOff >> 2u];
    return (u >> ((absByteOff & 3u) * 8u)) & 0xFFu;
}

float readHalf(uint absByteOff) {
    uint alignedIdx = absByteOff >> 2u;
    uint byteInWord = absByteOff & 3u;
    uint u = weight[alignedIdx];
    uint half16;
    if (byteInWord <= 2u) {
        half16 = (u >> (byteInWord * 8u)) & 0xFFFFu;
    } else {
        uint uNext = weight[alignedIdx + 1u];
        half16 = ((u >> 24) & 0xFFu) | ((uNext & 0xFFu) << 8);
    }
    return unpackHalf2x16(half16).x;
}

uint packQ2(uint qw, uint bit0) {
    uint v0 = (qw >> bit0)        & 3u;
    uint v1 = (qw >> (bit0 + 2u)) & 3u;
    uint v2 = (qw >> (bit0 + 4u)) & 3u;
    uint v3 = (qw >> (bit0 + 6u)) & 3u;
    return v0 | (v1 << 8u) | (v2 << 16u) | (v3 << 24u);
}

void main() {
    uint m = gl_WorkGroupID.x * TILE_M + gl_LocalInvocationID.x;
    uint t = gl_WorkGroupID.y * TILE_N + gl_LocalInvocationID.y;
    uint tid = gl_LocalInvocationID.y * TILE_M + gl_LocalInvocationID.x;

    uint mBase = gl_WorkGroupID.x * TILE_M;
    uint tBase = gl_WorkGroupID.y * TILE_N;

    uint rowByteStride = pc.blocksPerRow * SB_BYTES;
    float acc = 0.0;

    for (uint kSB = 0u; kSB < pc.blocksPerRow; kSB++) {
        // ---- 1. Stage weights: 16 rows × 64 element-order uints (decode 2-bit). ----
        for (uint s = 0u; s < 4u; s++) {
            uint idx = tid + s * 256u;       // 0..1023
            uint rLocal = idx >> 6u;         // 0..15 weight row
            uint u      = idx & 63u;         // 0..63 element-order uint
            uint sub = u >> 2u;              // 0..15 sub-block
            uint p   = u & 3u;               // 0..3 quartet within sub-block
            uint mGlobal = mBase + rLocal;
            uint packed = 0u;
            if (mGlobal < pc.M) {
                uint blockByteBase = mGlobal * rowByteStride + kSB * SB_BYTES;
                uint qw = weight[((blockByteBase + 16u) >> 2u) + sub]; // sub-block's 16 2-bit values
                packed = packQ2(qw, p * 8u);
            }
            sharedWq[rLocal * UINTS_PER_SB + u] = packed;
        }

        // ---- 2. Stage weight scales: 16 rows × 16 sub-blocks (d·sc, dmin·dmCoef). ----
        if (tid < TILE_M * SUBS) {
            uint rLocal = tid >> 4u;         // 0..15
            uint sub    = tid & 15u;         // 0..15
            uint mGlobal = mBase + rLocal;
            float dsc = 0.0, dmn = 0.0;
            if (mGlobal < pc.M) {
                uint blockByteBase = mGlobal * rowByteStride + kSB * SB_BYTES;
                float d    = readHalf(blockByteBase + 80u);
                float dmin = readHalf(blockByteBase + 82u);
                uint scByte = readByte(blockByteBase + sub);
                dsc = d * float(scByte & 0xFu);
                dmn = dmin * float((scByte >> 4u) & 0xFu);
            }
            sharedWdsc[rLocal * SUBS + sub] = dsc;
            sharedWdmn[rLocal * SUBS + sub] = dmn;
        }

        // ---- 3. Stage activations: 16 token rows × 64 int8-uints. ----
        for (uint s = 0u; s < 4u; s++) {
            uint idx = tid + s * 256u;
            uint rLocal = idx >> 6u;
            uint u      = idx & 63u;
            uint tGlobal = tBase + rLocal;
            uint v = 0u;
            if (tGlobal < pc.N) {
                v = xq[tGlobal * (pc.K >> 2u) + kSB * UINTS_PER_SB + u];
            }
            sharedXq[rLocal * UINTS_PER_SB + u] = v;
        }

        // ---- 4. Stage activation scales: 16 rows × 8 d_x (per-32-block). ----
        if (tid < TILE_N * CHUNKS) {
            uint rLocal = tid >> 3u;
            uint cc     = tid & 7u;
            uint tGlobal = tBase + rLocal;
            float dx = 0.0;
            if (tGlobal < pc.N) {
                dx = xds[tGlobal * (pc.K >> 5u) + kSB * CHUNKS + cc].x;
            }
            sharedXd[rLocal * CHUNKS + cc] = dx;
        }

        barrier();

        // ---- 5. dp4a over this super-block for output cell (t, m). ----
        {
            uint wRow = gl_LocalInvocationID.x;
            uint tRow = gl_LocalInvocationID.y;
            for (uint sub = 0u; sub < SUBS; sub++) {
                uint wbase = wRow * UINTS_PER_SB + sub * 4u;
                uint xbase = tRow * UINTS_PER_SB + sub * 4u;
                int dotI = 0, sumXq = 0;
                for (uint g = 0u; g < 4u; g++) {
                    int xv = int(sharedXq[xbase + g]);
                    dotI  = dotPacked4x8AccSatEXT(int(sharedWq[wbase + g]), xv, dotI);
                    sumXq = dotPacked4x8AccSatEXT(0x01010101, xv, sumXq);
                }
                float dX = sharedXd[tRow * CHUNKS + (sub >> 1u)]; // 2 sub-16 share a 32-block d_x
                acc += sharedWdsc[wRow * SUBS + sub] * (dX * float(dotI))
                     - sharedWdmn[wRow * SUBS + sub] * (dX * float(sumXq));
            }
        }

        barrier();
    }

    if (m < pc.M && t < pc.N) {
        c[t * pc.M + m] = acc;
    }
}
