#version 450
// In-place SwiGLU on F16 activations: up[i] = f16(silu(gate[i]) * up[i]) (issue #1471, nomic-bert FFN: down(silu(gate(x)) * up(x))).
// silu(g) = g * sigmoid(g), F32 in registers; the product is rounded to F16 once. Dispatch: local_size_x = 256, groupCount.x = ceil(n / 256).

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer BufGate { float16_t gate[]; };
layout(set = 0, binding = 1, std430)          buffer BufUp   { float16_t up[]; };

layout(push_constant) uniform PushConstants {
    uint n;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    float g = float(gate[i]);
    up[i] = float16_t(g / (1.0 + exp(-g)) * float(up[i]));
}
