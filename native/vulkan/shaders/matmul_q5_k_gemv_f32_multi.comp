#version 450
#extension GL_EXT_control_flow_attributes : require

// Q5_K multi-column GEMV (1..16 activation rows, #902; NR output rows per workgroup and a deterministic reduction, #1515):
// Y[col, m] = sum_k W[m, k] * X[col, k].
//
// #1515: the Q4_K multi-column kernel's structure (#1220, #1511) for Q5_K. NR (constant_id 1) output rows share each workgroup's activation
// loads; the weight blob is read as 16-byte units (a 176-byte super-block is exactly 11 of them: header, qh x2, qs x8); the loop is software
// pipelined (the next block pair is loaded into a second register set before the current one is consumed); every weight is dequantised once per
// row (w = sc * code - min) and FMA'd against all NC columns in an explicit `precise` fma chain, reduced by a fixed shared-memory tree. A row's bits
// therefore do not depend on NR or NC (the old shader's `subgroupAdd` order and non-`precise` contraction did: its dispatches differed between
// column counts at ULP level). The old shader streamed 61 MB at 153 GB/s (2 columns) falling to 67 GB/s (8 columns); see docs/SPECULATIVE.md.
//
// Q5_K decode GEMV with an FP32 activation, COALESCED lane=K-position layout (matmul_q5_k_gemv_f32_coalesced.comp for NC columns at once).
//
//   y[m] = sum_k W_q5k[m,k] * x[k]
//
// Super-block (176 bytes = 44 uint = 11 uvec4, every field word-aligned):
//   word 0        = fp16 d | fp16 dmin << 16
//   words 1..3    = scales[12] (8 x 6-bit scale + 8 x 6-bit min, get_scale_min_k4 packing)      -> uvec4 0
//   words 4..11   = qh[32]  : bit `sb` of qh[i] is the 5th bit of element i of sub-block sb      -> uvec4 1..2
//   words 12..43  = qs[128] : nibble (sb & 1) of qs[(sb >> 1) * 32 + i]                          -> uvec4 3..10
// value = d*scale[sb]*q5 - dmin*min[sb],  q5 = nibble | (qhbit << 4).
//
// Lane l (0..31) of a super-block owns sub-block sb = l / 4 and 8 consecutive i = 8q .. 8q+7 (q = l % 4): two words of qs, two words of qh and
// two vec4 of activations. A 64-lane workgroup covers two super-blocks per window step.
//
// Dispatch: one workgroup of 64 threads per NR output rows; a fixed shared-memory tree reduction. X is [NC, K], Y is [NC, M].

#define WG_SIZE 64u
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const uint NC = 2u;
layout(constant_id = 1) const uint NR = 1u;

layout(set = 0, binding = 0, std430) readonly  buffer BufW { uvec4 weight4[]; }; // Q5_K blob as 16-byte units: 11 per super-block
layout(set = 0, binding = 1, std430) readonly  buffer BufX { vec4 x4[]; };      // [NC, K/4]
layout(set = 0, binding = 2, std430) writeonly buffer BufY { float y[]; };      // [NC, M]

layout(push_constant) uniform PushConstants {
    uint M;
    uint K;
    uint blocksPerRow;   // = K / 256 (super-blocks)
    uint rowUints;       // unused; kept for parity with matmul_q5_k_gemv_f32
} pc;

const uint VEC4_PER_BLOCK = 11u;
const uint WINDOW_BLOCKS   = WG_SIZE / 32u;

// Byte i (0..11) of the 12-byte scales region held in words s0..s2.
uint scaleByte(uint s0, uint s1, uint s2, uint i) {
    uint w = (i < 4u) ? s0 : ((i < 8u) ? s1 : s2);
    return (w >> ((i & 3u) * 8u)) & 0xFFu;
}

// (scale, min) pair j (0..7); mirrors llama.cpp get_scale_min_k4.
uvec2 scaleMin(uint s0, uint s1, uint s2, uint j) {
    if (j < 4u)
        return uvec2(scaleByte(s0, s1, s2, j) & 63u, scaleByte(s0, s1, s2, j + 4u) & 63u);
    uint hiByte = scaleByte(s0, s1, s2, j + 4u);
    uint sc = (hiByte & 0xFu)        | (((scaleByte(s0, s1, s2, j - 4u) >> 6u) & 0x3u) << 4u);
    uint mn = ((hiByte >> 4u) & 0xFu) | (((scaleByte(s0, s1, s2, j)      >> 6u) & 0x3u) << 4u);
    return uvec2(sc, mn);
}

// Four 5-bit codes: nibble `shift` of each byte of `u`, plus bit `sb` of each byte of `qh` as the 5th bit.
vec4 codes5(uint u, uint shift, uint qh, uint sb) {
    return vec4(float(((u >> shift) & 0xFu)         | (((qh >> sb) & 1u) << 4u)),
                float(((u >> (shift + 8u)) & 0xFu)  | (((qh >> (8u + sb)) & 1u) << 4u)),
                float(((u >> (shift + 16u)) & 0xFu) | (((qh >> (16u + sb)) & 1u) << 4u)),
                float(((u >> (shift + 24u)) & 0xFu) | (((qh >> (24u + sb)) & 1u) << 4u)));
}

shared float partials[NR * NC][WG_SIZE];

void main() {
    uint m0 = gl_WorkGroupID.x * NR;
    if (m0 >= pc.M) return;

    uint lane = gl_LocalInvocationID.x;
    uint blockInWindow = lane >> 5u;
    uint l32 = lane & 31u;
    uint sb  = l32 >> 2u;
    uint q   = l32 & 3u;
    uint shift = (sb & 1u) * 4u;

    // Rows past M (last workgroup) duplicate row M-1 and are not stored.
    uint rowBase[NR];
    [[unroll]] for (uint r = 0u; r < NR; ++r) rowBase[r] = min(m0 + r, pc.M - 1u) * pc.blocksPerRow * VEC4_PER_BLOCK;

    uint xRow4 = pc.K >> 2u;   // vec4 per activation row
    precise float acc[NR * NC];
    [[unroll]] for (uint i = 0u; i < NR * NC; ++i) acc[i] = 0.0;
#define LOAD(H, QH, Q, XA, XB, BLK) { \
    uint bl_ = min((BLK), pc.blocksPerRow - 1u); \
    uint xi_ = bl_ * 64u + sb * 8u + 2u * q; \
    [[unroll]] for (uint r = 0u; r < NR; ++r) { \
        uint b_ = rowBase[r] + bl_ * VEC4_PER_BLOCK; \
        H[r] = weight4[b_]; \
        QH[r] = weight4[b_ + 1u + (q >> 1u)]; \
        Q[r] = weight4[b_ + 3u + (sb >> 1u) * 2u + (q >> 1u)]; \
    } \
    [[unroll]] for (uint cc = 0u; cc < NC; ++cc) { \
        XA[cc] = x4[cc * xRow4 + xi_]; \
        XB[cc] = x4[cc * xRow4 + xi_ + 1u]; \
    } \
}
#define COMPUTE(H, QH, Q, XA, XB) { \
    vec4 wA[NR]; vec4 wB[NR]; \
    [[unroll]] for (uint r = 0u; r < NR; ++r) { \
        vec2 dd = unpackHalf2x16(H[r].x); \
        uvec2 sm = scaleMin(H[r].y, H[r].z, H[r].w, sb); \
        float sc = dd.x * float(sm.x); \
        float mn = dd.y * float(sm.y); \
        uvec2 qw = ((q & 1u) != 0u) ? Q[r].zw : Q[r].xy; \
        uvec2 qhw = ((q & 1u) != 0u) ? QH[r].zw : QH[r].xy; \
        wA[r] = fma(vec4(sc), codes5(qw.x, shift, qhw.x, sb), vec4(-mn)); \
        wB[r] = fma(vec4(sc), codes5(qw.y, shift, qhw.y, sb), vec4(-mn)); \
    } \
    [[unroll]] for (uint cc = 0u; cc < NC; ++cc) { \
        [[unroll]] for (uint r = 0u; r < NR; ++r) { \
            precise float a = acc[r * NC + cc]; \
            a = fma(wA[r].x, XA[cc].x, a); a = fma(wA[r].y, XA[cc].y, a); a = fma(wA[r].z, XA[cc].z, a); a = fma(wA[r].w, XA[cc].w, a); \
            a = fma(wB[r].x, XB[cc].x, a); a = fma(wB[r].y, XB[cc].y, a); a = fma(wB[r].z, XB[cc].z, a); a = fma(wB[r].w, XB[cc].w, a); \
            acc[r * NC + cc] = a; \
        } \
    } \
}

    // Software pipelined (#1511): the loads for the next block-pair are issued before the current one is consumed, in two register sets
    // that swap roles each half-iteration (no copies).
    uint nb = pc.blocksPerRow;
    uvec4 hA[NR]; uvec4 qhA[NR]; uvec4 qA[NR]; vec4 xaA[NC]; vec4 xbA[NC];
    uvec4 hB[NR]; uvec4 qhB[NR]; uvec4 qB[NR]; vec4 xaB[NC]; vec4 xbB[NC];
    uint blk = blockInWindow;
    LOAD(hA, qhA, qA, xaA, xbA, blk)
    for (; blk < nb; blk += 2u * WINDOW_BLOCKS) {
        LOAD(hB, qhB, qB, xaB, xbB, blk + WINDOW_BLOCKS)
        COMPUTE(hA, qhA, qA, xaA, xbA)
        if (blk + WINDOW_BLOCKS < nb) {
            LOAD(hA, qhA, qA, xaA, xbA, blk + 2u * WINDOW_BLOCKS)
            COMPUTE(hB, qhB, qB, xaB, xbB)
        }
    }

    // Fixed shared-memory tree over the 64 lanes, NOT subgroupAdd: a driver may compile each NR / NC pipeline at a different subgroup width.
    [[unroll]] for (uint i = 0u; i < NR * NC; ++i) partials[i][lane] = acc[i];
    barrier();
    [[unroll]] for (uint stride = WG_SIZE / 2u; stride > 0u; stride >>= 1u) {
        if (lane < stride)
            [[unroll]] for (uint i = 0u; i < NR * NC; ++i) partials[i][lane] = partials[i][lane] + partials[i][lane + stride];
        barrier();
    }
    if (lane < NR * NC) {
        uint r = lane / NC, cc = lane - r * NC;
        if (m0 + r < pc.M)
            y[cc * pc.M + m0 + r] = partials[lane][0];
    }
}
