#version 450
// Q4_1 batched GEMM on the shared blocked coopmat template at a 64x64 output tile (issue #1161): the small-grid twin of
// matmul_q4_1_f32_gemm_coopmat_128x128x4.comp. Flint's prefill projections at n = 512 with m = 512 (k / v) or 1024 (shared expert gate /
// up) give the 128x128 tile 16-32 workgroups on a 40-CU part; 64x64 gives 64-128 with no stored partials (no split-K).
//
//   C[N, M] = B[N, K] @ W_q4_1[M, K]^T,  W dequantised on the fly; numerics identical to the 128x128 kernel (same F16 operands, same
//   BK = 32 K order into one F32 accumulator per output).
//
// Four lanes per weight row; lane l stages elements 8l .. 8l + 7 of the 32-element block: lanes 0 / 1 the low nibbles of qs bytes
// 0..7 / 8..15, lanes 2 / 3 the high nibbles of the same bytes.

#define BM  64
#define BN  64
#define WM  32
#define WN  32
#define NSG 4
#define WAVE 64

#extension GL_GOOGLE_include_directive : require

layout(set = 0, binding = 0, std430) readonly  buffer BufW { uint  weight[]; }; // Q4_1 blob
layout(set = 0, binding = 1, std430) readonly  buffer BufB { vec4 b4[]; };      // [N*K]
layout(set = 0, binding = 2, std430) writeonly buffer BufC { float c[]; };      // [N*M]

layout(push_constant) uniform PushConstants {
    uint M;             // output dim (number of weight rows)
    uint K;             // contraction dim (must be a multiple of 32)
    uint N;             // batch size (number of input rows)
    uint blocksPerRow;  // = K / 32
    uint rowUints;      // per-row uint stride
} pc;

#include "gemm_coopmat_blocked_decl.glsl"

const uint BLOCK_BYTES = 20u;   // 2 (fp16 d) + 2 (fp16 m) + 16 (qs)

const uint A_LANES_PER_ROW = BLOCK_SIZE / BM;        // 4 threads cooperate on one weight row
const uint A_COLS_PER_THR  = BK / A_LANES_PER_ROW;   // 8 codes per thread

void gemmStageA(uint ch) {
    uint rowLocal  = g_tid / A_LANES_PER_ROW;
    uint laneOfRow = g_tid % A_LANES_PER_ROW;
    uint mGlobal   = g_mBase + rowLocal;
    uint sBase     = rowLocal * STRIDE + laneOfRow * A_COLS_PER_THR;

    if (mGlobal >= pc.M) {
        for (uint j = 0u; j < A_COLS_PER_THR; j++) sharedA[sBase + j] = float16_t(0.0);
        return;
    }

    uint blockBase = mGlobal * (pc.blocksPerRow * BLOCK_BYTES) + ch * BLOCK_BYTES;
    uint wi = blockBase >> 2u;
    vec2 dm = unpackHalf2x16(weight[wi]);
    uint byteWord = (laneOfRow & 1u) * 2u;              // qs words 0-1 (bytes 0..7) or 2-3 (bytes 8..15)
    uint nibSh = (laneOfRow >> 1u) * 4u;                // low or high nibble plane
    [[unroll]] for (uint m = 0u; m < 2u; m++) {
        uint qw = weight[wi + 1u + byteWord + m];
        [[unroll]] for (uint jb = 0u; jb < 4u; jb++) {
            uint nib = (qw >> (jb * 8u + nibSh)) & 0xFu;
            sharedA[sBase + m * 4u + jb] = float16_t(dm.x * float(nib) + dm.y);
        }
    }
}

#define GEMM_M          pc.M
#define GEMM_K          pc.K
#define GEMM_CHUNKS     pc.blocksPerRow
#define GEMM_ROW_BASE   0u
#define GEMM_ROW_LIMIT  pc.N
#define GEMM_B_BUF      b4
#define GEMM_B_VEC4
#define GEMM_C_BUF      c

#include "gemm_coopmat_blocked_main.glsl"
