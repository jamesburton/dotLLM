#version 450
#extension GL_EXT_integer_dot_product : require
// Grouped Q4_K MoE expert matmul: dp4a (Q8_1-activation) register-tiled MMQ (issue #986).
//
//   Y[packedRow, m] = Xq8[packedRow, :] @ W_q4k[expert, m, :]^T
//
// This is the grouped-MoE analogue of matmul_q4_k_mmq.comp: same 64x64 register-tiled
// dp4a tiling, but rows are grouped by expert (offsets[expert]..offsets[expert+1]) and
// weights are indexed from a packed expert bank. The activation has been pre-quantized
// to Q8_1 by quantize_q8_1_rows.comp AFTER the MoeExpandGroupByExpert sort, so within
// a tile all N rows share the same expert and therefore the same weight matrix — the
// dense MMQ's tiling assumption holds.
//
// Replaces the coopmat F16 grouped kernel (moe_grouped_matmul_q4_k_coopmat.comp) which
// reads F32 activations and converts to F16 in LDS — dp4a on Q8_1 is ~4x more ALU
// efficient and the 64x64 tile amortises weight loads over 16x more output cells.
//
// Bank layout: [E, M, K/256 super-blocks of 144 bytes].
// Q4_K super-block layout (144 bytes / 256 elems): mirrors matmul_q4_k_mmq.comp.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufW       { uint  weight[]; };  // [E,M,K/256 x 144 B] Q4_K
layout(set = 0, binding = 1, std430) readonly  buffer BufXq      { uint  xq[]; };      // [rows*K/4]
layout(set = 0, binding = 2, std430) readonly  buffer BufXds     { vec2  xds[]; };     // [rows*K/32]
layout(set = 0, binding = 3, std430) readonly  buffer BufOffsets  { uint  offsets[]; }; // [E+1] (+ tile list when tileList != 0)
layout(set = 0, binding = 4, std430) writeonly buffer BufY       { float y[]; };       // [rows*M]

layout(push_constant) uniform PushConstants {
    uint M;             // output dim (weight rows per expert)
    uint K;             // contraction dim (multiple of 256)
    uint rows;          // total packed rows
    uint numExperts;
    uint blocksPerRow;  // = K / 256
    uint rowUints;      // per-expert-row uint stride in the bank
    uint tileList;      // 0 = legacy 3-D grid; else index in `offsets` of the tile work list
} pc;

const uint TILE_M = 64u;
const uint TILE_N = 64u;
const uint TM = 4u;
const uint TN = 4u;
const uint SB_BYTES     = 144u;
const uint SUBS_PER_CHUNK = 4u;
const uint CHUNK_UINTS  = 32u;
const uint CHUNK_STRIDE = 33u;

shared uint  sharedWq[TILE_M * CHUNK_STRIDE];
shared uint  sharedXq[TILE_N * CHUNK_STRIDE];
shared float sharedWdsc[TILE_M * SUBS_PER_CHUNK];
shared float sharedWdmn[TILE_M * SUBS_PER_CHUNK];
shared float sharedXd[TILE_N * SUBS_PER_CHUNK];
shared float sharedXs[TILE_N * SUBS_PER_CHUNK];

uint readByte(uint absByteOff) {
    uint u = weight[absByteOff >> 2u];
    return (u >> ((absByteOff & 3u) * 8u)) & 0xFFu;
}

float readHalf(uint absByteOff) {
    uint alignedIdx = absByteOff >> 2u;
    uint byteInWord = absByteOff & 3u;
    uint u = weight[alignedIdx];
    uint half16;
    if (byteInWord <= 2u) {
        half16 = (u >> (byteInWord * 8u)) & 0xFFFFu;
    } else {
        uint uNext = weight[alignedIdx + 1u];
        half16 = ((u >> 24) & 0xFFu) | ((uNext & 0xFFu) << 8);
    }
    return unpackHalf2x16(half16).x;
}

uvec2 unpackScaleMin(uint scalesByteBase, uint j) {
    uint sc, mn;
    if (j < 4u) {
        sc = readByte(scalesByteBase + j) & 63u;
        mn = readByte(scalesByteBase + j + 4u) & 63u;
    } else {
        uint scLow  = readByte(scalesByteBase + j + 4u) & 0xFu;
        uint scHigh = (readByte(scalesByteBase + j - 4u) >> 6u) & 0x3u;
        sc = scLow | (scHigh << 4u);
        uint mnLow  = (readByte(scalesByteBase + j + 4u) >> 4u) & 0xFu;
        uint mnHigh = (readByte(scalesByteBase + j) >> 6u) & 0x3u;
        mn = mnLow | (mnHigh << 4u);
    }
    return uvec2(sc, mn);
}

void main() {
    uint tx = gl_LocalInvocationID.x;
    uint ty = gl_LocalInvocationID.y;
    uint tid = ty * 16u + tx;

    uint mBase = gl_WorkGroupID.x * TILE_M;

    // Resolve (expert, localRowBase) from tileList or legacy grid.
    uint localRowBase;
    uint expert;
    if (pc.tileList != 0u) {
        uint listIdx = pc.tileList + 2u * gl_WorkGroupID.y;
        expert = offsets[listIdx];
        localRowBase = offsets[listIdx + 1u];
    } else {
        localRowBase = gl_WorkGroupID.y * TILE_N;
        expert = gl_WorkGroupID.z;
        if (expert >= pc.numExperts) return;
    }

    uint expertStart = offsets[expert];
    uint expertRows = offsets[expert + 1u] - expertStart;
    if (localRowBase >= expertRows) return;

    // Weight row base for this expert in the bank.
    uint expertWeightBase = expert * pc.M * pc.rowUints;

    float acc[TM][TN];
    float accPart[TM][TN];
    for (uint i = 0u; i < TM; i++)
        for (uint j = 0u; j < TN; j++) {
            acc[i][j] = 0.0;
            accPart[i][j] = 0.0;
        }

    for (uint kSB = 0u; kSB < pc.blocksPerRow; kSB++) {
        if ((kSB % 4u) == 0u && kSB > 0u) {
            for (uint i = 0u; i < TM; i++)
                for (uint j = 0u; j < TN; j++) {
                    acc[i][j] += accPart[i][j];
                    accPart[i][j] = 0.0;
                }
        }

        for (uint h = 0u; h < 2u; h++) {
            // ---- 1. Stage weights from the expert bank. ----
            for (uint s = 0u; s < 4u; s++) {
                uint idx = tid + s * 256u;
                uint rLocal = idx >> 4u;
                uint lane   = idx & 15u;
                uint u      = h * 16u + lane;
                uint mGlobal = mBase + rLocal;
                uint cur = 0u;
                if (mGlobal < pc.M) {
                    uint rowBase = expertWeightBase + mGlobal * pc.rowUints;
                    uint blockByteBase = rowBase * 4u + kSB * SB_BYTES;
                    cur = weight[((blockByteBase + 16u) >> 2u) + u];
                }
                uint lo = ( cur        & 0x0Fu)
                        | ((cur >>  8u) & 0x0Fu) << 8u
                        | ((cur >> 16u) & 0x0Fu) << 16u
                        | ((cur >> 24u) & 0x0Fu) << 24u;
                uint hi = ((cur >>  4u) & 0x0Fu)
                        | ((cur >> 12u) & 0x0Fu) << 8u
                        | ((cur >> 20u) & 0x0Fu) << 16u
                        | ((cur >> 28u) & 0x0Fu) << 24u;
                uint p  = u >> 3u;
                uint g  = u & 7u;
                uint jl = (p - h * 2u) * 2u;
                sharedWq[rLocal * CHUNK_STRIDE + jl * 8u + g]        = lo;
                sharedWq[rLocal * CHUNK_STRIDE + (jl + 1u) * 8u + g] = hi;
            }

            // ---- 2. Stage weight scales. ----
            {
                uint rLocal = tid >> 2u;
                uint jl     = tid & 3u;
                uint j      = h * SUBS_PER_CHUNK + jl;
                uint mGlobal = mBase + rLocal;
                float dsc = 0.0, dmn = 0.0;
                if (mGlobal < pc.M) {
                    uint rowBase = expertWeightBase + mGlobal * pc.rowUints;
                    uint blockByteBase = rowBase * 4u + kSB * SB_BYTES;
                    float d    = readHalf(blockByteBase);
                    float dmin = readHalf(blockByteBase + 2u);
                    uvec2 sm = unpackScaleMin(blockByteBase + 4u, j);
                    dsc = d * float(sm.x);
                    dmn = dmin * float(sm.y);
                }
                sharedWdsc[rLocal * SUBS_PER_CHUNK + jl] = dsc;
                sharedWdmn[rLocal * SUBS_PER_CHUNK + jl] = dmn;
            }

            // ---- 3. Stage activations from the expert-sorted Q8_1 rows. ----
            for (uint s = 0u; s < 8u; s++) {
                uint idx = tid + s * 256u;
                uint rLocal = idx >> 5u;
                uint u      = idx & 31u;
                uint lr     = localRowBase + rLocal;
                uint tGlobal = (lr < expertRows) ? (expertStart + lr) : 0u;
                uint v = 0u;
                if (lr < expertRows) {
                    uint xqRowBase = tGlobal * (pc.K >> 2u);
                    v = xq[xqRowBase + kSB * 64u + h * CHUNK_UINTS + u];
                }
                sharedXq[rLocal * CHUNK_STRIDE + u] = v;
            }

            // ---- 4. Stage activation scales. ----
            {
                uint rLocal = tid >> 2u;
                uint jl     = tid & 3u;
                uint lr     = localRowBase + rLocal;
                uint tGlobal = (lr < expertRows) ? (expertStart + lr) : 0u;
                float dx = 0.0, sx = 0.0;
                if (lr < expertRows) {
                    vec2 ds = xds[tGlobal * (pc.K >> 5u) + kSB * 8u + h * SUBS_PER_CHUNK + jl];
                    dx = ds.x; sx = ds.y;
                }
                sharedXd[rLocal * SUBS_PER_CHUNK + jl] = dx;
                sharedXs[rLocal * SUBS_PER_CHUNK + jl] = sx;
            }

            barrier();

            // ---- 5. dp4a: 4×4 register tile per thread. ----
            for (uint jl = 0u; jl < SUBS_PER_CHUNK; jl++) {
                int dotI[TM][TN];
                for (uint i = 0u; i < TM; i++)
                    for (uint j = 0u; j < TN; j++)
                        dotI[i][j] = 0;
                for (uint g = 0u; g < 8u; g++) {
                    uint wv[TM];
                    uint xv[TN];
                    for (uint i = 0u; i < TM; i++)
                        wv[i] = sharedWq[(tx + 16u * i) * CHUNK_STRIDE + jl * 8u + g];
                    for (uint j = 0u; j < TN; j++)
                        xv[j] = sharedXq[(ty + 16u * j) * CHUNK_STRIDE + jl * 8u + g];
                    for (uint i = 0u; i < TM; i++)
                        for (uint j = 0u; j < TN; j++)
                            dotI[i][j] = dotPacked4x8AccSatEXT(int(wv[i]), int(xv[j]), dotI[i][j]);
                }
                for (uint i = 0u; i < TM; i++) {
                    float dsc = sharedWdsc[(tx + 16u * i) * SUBS_PER_CHUNK + jl];
                    float dmn = sharedWdmn[(tx + 16u * i) * SUBS_PER_CHUNK + jl];
                    for (uint j = 0u; j < TN; j++) {
                        float dx = sharedXd[(ty + 16u * j) * SUBS_PER_CHUNK + jl];
                        float sx = sharedXs[(ty + 16u * j) * SUBS_PER_CHUNK + jl];
                        accPart[i][j] += dsc * (dx * float(dotI[i][j])) - dmn * sx;
                    }
                }
            }

            barrier();
        }
    }

    for (uint i = 0u; i < TM; i++)
        for (uint j = 0u; j < TN; j++)
            acc[i][j] += accPart[i][j];

    for (uint j = 0u; j < TN; j++) {
        uint lr = localRowBase + ty + 16u * j;
        if (lr >= expertRows) continue;
        uint packedRow = expertStart + lr;
        for (uint i = 0u; i < TM; i++) {
            uint m = mBase + tx + 16u * i;
            if (m < pc.M)
                y[packedRow * pc.M + m] = acc[i][j];
        }
    }
}
