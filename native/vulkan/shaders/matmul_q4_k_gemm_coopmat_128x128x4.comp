#version 450
// Q4_K batched GEMM on the shared 128x128 blocked coopmat template (issue #570).
//
//   C[N, M] = B[N, K] @ W_q4k[M, K]^T,  W dequantised on the fly.
//
// Weight layout (matches matmul_q4_k_gemm_f32.comp): rows of (K / 256) super-blocks of 144 bytes --
// fp16 d [0..1], fp16 dmin [2..3], scales[12] [4..15] (8 x 6-bit scale + 8 x 6-bit min), qs[128]
// [16..143] (256 4-bit codes). Sub-block s (0..7) of 32 elements: codes are the low (s even) or high
// (s odd) nibbles of the 32 bytes qs[(s/2)*32 .. +31], value = d*scale[s]*code - dmin*min[s].
// A BK=32 K-chunk is exactly one sub-block, so a "chunk" here is (super-block ch/8, sub-block ch%8)
// and there are blocksPerRow*8 chunks per row. With two lanes per weight row, lane l stages columns
// l*16 .. l*16+15 of that sub-block.
//
// PRECISION: as for Q8_0/Q5_0, d*scale*code - dmin*min is folded into the F16 A operand (~2^-11).

#define BM  128
#define BN  128
#define WM  64
#define WN  64
#define NSG 4
#define WAVE 64

#extension GL_GOOGLE_include_directive : require

layout(set = 0, binding = 0, std430) readonly  buffer BufW { uint  weight[]; }; // Q4_K blob
layout(set = 0, binding = 1, std430) readonly  buffer BufB { float b[]; };      // [N*K]
layout(set = 0, binding = 2, std430) writeonly buffer BufC { float c[]; };      // [N*M]

layout(push_constant) uniform PushConstants {
    uint M;             // output dim (number of weight rows)
    uint K;             // contraction dim (must be a multiple of 256)
    uint N;             // batch size (number of input rows)
    uint blocksPerRow;  // = K / 256 (super-blocks)
    uint rowUints;      // per-row uint stride
} pc;

#include "gemm_coopmat_blocked_decl.glsl"

const uint BLOCK_BYTES = 144u;  // Q4_K super-block

const uint A_LANES_PER_ROW = BLOCK_SIZE / BM;        // 2 threads cooperate on one weight row
const uint A_COLS_PER_THR  = BK / A_LANES_PER_ROW;   // 16 codes per thread

uint readByte(uint absByteOff) {
    return (weight[absByteOff >> 2u] >> ((absByteOff & 3u) * 8u)) & 0xFFu;
}

float readHalf(uint absByteOff) {
    return unpackHalf2x16(readByte(absByteOff) | (readByte(absByteOff + 1u) << 8)).x;
}

// (scale, min) pair j (0..7) from the 12-byte scales region; mirrors llama.cpp get_scale_min_k4.
uvec2 unpackScaleMin(uint base, uint j) {
    if (j < 4u)
        return uvec2(readByte(base + j) & 63u, readByte(base + j + 4u) & 63u);
    uint sc = (readByte(base + j + 4u) & 0xFu) | (((readByte(base + j - 4u) >> 6u) & 0x3u) << 4u);
    uint mn = ((readByte(base + j + 4u) >> 4u) & 0xFu) | (((readByte(base + j) >> 6u) & 0x3u) << 4u);
    return uvec2(sc, mn);
}

void gemmStageA(uint ch) {
    uint rowLocal  = g_tid / A_LANES_PER_ROW;
    uint laneOfRow = g_tid % A_LANES_PER_ROW;
    uint mGlobal   = g_mBase + rowLocal;
    uint sBase     = rowLocal * STRIDE;
    uint col0      = laneOfRow * A_COLS_PER_THR;

    uint kBlock = ch >> 3u;
    uint subIdx = ch & 7u;
    bool rowValid = mGlobal < pc.M;
    float sc = 0.0, mn = 0.0;
    uint qsBase = 0u;
    if (rowValid) {
        uint blockBase = mGlobal * (pc.blocksPerRow * BLOCK_BYTES) + kBlock * BLOCK_BYTES;
        float d    = readHalf(blockBase);
        float dmin = readHalf(blockBase + 2u);
        uvec2 sm = unpackScaleMin(blockBase + 4u, subIdx);
        sc = d * float(sm.x);
        mn = dmin * float(sm.y);
        qsBase = blockBase + 16u + (subIdx >> 1u) * 32u;
    }

    uint shiftN = (subIdx & 1u) * 4u;
    for (uint j = 0u; j < A_COLS_PER_THR; j++) {
        uint col = col0 + j;
        float w = 0.0;
        if (rowValid)
            w = sc * float((readByte(qsBase + col) >> shiftN) & 0xFu) - mn;
        sharedA[sBase + col] = float16_t(w);
    }
}

#define GEMM_M          pc.M
#define GEMM_K          pc.K
#define GEMM_CHUNKS     (pc.blocksPerRow * 8u)
#define GEMM_ROW_BASE   0u
#define GEMM_ROW_LIMIT  pc.N
#define GEMM_B_BUF      b
#define GEMM_C_BUF      c

#include "gemm_coopmat_blocked_main.glsl"
