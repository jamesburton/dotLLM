#version 450
// NVFP4 batched matrix multiplication (prefill-path GEMM, #1038).
//
//   C[N, M] = scale * (B[N, K] @ W_nvfp4[M, K]^T)
//
// Companion to matmul_nvfp4_f32_gemv.comp (same layout, nvfp4_decode.glsl). 16x16 output tile per
// workgroup, one thread per cell; each K-chunk is one 64-element NVFP4 block, dequantized into shared
// memory once and reused by the 16 token rows.

#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufW { uint  weight[]; };
layout(set = 0, binding = 1, std430) readonly  buffer BufB { float b[]; };
layout(set = 0, binding = 2, std430) writeonly buffer BufC { float c[]; };

layout(push_constant) uniform PushConstants {
    uint  M;
    uint  K;             // multiple of 64
    uint  N;
    uint  blocksPerRow;  // K / 64
    float scale;         // per-tensor X.scale
} pc;

#include "nvfp4_decode.glsl"

const uint TILE_M = 16u;
const uint TILE_N = 16u;
const uint CHUNK  = 64u;

shared float sharedB[TILE_N * CHUNK];
shared float sharedW[TILE_M * CHUNK];

void main() {
    uint m = gl_WorkGroupID.x * TILE_M + gl_LocalInvocationID.x;
    uint t = gl_WorkGroupID.y * TILE_N + gl_LocalInvocationID.y;
    uint tid = gl_LocalInvocationID.y * TILE_M + gl_LocalInvocationID.x;
    uint mBase = gl_WorkGroupID.x * TILE_M;
    uint tBase = gl_WorkGroupID.y * TILE_N;

    float acc = 0.0;
    for (uint chunk = 0u; chunk < pc.blocksPerRow; chunk++) {
        uint kBase = chunk * CHUNK;

        // 1. Stage B[16, 64]: 256 threads x 4 floats.
        for (uint r = 0u; r < 4u; r++) {
            uint idx = tid * 4u + r;
            uint row = idx >> 6u;
            uint col = idx & 63u;
            uint tg = tBase + row;
            sharedB[idx] = tg < pc.N ? b[tg * pc.K + kBase + col] : 0.0;
        }

        // 2. Dequantize W[16, 64]: 16 threads per row, lane handles qs bytes 2*lane, 2*lane+1.
        {
            uint mLocal = tid >> 4u;
            uint lane = tid & 15u;
            uint mg = mBase + mLocal;
            uint sBase = mLocal * CHUNK;
            for (uint k2 = 0u; k2 < 2u; k2++) {
                uint qb = 2u * lane + k2;          // qs byte 0..31
                uint s = qb >> 3u;                 // sub-block
                uint j = qb & 7u;                  // byte within sub-block
                float lo = 0.0, hi = 0.0;
                if (mg < pc.M) {
                    uint wb = (mg * pc.blocksPerRow + chunk) * NVFP4_BLOCK_UINTS;
                    float d = ue4m3_half((weight[wb] >> (8u * s)) & 0xFFu);
                    uint byteVal = (weight[wb + 1u + (qb >> 2u)] >> (8u * (qb & 3u))) & 0xFFu;
                    lo = d * KVALUES_FP4[byteVal & 0xFu];
                    hi = d * KVALUES_FP4[byteVal >> 4u];
                }
                sharedW[sBase + 16u * s + j] = lo;
                sharedW[sBase + 16u * s + 8u + j] = hi;
            }
        }

        barrier();

        uint bOff = gl_LocalInvocationID.y * CHUNK;
        uint wOff = gl_LocalInvocationID.x * CHUNK;
        float chunkSum = 0.0;
        for (uint j = 0u; j < CHUNK; j++)
            chunkSum += sharedB[bOff + j] * sharedW[wOff + j];
        acc += chunkSum;

        barrier();
    }

    if (m < pc.M && t < pc.N)
        c[t * pc.M + m] = acc * pc.scale;
}
