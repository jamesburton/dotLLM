#version 450
// Q6_K batched GEMM on the shared 128x128 blocked coopmat template (issue #578).
//
//   C[N, M] = B[N, K] @ W_q6k[M, K]^T,  W dequantised on the fly.
//
// Weight layout (matches matmul_q6_k_gemm_f32.comp): rows of (K / 256) super-blocks of 210 bytes --
// ql[128] [0..127], qh[64] [128..191], scales[16] int8 [192..207], fp16 d [208..209]. 210 is 2 (mod 4)
// so every field is read at an arbitrary byte offset.
// A BK=32 K-chunk is one (half hf, group g) pair of a super-block: chunk ch -> super-block ch/8,
// sub = ch%8, hf = sub/4, g = sub%4, covering elements 128*hf + 32*g + l, l = 0..31:
//   nibble  = (g < 2) ? ql[64hf + 32*(g&1) + l] & 0xF : ql[64hf + 32*(g&1) + l] >> 4
//   high2   = (qh[32hf + l] >> (2g)) & 3
//   value   = d * scales[8hf + l/16 + 2g] * (nibble | high2 << 4) - 32)
// With two lanes per weight row, lane 0 stages l = 0..15 and lane 1 l = 16..31, so each lane needs
// exactly one scale.
//
// PRECISION: as for the other blocked kernels, d*scale*(q-32) is folded into the F16 A operand.

#define BM  128
#define BN  128
#define WM  64
#define WN  64
#define NSG 4
#define WAVE 64

#extension GL_GOOGLE_include_directive : require

layout(set = 0, binding = 0, std430) readonly  buffer BufW { uint  weight[]; }; // Q6_K blob
layout(set = 0, binding = 1, std430) readonly  buffer BufB { vec4 b4[]; };      // [N*K]
layout(set = 0, binding = 2, std430) writeonly buffer BufC { float c[]; };      // [N*M]

layout(push_constant) uniform PushConstants {
    uint M;             // output dim (number of weight rows)
    uint K;             // contraction dim (must be a multiple of 256)
    uint N;             // batch size (number of input rows)
    uint blocksPerRow;  // = K / 256 (super-blocks)
    uint rowUints;      // per-row uint stride
} pc;

#include "gemm_coopmat_blocked_decl.glsl"

const uint Q6K_BLOCK_BYTES = 210u;  // Q6_K super-block

const uint A_LANES_PER_ROW = BLOCK_SIZE / BM;        // 2 threads cooperate on one weight row
const uint A_COLS_PER_THR  = BK / A_LANES_PER_ROW;   // 16 codes per thread

uint readByte(uint absByteOff) {
    return (weight[absByteOff >> 2u] >> ((absByteOff & 3u) * 8u)) & 0xFFu;
}

float readHalf(uint absByteOff) {
    return unpackHalf2x16(readByte(absByteOff) | (readByte(absByteOff + 1u) << 8)).x;
}

// 16 bytes at EVEN byte offset `o` as four aligned words (funnel shift; the 5th word is loaded only
// when the span is 2 bytes into a word, so nothing past the span -- and never past the blob -- is read).
void load16(uint o, out uint r[4]) {
    uint wi = o >> 2u;
    bool hi = (o & 2u) != 0u;
    uint w[5];
    [[unroll]] for (uint i = 0u; i < 4u; i++) w[i] = weight[wi + i];
    w[4] = hi ? weight[wi + 4u] : 0u;
    [[unroll]] for (uint i = 0u; i < 4u; i++) r[i] = hi ? ((w[i] >> 16) | (w[i + 1u] << 16)) : w[i];
}

// A-staging (#582): ql and qh spans are 16 bytes each, read as words instead of 32 byte loads.
void gemmStageA(uint ch) {
    uint rowLocal  = g_tid / A_LANES_PER_ROW;
    uint laneOfRow = g_tid % A_LANES_PER_ROW;
    uint mGlobal   = g_mBase + rowLocal;
    uint sBase     = rowLocal * STRIDE + laneOfRow * A_COLS_PER_THR;

    if (mGlobal >= pc.M) {
        for (uint j = 0u; j < A_COLS_PER_THR; j++) sharedA[sBase + j] = float16_t(0.0);
        return;
    }

    uint kBlock = ch >> 3u;
    uint sub    = ch & 7u;
    uint hf     = sub >> 2u;
    uint g      = sub & 3u;

    uint blockBase = mGlobal * (pc.blocksPerRow * Q6K_BLOCK_BYTES) + kBlock * Q6K_BLOCK_BYTES;
    float d = readHalf(blockBase + 208u);
    uint sb = readByte(blockBase + 192u + 8u * hf + laneOfRow + 2u * g);
    float scale = d * float(int(sb ^ 0x80u) - 128);

    uint qlw[4], qhw[4];
    load16(blockBase + 64u * hf + 32u * (g & 1u) + laneOfRow * A_COLS_PER_THR, qlw);
    load16(blockBase + 128u + 32u * hf + laneOfRow * A_COLS_PER_THR, qhw);

    uint nibShift = (g >> 1u) * 4u;
    uint qhShift  = 2u * g;
    [[unroll]] for (uint i = 0u; i < 4u; i++) {
        uint lw = qlw[i] >> nibShift;
        uint hw = qhw[i] >> qhShift;
        [[unroll]] for (uint jb = 0u; jb < 4u; jb++) {
            uint lo = (lw >> (jb * 8u)) & 0xFu;
            uint h2 = (hw >> (jb * 8u)) & 3u;
            sharedA[sBase + i * 4u + jb] = float16_t(scale * float(int(lo | (h2 << 4u)) - 32));
        }
    }
}

#define GEMM_M          pc.M
#define GEMM_K          pc.K
#define GEMM_CHUNKS     (pc.blocksPerRow * 8u)
#define GEMM_ROW_BASE   0u
#define GEMM_ROW_LIMIT  pc.N
#define GEMM_B_BUF      b4
#define GEMM_B_VEC4
#define GEMM_C_BUF      c

#include "gemm_coopmat_blocked_main.glsl"
