#version 450
// Upstream ggml Q2_0 batched GEMM on the shared 128x128 blocked coopmat template (issue #2074; derived from matmul_q4_0_f32_gemm_coopmat_128x128x4.comp).
//
//   C[N, M] = B[N, K] @ W_q2_0[M, K]^T,  W dequantised on the fly, never widened.
//
// Weight layout: 18-byte blocks of 64 elements -- fp16 scale `d` at [0..1], qs[16] at [2..17], four 2-bit codes per byte (element j in bits
// 2*(j%4) of qs[j/4]); value = d * (code - 1), codes 0..3 = -d, 0, +d, +2d. The template's BK = 32 chunk is HALF a block: chunk ch is block ch/2,
// half ch%2. Two lanes per weight row: lane l stages elements 16*l..16*l+15 of the half = qs bytes 8*half + 4*l .. +3 = ONE (unaligned) word.
//
// PRECISION: the scale is folded into the F16 A operand (d*(code-1), |code-1| <= 2), ~2^-11 relative error -- inherent to F16 operands.

#define BM  128
#define BN  128
#define WM  64
#define WN  64
#define NSG 4
#define WAVE 64

#extension GL_GOOGLE_include_directive : require

layout(set = 0, binding = 0, std430) readonly  buffer BufW { uint  weight[]; }; // Q2_0 blob
layout(set = 0, binding = 1, std430) readonly  buffer BufB { vec4 b4[]; };      // [N*K]
layout(set = 0, binding = 2, std430) writeonly buffer BufC { float c[]; };      // [N*M]

layout(push_constant) uniform PushConstants {
    uint M;             // output dim (number of weight rows)
    uint K;             // contraction dim (must be a multiple of 64)
    uint N;             // batch size (number of input rows)
    uint blocksPerRow;  // = K / 64
    uint rowUints;      // per-row uint stride
} pc;

#include "gemm_coopmat_blocked_decl.glsl"

const uint BLOCK_BYTES = 18u;   // 2 (fp16 scale) + 16 (qs)

const uint A_LANES_PER_ROW = BLOCK_SIZE / BM;        // 2 threads cooperate on one weight row
const uint A_COLS_PER_THR  = BK / A_LANES_PER_ROW;   // 16 codes per thread

void gemmStageA(uint ch) {
    uint rowLocal  = g_tid / A_LANES_PER_ROW;
    uint laneOfRow = g_tid % A_LANES_PER_ROW;
    uint mGlobal   = g_mBase + rowLocal;
    uint sBase     = rowLocal * STRIDE + laneOfRow * A_COLS_PER_THR;

    if (mGlobal >= pc.M) {
        for (uint j = 0u; j < A_COLS_PER_THR; j++) sharedA[sBase + j] = float16_t(0.0);
        return;
    }

    uint blockBase = mGlobal * (pc.blocksPerRow * BLOCK_BYTES) + (ch >> 1u) * BLOCK_BYTES;   // 2-byte aligned
    uint wd = weight[blockBase >> 2u];
    float d = unpackHalf2x16((blockBase & 2u) != 0u ? (wd >> 16) : (wd & 0xFFFFu)).x;

    uint qsAbs = blockBase + 2u + (ch & 1u) * 8u + laneOfRow * 4u;   // 2-byte aligned: phase is 0 or 2
    uint wi = qsAbs >> 2u;
    uint lo = weight[wi];
    uint word = ((qsAbs & 2u) != 0u) ? ((lo >> 16) | (weight[wi + 1u] << 16)) : lo;

    [[unroll]] for (uint j = 0u; j < 16u; j++)
        sharedA[sBase + j] = float16_t(d * float(int((word >> (2u * j)) & 3u) - 1));
}

#define GEMM_M          pc.M
#define GEMM_K          pc.K
#define GEMM_CHUNKS     (pc.blocksPerRow * 2u)
#define GEMM_ROW_BASE   0u
#define GEMM_ROW_LIMIT  pc.N
#define GEMM_B_BUF      b4
#define GEMM_B_VEC4
#define GEMM_C_BUF      c

#include "gemm_coopmat_blocked_main.glsl"
