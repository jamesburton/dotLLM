#version 450
// I2_S (BitNet b1.58 ternary) batched matrix multiplication (prefill-path GEMM).
//
//   C[N, M] = B[N, K] @ W_i2s[M, K]^T      with W_i2s dequantized on the fly.
//
// Companion to matmul_i2_s_f32_gemv.comp. Same byte layout: each 128 contiguous
// elements of a weight row form one 32-byte block — byte gp (0..31) packs 4
// ternary codes (2 bits each) for elements {gp, gp+32, gp+64, gp+96} at bit
// offsets {6, 4, 2, 0}; value = code - 1. Row stride = K/4 bytes. ONE per-tensor
// float32 scale for the whole matrix sits at byte offset M*(K/4) (the buffer tail).
//
// Tiling:
//   Output tile  = 16 rows of C (TILE_N) x 16 cols of C (TILE_M) = 256 cells.
//   Workgroup    = (16, 16, 1) = 256 threads, one thread per output cell.
//   K-chunk      = 128 elements (one full I2_S block).
//
// Per K-chunk we stage a 16x128 B tile and dequantise a 16x128 weight tile into
// shared memory once, then reuse both across the 16x16 cells.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufW { uint  weight[]; };
layout(set = 0, binding = 1, std430) readonly  buffer BufB { float b[]; };
layout(set = 0, binding = 2, std430) writeonly buffer BufC { float c[]; };

layout(push_constant) uniform PushConstants {
    uint M;
    uint K;             // multiple of 128
    uint N;
    uint blocksPerRow;  // = K / 128
    uint rowUints;      // unused here; kept for push-constant layout parity
} pc;

const uint TILE_M = 16u;
const uint TILE_N = 16u;
const uint I2S_BLOCK = 128u;          // K-chunk = one I2_S block
const uint I2S_BLOCK_BYTES = 32u;

shared float sharedB[TILE_N * I2S_BLOCK];   // 16 x 128 token tile
shared float sharedW[TILE_M * I2S_BLOCK];   // 16 x 128 dequantised weight tile

uint readByte(uint absByteOff) {
    uint u = weight[absByteOff >> 2u];
    uint shift = (absByteOff & 3u) * 8u;
    return (u >> shift) & 0xFFu;
}

void main() {
    uint m = gl_WorkGroupID.x * TILE_M + gl_LocalInvocationID.x;   // output row (weight row)
    uint t = gl_WorkGroupID.y * TILE_N + gl_LocalInvocationID.y;   // token row
    uint tid = gl_LocalInvocationID.y * TILE_M + gl_LocalInvocationID.x;

    uint mBase = gl_WorkGroupID.x * TILE_M;
    uint tBase = gl_WorkGroupID.y * TILE_N;

    uint rowBytes = pc.K >> 2u;        // K/4 packed bytes per row (= blocksPerRow * 32)

    // Per-tensor float32 scale at the weight-buffer tail (byte offset M*(K/4)),
    // word-aligned because K is a multiple of 128.
    uint scaleByteOff = pc.M * rowBytes;
    float scale = uintBitsToFloat(weight[scaleByteOff >> 2u]);

    float acc = 0.0;

    for (uint blk = 0u; blk < pc.blocksPerRow; blk++) {
        uint kBase = blk * I2S_BLOCK;

        // ── 1. Stage sharedB[TILE_N, 128] (16x128 floats). 256 threads load 8 each. ──
        for (uint i = 0u; i < 8u; i++) {
            uint bIdx = tid * 8u + i;          // 0..2047
            uint row  = bIdx >> 7u;            // 0..15  (token within tile)
            uint col  = bIdx & 127u;           // 0..127 (element within block)
            uint tGlobal = tBase + row;
            sharedB[bIdx] = (tGlobal < pc.N) ? b[tGlobal * pc.K + kBase + col] : 0.0;
        }

        // ── 2. Dequantise sharedW[TILE_M, 128]. 16 rows x 32 bytes = 512 bytes; ──
        //       256 threads decode 2 bytes each (4 ternary codes per byte).
        for (uint i = 0u; i < 2u; i++) {
            uint byteFlat = tid * 2u + i;      // 0..511
            uint rowLocal = byteFlat >> 5u;    // 0..15  (weight row within tile)
            uint gp       = byteFlat & 31u;    // 0..31  (byte within block)
            uint mGlobal  = mBase + rowLocal;
            uint sBase    = rowLocal * I2S_BLOCK;

            if (mGlobal < pc.M) {
                uint pk = readByte(mGlobal * rowBytes + blk * I2S_BLOCK_BYTES + gp);
                sharedW[sBase + gp]        = float(int((pk >> 6u) & 3u) - 1);
                sharedW[sBase + gp + 32u]  = float(int((pk >> 4u) & 3u) - 1);
                sharedW[sBase + gp + 64u]  = float(int((pk >> 2u) & 3u) - 1);
                sharedW[sBase + gp + 96u]  = float(int( pk        & 3u) - 1);
            } else {
                sharedW[sBase + gp]        = 0.0;
                sharedW[sBase + gp + 32u]  = 0.0;
                sharedW[sBase + gp + 64u]  = 0.0;
                sharedW[sBase + gp + 96u]  = 0.0;
            }
        }

        barrier();

        // ── 3. Partial dot product for this K-chunk. ──
        uint bOff = gl_LocalInvocationID.y * I2S_BLOCK;
        uint wOff = gl_LocalInvocationID.x * I2S_BLOCK;
        float chunkSum = 0.0;
        for (uint j = 0u; j < I2S_BLOCK; j++) {
            chunkSum += sharedB[bOff + j] * sharedW[wOff + j];
        }
        acc += chunkSum;

        barrier();
    }

    if (m < pc.M && t < pc.N) {
        c[t * pc.M + m] = acc * scale;
    }
}
