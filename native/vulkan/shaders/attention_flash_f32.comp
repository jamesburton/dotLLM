#version 450
#extension GL_KHR_shader_subgroup_basic      : require
#extension GL_KHR_shader_subgroup_arithmetic : require

// Flash-Attention-v2 style tiled attention over GQA. Each workgroup processes
// one (query-head, query-tile of BR rows) pair. The KV stream is consumed in
// BC-sized chunks. Compared to attention_f32.comp (one workgroup per (token,
// head)) the per-(KV row, head) read count drops by BR×: each KV row is read
// by exactly one workgroup, but its dot-product contribution feeds BR Q-rows
// instead of just one.
//
// Strix Halo / RDNA3.5 sizing rationale:
//   - 64-wide wavefronts, 64 KB LDS / WG cap.
//   - WG_SIZE = BC = 64 → BC tile fits in one wavefront on RDNA3.5; reductions
//     fall through to subgroupMax / subgroupAdd in a single step. On
//     subgroup widths < BC (NVIDIA 32-wide, Intel 8/16-wide) the per-row
//     reduction falls back to a one-time cross-subgroup combine through
//     shared memory (partialMax[0..gl_NumSubgroups)).
//   - BR = 16 query rows × MAX_HEAD_DIM = 128 → qTile 8 KB, outAccum 8 KB,
//     scoreMatrix BR*BC = 4 KB — well under the 64 KB LDS budget.
//
// Decode (seq_q = 1) keeps the legacy AttentionF32Kernel naive per-row tile —
// the FA path is wired only when seqQ > 1.
//
// Dispatch:
//   local_size_x  = WG_SIZE (= BC)
//   workgroups.x  = ceil(seq_q / BR) * num_heads
//
// Causal mask: masked when (positionOffset + qRow) < (tStart + c).
// Sliding window: when slidingWindow > 0, masks columns earlier than
// positionOffset + qRow - slidingWindow + 1.
// Attention soft-cap (Gemma 2 / Qwen3 style): when softCap > 0, raw scores
// pass through softCap * tanh(s / softCap) before softmax.
// Custom attention scale (Gemma 3 query_pre_attn_scalar): when scale > 0,
// raw scores are multiplied by scale instead of the default 1/sqrt(head_dim).
// Pass 0.0 to disable (default = 1/sqrt(head_dim)).

#define BR              16
#define BC              64
// issue #139: 256 threads = 4 RDNA3.5 wave64s per workgroup. The previous
// WG_SIZE == BC (= 64, one wave) left most SIMDs idle: each workgroup holds
// ~20 KB of LDS, so only 2-3 workgroups fit a WGP, and one wave each gave the
// scheduler almost nothing to hide latency with. QK^T splits the BR rows
// across the 4 waves (each wave owns 4 rows × its BC column); the PV
// accumulation flattens (row, dim) pairs across all 256 threads.
#define WG_SIZE         256
#define ROWS_PER_SLICE  (BR / (WG_SIZE / BC))   // Q-rows per wave slice = 4
#define MAX_HEAD_DIM    128
#define NEG_INF         (-3.4e38)

layout(local_size_x = WG_SIZE, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufQ   { float q[]; };    // [seq_q,  num_heads    * head_dim]
layout(set = 0, binding = 1, std430) readonly  buffer BufK   { float k[]; };    // [seq_kv, num_kv_heads * head_dim]
layout(set = 0, binding = 2, std430) readonly  buffer BufV   { float v[]; };    // [seq_kv, num_kv_heads * head_dim]
layout(set = 0, binding = 3, std430) writeonly buffer BufOut { float outp[]; }; // [seq_q,  num_heads    * head_dim]

layout(push_constant) uniform PushConstants {
    uint  seqQ;
    uint  seqKv;
    uint  numHeads;
    uint  numKvHeads;
    uint  headDim;
    uint  positionOffset;
    uint  slidingWindow;   // 0 = disabled
    uint  useAlibi;        // 0 = disabled, 1 = standard fixed ALiBi slopes
    float softCap;         // 0.0 = disabled, >0 = tanh-capped scores
    float scaleOverride;   // 0.0 = use 1/sqrt(headDim), >0 = use this scale (Gemma 3 QPAS)
    uint  maskMode;        // 0 = Causal, 1 = Bidirectional, 2 = Hybrid (diffusion canvas)
    uint  prefixLen;       // Hybrid only: positions < prefixLen stay causal, >= are bidirectional
} pc;

// Causal-component mask for the (key, query) pair under the selected mode.
// Sliding-window masking composes with this exactly as in the CPU reference
// (DotLLM.Cpu.Kernels.Attention.ApplyMask):
//   Causal        -> tkv > posQ
//   Bidirectional -> false (no causal upper bound)
//   Hybrid        -> (posQ < prefixLen) ? (tkv > posQ) : false
// maskMode==0 with prefixLen==0 reproduces the original hardcoded check byte-for-byte.
bool isMasked(uint tkv, uint posQ, uint maskMode, uint prefixLen) {
    if (maskMode == 1u) return false;
    if (maskMode == 2u && posQ >= prefixLen) return false;
    return tkv > posQ;
}

// scoreMatrix rows are padded by one column (BC + 1 stride) so the row-owner
// softmax pass (issue #139) — where thread r scans its row serially — hits a
// different LDS bank per thread instead of a BR-way conflict on every column.
#define BC_PAD (BC + 1)

shared float qTile[BR * MAX_HEAD_DIM];
shared float scoreMatrix[BR * BC_PAD];
shared float outAccum[BR * MAX_HEAD_DIM];
shared float runningMax[BR];
shared float runningSum[BR];
// Per-row online-softmax rescale factor for this KV tile, published by the
// row-owner thread and applied to outAccum by the whole workgroup.
shared float corrShared[BR];

uint previousPowerOfTwo(uint value) {
    uint power = 1u;
    while ((power << 1u) <= value) {
        power <<= 1u;
    }
    return power;
}

float alibiSlopePowerOfTwo(uint head, uint numHeads) {
    float start = exp2(-exp2(-(log2(float(numHeads)) - 3.0)));
    return pow(start, float(head + 1u));
}

float alibiSlope(uint head, uint numHeads) {
    uint power = previousPowerOfTwo(numHeads);
    if (power == numHeads || head < power) {
        return alibiSlopePowerOfTwo(head, power);
    }
    uint expanded = power << 1u;
    uint extraHead = (head - power) << 1u;
    return alibiSlopePowerOfTwo(extraHead, expanded);
}

void main() {
    uint blockId = gl_WorkGroupID.x;
    uint qTilesPerHead = (pc.seqQ + uint(BR) - 1u) / uint(BR);
    uint totalBlocks = qTilesPerHead * pc.numHeads;
    if (blockId >= totalBlocks) return;

    uint qTileIdx = blockId / pc.numHeads;
    uint hq       = blockId - qTileIdx * pc.numHeads;
    uint qStartRow = qTileIdx * uint(BR);

    uint groupSize = pc.numHeads / pc.numKvHeads;
    uint hkv = hq / groupSize;

    uint tid = gl_LocalInvocationID.x;
    uint qStride  = pc.numHeads   * pc.headDim;
    uint kvStride = pc.numKvHeads * pc.headDim;

    float scale = (pc.scaleOverride > 0.0) ? pc.scaleOverride : inversesqrt(float(pc.headDim));
    float slope = (pc.useAlibi != 0u) ? alibiSlope(hq, pc.numHeads) : 0.0;

    uint rowsInTile = min(uint(BR), pc.seqQ - qStartRow);

    // 1. Load Q-tile and zero output accumulator + running state.
    uint qLoadTotal = rowsInTile * pc.headDim;
    for (uint idx = tid; idx < qLoadTotal; idx += uint(WG_SIZE)) {
        uint r = idx / pc.headDim;
        uint d = idx - r * pc.headDim;
        qTile[r * pc.headDim + d] = q[(qStartRow + r) * qStride + hq * pc.headDim + d];
    }
    uint outZeroTotal = uint(BR) * pc.headDim;
    for (uint idx = tid; idx < outZeroTotal; idx += uint(WG_SIZE)) {
        outAccum[idx] = 0.0;
    }
    if (tid < uint(BR)) {
        runningMax[tid] = NEG_INF;
        runningSum[tid] = 0.0;
    }
    barrier();

    // 2. Walk KV in BC-sized tiles. Thread tid owns column tid of the
    //    active BC tile and computes BR dot products against the resident
    //    Q-rows. Each KV row is therefore read once per Q-tile — BR× the
    //    amortisation vs the per-token shader.
    // Causal early-exit (issue #139): under a pure causal mask no KV column
    // beyond the last Q-row's position can contribute — every score in such a
    // tile is NEG_INF and its exp() weight 0. Clamping the KV walk saves ~half
    // the QK^T + PV work for a square prefill. Bidirectional/Hybrid masks keep
    // the full range (their tail rows attend forward).
    uint kvEnd = pc.seqKv;
    if (pc.maskMode == 0u) {
        uint lastPosQ = pc.positionOffset + qStartRow + rowsInTile - 1u;
        kvEnd = min(pc.seqKv, lastPosQ + 1u);
    }

    for (uint tStart = 0u; tStart < kvEnd; tStart += uint(BC)) {
        uint tileLen = min(uint(BC), kvEnd - tStart);
        // 2a. QK^T. Each of the 4 wave slices owns ROWS_PER_SLICE (= 4) Q-rows;
        // within a slice, lane c (0..BC-1) owns KV column c. Each thread
        // computes 4 dot products against the LDS-resident Q-rows; K rows are
        // read directly from global (L0/L1-cached: a 64 B line serves 16
        // consecutive d iterations, and the row is shared by 4 slices).
        uint c     = tid & (uint(BC) - 1u);   // 0..63 KV column
        uint slice = tid >> 6u;               // 0..3 wave slice
        uint rBase = slice * uint(ROWS_PER_SLICE);
        bool cValid = (c < tileLen);
        uint tkv = tStart + c;
        uint kBase = tkv * kvStride + hkv * pc.headDim;

        for (uint rr = 0u; rr < uint(ROWS_PER_SLICE); rr++) {
            uint r = rBase + rr;
            if (r >= rowsInTile) break;
            float s;
            if (!cValid) {
                s = NEG_INF;
            } else {
                uint posQ = pc.positionOffset + qStartRow + r;
                bool masked =
                    isMasked(tkv, posQ, pc.maskMode, pc.prefixLen) ||
                    (pc.slidingWindow > 0u && posQ >= tkv && (posQ - tkv) >= pc.slidingWindow);
                if (masked) {
                    s = NEG_INF;
                } else {
                    float dot = 0.0;
                    for (uint d = 0u; d < pc.headDim; d++) {
                        dot += qTile[r * pc.headDim + d] * k[kBase + d];
                    }
                    s = dot * scale - slope * float(posQ - tkv);
                    if (pc.softCap > 0.0) {
                        s = pc.softCap * tanh(s / pc.softCap);
                    }
                }
            }
            scoreMatrix[r * uint(BC_PAD) + c] = s;
        }
        barrier();

        // 2b. Per-row max + online-softmax rescale + exponentiate (issue #139).
        // One thread owns one Q-row and scans its BC scores serially — BR rows
        // run in parallel with NO intra-row reduction, replacing the previous
        // per-row workgroup-wide subgroup reductions (≈8 barriers × BR rows per
        // KV tile) with a single barrier pair per tile. The padded score-row
        // stride keeps the BR concurrent serial scans bank-conflict-free.
        if (tid < rowsInTile) {
            uint r = tid;
            uint rowBase = r * uint(BC_PAD);
            float oldMax = runningMax[r];
            float newMax = oldMax;
            for (uint c2 = 0u; c2 < tileLen; c2++) {
                newMax = max(newMax, scoreMatrix[rowBase + c2]);
            }
            float correction = (oldMax > NEG_INF * 0.5) ? exp(oldMax - newMax) : 0.0;
            float tileSum = 0.0;
            for (uint c2 = 0u; c2 < tileLen; c2++) {
                float val = scoreMatrix[rowBase + c2];
                float w = (val > NEG_INF * 0.5) ? exp(val - newMax) : 0.0;
                scoreMatrix[rowBase + c2] = w;
                tileSum += w;
            }
            runningSum[r] = runningSum[r] * correction + tileSum;
            runningMax[r] = newMax;
            corrShared[r] = correction;
        }
        barrier();

        // Rescale the output accumulator by each row's correction factor —
        // parallelised across the whole workgroup (was per-row, serialized).
        for (uint idx = tid; idx < rowsInTile * pc.headDim; idx += uint(WG_SIZE)) {
            uint r = idx / pc.headDim;
            outAccum[idx] *= corrShared[r];
        }
        barrier();

        // 2c. Accumulate weighted V into outAccum. (row, dim) pairs are
        //     flattened across the whole workgroup so all 256 threads stay
        //     busy (BR × headDim = 2048 cells / 256 threads = 8 each); V
        //     reads stay coalesced across the dim axis and each V line is
        //     L0/L1-shared by the row-threads.
        for (uint idx = tid; idx < rowsInTile * pc.headDim; idx += uint(WG_SIZE)) {
            uint r = idx / pc.headDim;
            uint d = idx - r * pc.headDim;
            float acc = 0.0;
            for (uint c2 = 0u; c2 < tileLen; c2++) {
                float w = scoreMatrix[r * uint(BC_PAD) + c2];
                if (w > 0.0) {
                    uint vOff = (tStart + c2) * kvStride + hkv * pc.headDim + d;
                    acc += w * v[vOff];
                }
            }
            outAccum[r * pc.headDim + d] += acc;
        }
        barrier();
    }

    // 3. Normalize and write.
    for (uint r = 0u; r < rowsInTile; r++) {
        float sum = runningSum[r];
        float inv = (sum > 1e-10) ? (1.0 / sum) : 0.0;
        uint outBase = (qStartRow + r) * qStride + hq * pc.headDim;
        for (uint d = tid; d < pc.headDim; d += uint(WG_SIZE)) {
            outp[outBase + d] = outAccum[r * pc.headDim + d] * inv;
        }
    }
}
