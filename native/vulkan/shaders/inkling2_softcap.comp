#version 450
// Inkling 2 final logit softcap (issue #2034): logits[i] = cap * tanh(logits[i] / cap), in place on the F32 logits the LM-head GEMV wrote (the logits are the
// one F32 buffer: they leave the device as F32, like every dotLLM backend).
#extension GL_EXT_control_flow_attributes : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer BufL { float logits[]; };

layout(push_constant) uniform PushConstants {
    uint n;
    float cap;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    logits[i] = tanh(clamp(logits[i] * (1.0 / pc.cap), -20.0, 20.0)) * pc.cap;
}
