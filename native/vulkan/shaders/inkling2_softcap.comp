#version 450
// Inkling 2 final logit softcap (issue #2034): logits[i] = cap * tanh(logits[i] / cap), in place on the F32 logits the LM-head GEMV wrote (the logits are the
// one F32 buffer: they leave the device as F32, like every dotLLM backend).
// A non-finite logit is passed through unchanged (#2075): clamp() of a NaN is undefined (AMD's min/max return the non-NaN operand) and clamp(+-inf) is +-20, so
// without the pass-through a NaN or infinity became a finite +-cap and the host's non-finite guard of the F16 activation default could never see an overflow.
// The test is on the exponent bits, so the compiler cannot fold it away under a no-NaN assumption.
#extension GL_EXT_control_flow_attributes : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer BufL { float logits[]; };

layout(push_constant) uniform PushConstants {
    uint n;
    float cap;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    float v = logits[i];
    if ((floatBitsToUint(v) & 0x7f800000u) == 0x7f800000u) return;   // NaN / +-inf: leave it for the host guard
    logits[i] = tanh(clamp(v * (1.0 / pc.cap), -20.0, 20.0)) * pc.cap;
}
