#version 450
#extension GL_EXT_integer_dot_product        : require
#extension GL_KHR_shader_subgroup_basic      : require
#extension GL_KHR_shader_subgroup_arithmetic : require
// Q8_0 MMVQ decode GEMV: integer-dot (dp4a) matrix-vector multiply.
//
//   y[m] = sum_k W_q8[m,k] * x[k]
//
// The activation x[] has been pre-quantized to Q8_1 (int8 qs + fp32 scale d_x
// + fp32 sum, one block per 32 elements) by quantize_q8_1.comp. The Q8_0
// weights are already int8 (fp16 scale d_w + 32 int8). For each 32-block the
// raw integer dot product
//   acc = sum_i  w_qs[i] * x_qs[i]            (int8 * int8 -> int32)
// is accumulated with dotPacked4x8AccSatEXT (4 int8 MACs/instruction,
// SPIR-V OpSDotAccSat, PackedVectorFormat4x8Bit), then scaled by d_w * d_x.
// Q8_0 is symmetric (no min term) so the Q8_1 block-sum is unused here; it is
// carried for the K-quant MMVQ kernels that follow.
//
// ── COALESCED lane=K-position layout (issue #338) ─────────────────────────────
// The previous layout mapped lane -> WHOLE block (thread `tid` owned blocks
// b = tid, tid+128, …). At one load instruction the 32 warp lanes then read
// words ~34 bytes apart (one block-stride) => UNCOALESCED: each memory
// transaction served ~2 lanes, capping the decode GEMV at ~34% of peak BW vs
// llama.cpp's ~61% (`mul_mat_vec.comp`). Decode is bandwidth-bound, so this was
// the #1 decode gap.
//
// This shader mirrors llama.cpp: lane -> K-position. One workgroup (= one
// wave32 subgroup) computes ONE output row. Per K-iteration the 32 lanes sweep
// a contiguous window of WINDOW_BLOCKS (=8) Q8_0 blocks (256 weights): lane L
// owns the 8 int8 at intra-window int8 offset 8*L. Lanes 0..3 cooperatively
// cover block 0 (8 int8 each), lanes 4..7 block 1, etc. Consecutive lanes then
// read CONSECUTIVE weight words => the subgroup hits one contiguous ~272-byte
// region per iteration = fully coalesced. The awkward 34-byte (2 + 32) block
// stride is crossed by per-block index arithmetic, and the fp16 scale (uint16
// at the block base) is read uniformly by a block's 4 lanes — never by a
// per-lane misaligned funnel. Reduction: a single subgroupAdd (no shared
// memory, no barriers).
//
// Weight layout (mirrors matmul_q8_0.comp / DotLLM.Cpu GemvQ8_0):
//   Each 32 weights = one Q8_0 block of 34 bytes (= 17 uint16):
//     uint16 [0]      = fp16 scale d_w
//     uint16 [1..16]  = 32 signed int8 qs (2 int8 per uint16)
//   Row stride = (K/32) * 17 uint16. uint16 indexing is always 2-byte aligned
//   (34 is even), so weights are read as uint16 pairs with NO bit-shift funnel.

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufW   { uint  weight[]; }; // Q8_0 blob, 4-byte indexable
layout(set = 0, binding = 1, std430) readonly  buffer BufXq  { uint  xq[]; };      // [K/4] packed int8 activations
layout(set = 0, binding = 2, std430) readonly  buffer BufXds { vec2  xds[]; };     // [K/32] (d_x, s_x)
layout(set = 0, binding = 3, std430) writeonly buffer BufY   { float y[]; };       // [M]

layout(push_constant) uniform PushConstants {
    uint M;            // number of output rows
    uint K;            // columns (multiple of 32)
    uint blocksPerRow; // = K / 32
    uint rowUints;     // per-row uint stride bound (rounded up; unused here)
} pc;

const uint UINT16_PER_BLOCK = 17u;  // 34 bytes = 1 scale + 16 qs (uint16)
const uint WINDOW_BLOCKS    = 8u;   // 32 lanes * 8 int8/lane = 256 weights = 8 blocks

// Read one uint16 (little-endian) from the 4-byte-indexed weight buffer at the
// given uint16 index. The 34-byte block stride is even, so every uint16 index
// is a valid 2-byte-aligned element — no straddle, no funnel.
uint readU16(uint idx16) {
    uint w = weight[idx16 >> 1u];
    return ((idx16 & 1u) == 0u) ? (w & 0xFFFFu) : (w >> 16u);
}

void main() {
    uint m = gl_WorkGroupID.x;
    if (m >= pc.M) return;

    uint lane = gl_LocalInvocationID.x;        // 0..31 (one subgroup per workgroup)
    uint blockInWindow = lane >> 2u;           // 0..7 : which block of the 8-block window
    uint subInBlock    = lane & 3u;            // 0..3 : which 8-int8 quarter of that block
    uint qOff16        = 1u + 4u * subInBlock; // uint16 offset into the block's qs for this lane

    uint rowBase16 = m * pc.blocksPerRow * UINT16_PER_BLOCK;

    float acc = 0.0;
    for (uint w0 = 0u; w0 < pc.blocksPerRow; w0 += WINDOW_BLOCKS) {
        uint blk = w0 + blockInWindow;
        if (blk >= pc.blocksPerRow)
            continue;

        uint blkBase16 = rowBase16 + blk * UINT16_PER_BLOCK;

        // fp16 weight scale (uint16 at the block base), shared by this block's 4 lanes.
        float dW = unpackHalf2x16(readU16(blkBase16)).x;
        float dX = xds[blk].x;

        // This lane's 8 int8 weights, read as four contiguous uint16 -> two uint32.
        uint qb = blkBase16 + qOff16;
        uint w32a = readU16(qb)      | (readU16(qb + 1u) << 16u);
        uint w32b = readU16(qb + 2u) | (readU16(qb + 3u) << 16u);

        // Matching 8 activations: block blk's 32 activations are xq[blk*8 .. +8];
        // this lane owns the 8 at int8 index 8*subInBlock => uint index +2*subInBlock.
        uint xbase = blk * 8u + 2u * subInBlock;
        uint xa = xq[xbase];
        uint xb = xq[xbase + 1u];

        int dotI = 0;
        dotI = dotPacked4x8AccSatEXT(int(w32a), int(xa), dotI);
        dotI = dotPacked4x8AccSatEXT(int(w32b), int(xb), dotI);

        acc += (dW * dX) * float(dotI);
    }

    // The subgroup IS the row: one reduction yields y[m] (no shared mem, no barrier).
    float total = subgroupAdd(acc);
    if (subgroupElect())
        y[m] = total;
}
