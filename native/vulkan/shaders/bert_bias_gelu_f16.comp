#version 450
// In-place fused bias add + tanh GELU on an F16 activation: x[r, i] = f16(gelu(f32(x[r, i]) + bias[i])) (issue #1474).
// Twin of bert_bias_gelu_f32.comp: the arithmetic is F32 in registers, only the stored tensor is F16.
// Dispatch: local_size_x = 256, groupCount.x = ceil(rows * width / 256).

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430)          buffer BufX    { float16_t x[]; };
layout(set = 0, binding = 1, std430) readonly buffer BufBias { float bias[]; };

layout(push_constant) uniform PushConstants {
    uint total;   // rows * width
    uint width;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.total) return;
    float v = float(x[idx]) + bias[idx % pc.width];
    float a = 0.79788456080286535588 * v * (1.0 + 0.044715 * v * v);
    a = clamp(a, -15.0, 15.0);
    float t = 2.0 / (1.0 + exp(-2.0 * a)) - 1.0;   // tanh, saturating-safe
    x[idx] = float16_t(0.5 * v * (1.0 + t));
}
