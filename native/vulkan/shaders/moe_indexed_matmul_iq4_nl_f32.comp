#version 450
// MoE indexed expert matmul over a packed IQ4_NL expert bank (issue #407).
//
//   y[n, m] = sum_k dequant_iq4_nl(bank[indices[n], m, k]) * x[n, k]
//
// Layout of `bank` is [numExperts, M, K] row-major. Each row holds (K / 32)
// IQ4_NL blocks of 18 bytes (32 elements each):
//     bytes [0,1]   = fp16 d   (per-block scale)
//     bytes [2..17] = qs[16]   — 32 x 4-bit codebook indices, two per byte;
//                                low nibble  -> elements [0..15],
//                                high nibble -> elements [16..31].
// Row stride = (K / 32) * 18 bytes. 18 is NOT a multiple of 4, so a block base
// can land at any byte phase within the uint-indexed buffer — every read goes
// through the straddle-safe helpers below.
//
// Reconstruction: the 4-bit value q is NOT a signed int, it is an index into the
// 16-entry non-linear signed int8 lookup `kvalues_iq4nl[16]` (ggml's table,
// shared with IQ4_XS):  value = d * float(kvalues_iq4nl[q]).
// Unpack logic and codebook are lifted verbatim from the in-tree, already-verified
// dense path (matmul_iq4_nl_f32_gemv.comp / iq4_nl_dequant_f32.comp) rather than
// re-derived, and cross-checked against DotLLM.Cpu.Kernels.Dequantize
// .DequantizeIQ4_NL on real GGUF bytes.
//
// Sibling of moe_indexed_matmul_q8_0_f32.comp: same 4-binding signature, same
// push constants, same [numExperts, M, K] addressing.
//
// Dispatch: 2D grid, one thread per output cell (n, m). Workgroup (16, 16).
//   groupCount = (ceil(M/16), ceil(N/16)).

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufBank { uint  bank[]; };   // IQ4_NL blob
layout(set = 0, binding = 1, std430) readonly  buffer BufX    { float x[]; };      // [N * K]
layout(set = 0, binding = 2, std430) readonly  buffer BufIdx  { int   indices[]; };// [N]
layout(set = 0, binding = 3, std430) writeonly buffer BufY    { float y[]; };      // [N * M]

layout(push_constant) uniform PushConstants {
    uint M;             // output dim   (per-expert weight row count)
    uint K;             // input dim    (per-expert weight col count, multiple of 32)
    uint N;             // total rows   (typically seqLen * topK)
    uint numExperts;    // bank's first axis size — bounds-check
    uint blocksPerRow;  // = K / 32
} pc;

const uint IQ4_NL_BLOCK_BYTES = 18u;
const uint IQ4_NL_GROUP_SIZE  = 32u;

// IQ4_NL / IQ4_XS shared signed-int8 codebook. Encoded as float for direct use.
const float KVALUES_IQ4NL[16] = float[16](
    -127.0, -104.0, -83.0, -65.0, -49.0, -35.0, -22.0, -10.0,
       1.0,   13.0,  25.0,  38.0,  53.0,  69.0,  89.0, 113.0
);

// Read 4 consecutive bytes at `absByteOff` as a little-endian packed uint,
// funnelling across the word boundary when the offset is not 4-aligned.
uint read4Bytes(uint absByteOff) {
    uint idx = absByteOff >> 2u;
    uint ph  = absByteOff & 3u;
    uint lo  = bank[idx];
    if (ph == 0u) return lo;
    uint hi = bank[idx + 1u];
    return (lo >> (ph * 8u)) | (hi << ((4u - ph) * 8u));
}

float readHalf(uint absByteOff) {
    uint alignedIdx = absByteOff >> 2u;
    uint byteInWord = absByteOff & 3u;
    uint u = bank[alignedIdx];
    uint half16;
    if (byteInWord <= 2u) {
        half16 = (u >> (byteInWord * 8u)) & 0xFFFFu;
    } else {
        uint uNext = bank[alignedIdx + 1u];
        half16 = ((u >> 24) & 0xFFu) | ((uNext & 0xFFu) << 8);
    }
    return unpackHalf2x16(half16).x;
}

void main() {
    uint m = gl_GlobalInvocationID.x; // 0..M
    uint n = gl_GlobalInvocationID.y; // 0..N
    if (m >= pc.M || n >= pc.N) return;

    int rawIdx = indices[n];
    uint expertIdx = uint(clamp(rawIdx, 0, int(pc.numExperts) - 1));

    uint rowByteStride    = pc.blocksPerRow * IQ4_NL_BLOCK_BYTES;
    uint matrixByteStride = pc.M * rowByteStride;
    uint rowByteBase      = expertIdx * matrixByteStride + m * rowByteStride;
    uint xRowBase         = n * pc.K;

    float acc = 0.0;

    for (uint b = 0u; b < pc.blocksPerRow; b++) {
        uint blockByteBase = rowByteBase + b * IQ4_NL_BLOCK_BYTES;
        float d = readHalf(blockByteBase);
        uint qsBase = blockByteBase + 2u;

        uint xBase = xRowBase + b * IQ4_NL_GROUP_SIZE;

        // 16 qs bytes (32 nibbles) read 4-at-a-time as 4 words. Word w holds
        // bytes [4w..4w+3]; each byte's low nibble produces element 4w+i, its
        // high nibble element 4w+i+16.
        float loSum = 0.0;
        float hiSum = 0.0;
        for (uint w = 0u; w < 4u; w++) {
            uint cur = read4Bytes(qsBase + w * 4u);
            uint e = w * 4u;
            loSum += x[xBase + e + 0u] * KVALUES_IQ4NL[ cur        & 0xFu]
                   + x[xBase + e + 1u] * KVALUES_IQ4NL[(cur >>  8u) & 0xFu]
                   + x[xBase + e + 2u] * KVALUES_IQ4NL[(cur >> 16u) & 0xFu]
                   + x[xBase + e + 3u] * KVALUES_IQ4NL[(cur >> 24u) & 0xFu];
            hiSum += x[xBase + e + 16u] * KVALUES_IQ4NL[(cur >>  4u) & 0xFu]
                   + x[xBase + e + 17u] * KVALUES_IQ4NL[(cur >> 12u) & 0xFu]
                   + x[xBase + e + 18u] * KVALUES_IQ4NL[(cur >> 20u) & 0xFu]
                   + x[xBase + e + 19u] * KVALUES_IQ4NL[(cur >> 28u) & 0xFu];
        }
        acc += d * (loSum + hiSum);
    }

    y[n * pc.M + m] = acc;
}
