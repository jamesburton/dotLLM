#version 450
#extension GL_EXT_integer_dot_product : require
// Q4_K MMQ prefill GEMM: integer-dot (dp4a) batched matrix multiply.
//
//   C[N, M] = B[N, K] @ W_q4k[M, K]^T
//
// The activation B[N, K] has been pre-quantized to Q8_1 row-wise
// (quantize_q8_1_rows.comp): packed int8 qs + per-32-block (d_x, s_x). Q4_K stores
// a 4-bit nibble q per weight with per-sub-block (scale, min) and a super-block
// (d, dmin):  w_i = d·scale·q_i − dmin·min.  Per 32-element sub-block (aligned 1:1
// with a Q8_1 block):
//   sum_i w_i·x_i = d·scale·d_x·dp4a(q_nibbles, xq) − dmin·min·s_x
// This is the compute-bound seqLen>1 analogue of matmul_q4_k_mmvq.comp (decode) and
// matmul_q8_0_mmq.comp (Q8_0 prefill). Unlike Q8_0 (symmetric, no min), Q4_K carries
// the asymmetric min term per (token, weight-row, sub-block) via the Q8_1 row sum s_x.
//
// NOT bit-exact vs the F32-in GEMM (B is int8-quantized first). Validated against the
// CPU F32 oracle with a tolerance + argmax-exact test.
//
// Tiling: output tile = 16 token rows × 16 weight cols of C, one thread per cell
// (workgroup 16×16). Per K-super-block iteration the 16-row weight tile is
// nibble-decoded into shared int8 once and reused across 16 tokens; the 16-token
// activation tile is reused across 16 weight rows.
//
// Q4_K super-block layout (144 bytes / 256 elems; mirrors matmul_q4_k_mmvq.comp):
//   [0,1]=fp16 d  [2,3]=fp16 dmin  [4..15]=scales[12] (8×6-bit sc + 8×6-bit mn)
//   [16..143]=qs[128] (low nibble → even sub-block, high nibble → odd sub-block).

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufW   { uint  weight[]; }; // Q4_K blob
layout(set = 0, binding = 1, std430) readonly  buffer BufXq  { uint  xq[]; };      // [N*K/4]
layout(set = 0, binding = 2, std430) readonly  buffer BufXds { vec2  xds[]; };     // [N*K/32]
layout(set = 0, binding = 3, std430) writeonly buffer BufC   { float c[]; };       // [N*M]

layout(push_constant) uniform PushConstants {
    uint M;            // output dim (weight rows)
    uint K;            // contraction dim (multiple of 256)
    uint N;            // batch size (input rows)
    uint blocksPerRow; // = K / 256 (super-blocks)
    uint rowUints;     // unused
} pc;

const uint TILE_M = 16u;
const uint TILE_N = 16u;
const uint SB_BYTES     = 144u;  // Q4_K super-block bytes
const uint SUBS         = 8u;    // 32-element sub-blocks per super-block
const uint UINTS_PER_SB = 64u;   // 256 int8 / 4

// Per K-super-block tile: 16 rows × 64 uints of packed int8 each, for B and W.
shared uint  sharedWq[TILE_M * UINTS_PER_SB]; // 1024 uints (nibble-decoded weights)
shared uint  sharedXq[TILE_N * UINTS_PER_SB]; // 1024 uints (Q8_1 activations)
shared float sharedWdsc[TILE_M * SUBS];       // d · scale  per (row, sub-block)
shared float sharedWdmn[TILE_M * SUBS];       // dmin · min per (row, sub-block)
shared float sharedXd[TILE_N * SUBS];         // d_x per (token, sub-block)
shared float sharedXs[TILE_N * SUBS];         // s_x per (token, sub-block)

uint readByte(uint absByteOff) {
    uint u = weight[absByteOff >> 2u];
    return (u >> ((absByteOff & 3u) * 8u)) & 0xFFu;
}

float readHalf(uint absByteOff) {
    uint alignedIdx = absByteOff >> 2u;
    uint byteInWord = absByteOff & 3u;
    uint u = weight[alignedIdx];
    uint half16;
    if (byteInWord <= 2u) {
        half16 = (u >> (byteInWord * 8u)) & 0xFFFFu;
    } else {
        uint uNext = weight[alignedIdx + 1u];
        half16 = ((u >> 24) & 0xFFu) | ((uNext & 0xFFu) << 8);
    }
    return unpackHalf2x16(half16).x;
}

// j-th (0..7) (scale, min) pair from the 12-byte scales[] — get_scale_min_k4.
uvec2 unpackScaleMin(uint scalesByteBase, uint j) {
    uint sc, mn;
    if (j < 4u) {
        sc = readByte(scalesByteBase + j) & 63u;
        mn = readByte(scalesByteBase + j + 4u) & 63u;
    } else {
        uint scLow  = readByte(scalesByteBase + j + 4u) & 0xFu;
        uint scHigh = (readByte(scalesByteBase + j - 4u) >> 6u) & 0x3u;
        sc = scLow | (scHigh << 4u);
        uint mnLow  = (readByte(scalesByteBase + j + 4u) >> 4u) & 0xFu;
        uint mnHigh = (readByte(scalesByteBase + j) >> 6u) & 0x3u;
        mn = mnLow | (mnHigh << 4u);
    }
    return uvec2(sc, mn);
}

void main() {
    uint m = gl_WorkGroupID.x * TILE_M + gl_LocalInvocationID.x; // weight row / C col
    uint t = gl_WorkGroupID.y * TILE_N + gl_LocalInvocationID.y; // token row / C row
    uint tid = gl_LocalInvocationID.y * TILE_M + gl_LocalInvocationID.x; // 0..255

    uint mBase = gl_WorkGroupID.x * TILE_M;
    uint tBase = gl_WorkGroupID.y * TILE_N;

    uint rowByteStride = pc.blocksPerRow * SB_BYTES;
    float acc = 0.0;

    for (uint kSB = 0u; kSB < pc.blocksPerRow; kSB++) {
        // ---- 1. Stage weights: decode 16 rows × 32 qs-uints → 16 × 64 int8-uints. ----
        // 512 source decodes / 256 threads = 2 each; each decode writes lo+hi.
        for (uint s = 0u; s < 2u; s++) {
            uint idx = tid + s * 256u;       // 0..511
            uint rLocal = idx >> 5u;         // 0..15 weight row in tile
            uint u      = idx & 31u;         // 0..31 qs uint within super-block
            uint mGlobal = mBase + rLocal;
            uint cur = 0u;
            if (mGlobal < pc.M) {
                uint blockByteBase = mGlobal * rowByteStride + kSB * SB_BYTES;
                cur = weight[((blockByteBase + 16u) >> 2u) + u]; // qs word-aligned at +16
            }
            uint lo = ( cur        & 0x0Fu)
                    | ((cur >>  8u) & 0x0Fu) << 8u
                    | ((cur >> 16u) & 0x0Fu) << 16u
                    | ((cur >> 24u) & 0x0Fu) << 24u;
            uint hi = ((cur >>  4u) & 0x0Fu)
                    | ((cur >> 12u) & 0x0Fu) << 8u
                    | ((cur >> 20u) & 0x0Fu) << 16u
                    | ((cur >> 28u) & 0x0Fu) << 24u;
            uint p = u >> 3u;                // 0..3 pair
            uint g = u & 7u;                 // 0..7 quartet within sub-block
            uint j0 = p * 2u;                // low-nibble sub-block
            sharedWq[rLocal * UINTS_PER_SB + j0 * 8u + g]        = lo;
            sharedWq[rLocal * UINTS_PER_SB + (j0 + 1u) * 8u + g] = hi;
        }

        // ---- 2. Stage weight scales: 16 rows × 8 sub-blocks (d·sc, dmin·mn). ----
        if (tid < TILE_M * SUBS) {
            uint rLocal = tid >> 3u;         // 0..15
            uint j      = tid & 7u;          // 0..7
            uint mGlobal = mBase + rLocal;
            float dsc = 0.0, dmn = 0.0;
            if (mGlobal < pc.M) {
                uint blockByteBase = mGlobal * rowByteStride + kSB * SB_BYTES;
                float d    = readHalf(blockByteBase);
                float dmin = readHalf(blockByteBase + 2u);
                uvec2 sm = unpackScaleMin(blockByteBase + 4u, j);
                dsc = d * float(sm.x);
                dmn = dmin * float(sm.y);
            }
            sharedWdsc[rLocal * SUBS + j] = dsc;
            sharedWdmn[rLocal * SUBS + j] = dmn;
        }

        // ---- 3. Stage activations: 16 token rows × 64 int8-uints. ----
        for (uint s = 0u; s < 4u; s++) {
            uint idx = tid + s * 256u;       // 0..1023
            uint rLocal = idx >> 6u;         // 0..15 token row
            uint u      = idx & 63u;         // 0..63 uint within super-block
            uint tGlobal = tBase + rLocal;
            uint v = 0u;
            if (tGlobal < pc.N) {
                uint xqRowBase = tGlobal * (pc.K >> 2u);
                v = xq[xqRowBase + kSB * UINTS_PER_SB + u];
            }
            sharedXq[rLocal * UINTS_PER_SB + u] = v;
        }

        // ---- 4. Stage activation scales: 16 rows × 8 (d_x, s_x). ----
        if (tid < TILE_N * SUBS) {
            uint rLocal = tid >> 3u;
            uint j      = tid & 7u;
            uint tGlobal = tBase + rLocal;
            float dx = 0.0, sx = 0.0;
            if (tGlobal < pc.N) {
                vec2 ds = xds[tGlobal * (pc.K >> 5u) + kSB * SUBS + j];
                dx = ds.x; sx = ds.y;
            }
            sharedXd[rLocal * SUBS + j] = dx;
            sharedXs[rLocal * SUBS + j] = sx;
        }

        barrier();

        // ---- 5. dp4a over this super-block for output cell (t, m). ----
        {
            uint wRow = gl_LocalInvocationID.x; // 0..15
            uint tRow = gl_LocalInvocationID.y; // 0..15
            for (uint j = 0u; j < SUBS; j++) {
                uint wbase = wRow * UINTS_PER_SB + j * 8u;
                uint xbase = tRow * UINTS_PER_SB + j * 8u;
                int dotI = 0;
                for (uint g = 0u; g < 8u; g++) {
                    dotI = dotPacked4x8AccSatEXT(
                        int(sharedWq[wbase + g]), int(sharedXq[xbase + g]), dotI);
                }
                float dsc = sharedWdsc[wRow * SUBS + j];
                float dmn = sharedWdmn[wRow * SUBS + j];
                float dx  = sharedXd[tRow * SUBS + j];
                float sx  = sharedXs[tRow * SUBS + j];
                acc += dsc * (dx * float(dotI)) - dmn * sx;
            }
        }

        barrier();
    }

    if (m < pc.M && t < pc.N) {
        c[t * pc.M + m] = acc;
    }
}
