#version 450
// Edge0 latent MoE (G3, #1981), DECODE: edge0_group_combine for all eight groups in one dispatch (single token): z[g * L + c] = sum over the slots whose expert is
// in group g of weights[j] * down[j, c], slot order ascending, exact 0.0 for a group with no slot. Per element the arithmetic is the per-group shader's.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufDown    { float down[]; };
layout(set = 0, binding = 1, std430) readonly  buffer BufIdx     { int   indices[]; };
layout(set = 0, binding = 2, std430) readonly  buffer BufWeights { float weights[]; };
layout(set = 0, binding = 3, std430) readonly  buffer BufLabels  { int   labels[]; };
layout(set = 0, binding = 4, std430) writeonly buffer BufZ       { float z[]; };

layout(push_constant) uniform PushConstants {
    uint L;
    uint K;
    uint numExperts;
} pc;

void main() {
    uint c = gl_GlobalInvocationID.x;
    if (c >= pc.L) return;
    for (uint g = 0u; g < 8u; g++) {
        float acc = 0.0;
        for (uint j = 0u; j < pc.K; j++) {
            uint e = uint(indices[j]);
            if (e < pc.numExperts && uint(labels[e]) == g)
                acc += weights[j] * down[j * pc.L + c];
        }
        z[g * pc.L + c] = acc;
    }
}
