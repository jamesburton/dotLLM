#version 450
// Inkling 2 short-conv state restore (issue #2046): state[c][k] = snap[(row + 1 + k) * C + c] for k = 0..2, i.e. the carried window as it was after row `row`
// of the verify forward that recorded `snap` (inkling2_conv, SNAP = 1). Both are BF16 words: the copy is lossless. One thread per channel.
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer BufSnap { uint16_t snap[]; };
layout(set = 0, binding = 1, std430)          buffer BufSt   { uint16_t st[]; };

layout(push_constant) uniform PushConstants {
    uint C;
    uint row;
    uint snapOff;
} pc;

void main() {
    uint c = gl_GlobalInvocationID.x;
    if (c >= pc.C) return;
    for (uint k = 0u; k < 3u; ++k) st[c * 3u + k] = snap[pc.snapOff + (pc.row + 1u + k) * pc.C + c];
}
