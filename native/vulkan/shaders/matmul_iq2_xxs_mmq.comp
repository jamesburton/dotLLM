#version 450
#extension GL_EXT_integer_dot_product : require
// IQ2_XXS MMQ prefill GEMM: integer-dot (dp4a) batched matrix multiply.
//
//   C[N, M] = B[N, K] @ W_iq2xxs[M, K]^T
//
// IQ2_XXS reconstructs each weight from a 256-entry grid of 8 signed magnitudes + a
// per-element sign bit:  w = db · sign · grid[gridIdx*8 + j]  (grid magnitude fits int8,
// so sign·grid is int8 → fed to dp4a). Per 32-element sub-block (= one Q8_1 block):
//   sum_i w_i·x_i = db · d_x · dp4a(sign·grid, xq).  No min term.
//
// The seqLen>1 analogue of matmul_iq2_xxs_mmvq.comp; structurally Q6_K-MMQ-like (8
// sub-blocks of 32, per-sub-block scale, no min) with grid+ksigns codebook decode in
// shared memory. NOT bit-exact vs the F32-in GEMM (B int8-quantized first); validated
// against the CPU F32 oracle.
//
// IQ2_XXS super-block layout (66 bytes / 256; matches matmul_iq2_xxs_mmvq.comp):
//   [0,1]=fp16 d  [2..65]=8 sub-blocks × 8 bytes: a0 (4 grid indices) + a1 (4×7-bit sign
//   indices in low 28 bits + 4-bit sub-scale in top nibble). db = d·(0.5+(a1>>28))·0.25.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufW      { uint  weight[]; };
layout(set = 0, binding = 1, std430) readonly  buffer BufXq     { uint  xq[]; };
layout(set = 0, binding = 2, std430) readonly  buffer BufXds    { vec2  xds[]; };
layout(set = 0, binding = 3, std430) writeonly buffer BufC      { float c[]; };
layout(set = 0, binding = 4, std430) readonly  buffer BufGrid   { uint  iq2xxsGrid[]; };
layout(set = 0, binding = 5, std430) readonly  buffer BufKsigns { uint  ksigns[]; };

layout(push_constant) uniform PushConstants {
    uint M;
    uint K;            // multiple of 256
    uint N;
    uint blocksPerRow; // = K / 256
    uint rowUints;     // unused
} pc;

const uint TILE_M = 16u;
const uint TILE_N = 16u;
const uint SB_BYTES     = 66u;
const uint SUBS         = 8u;
const uint UINTS_PER_SB = 64u;

shared uint  sharedWq[TILE_M * UINTS_PER_SB]; // sign·grid int8 weights, element order
shared uint  sharedXq[TILE_N * UINTS_PER_SB];
shared float sharedWdb[TILE_M * SUBS];        // db per (row, sub-block)
shared float sharedXd[TILE_N * SUBS];         // d_x per (token, sub-block)

uint read4Bytes(uint absByteOff) {
    uint idx = absByteOff >> 2u;
    uint ph  = absByteOff & 3u;
    uint lo  = weight[idx];
    if (ph == 0u) return lo;
    uint hi = weight[idx + 1u];
    return (lo >> (ph * 8u)) | (hi << ((4u - ph) * 8u));
}

float readHalf(uint absByteOff) {
    uint alignedIdx = absByteOff >> 2u;
    uint byteInWord = absByteOff & 3u;
    uint u = weight[alignedIdx];
    uint half16;
    if (byteInWord <= 2u) {
        half16 = (u >> (byteInWord * 8u)) & 0xFFFFu;
    } else {
        uint uNext = weight[alignedIdx + 1u];
        half16 = ((u >> 24) & 0xFFu) | ((uNext & 0xFFu) << 8);
    }
    return unpackHalf2x16(half16).x;
}

uint gridByte(uint absIdx) {
    uint u = iq2xxsGrid[absIdx >> 2u];
    return (u >> ((absIdx & 3u) * 8u)) & 0xFFu;
}

uint ksignByte(uint absIdx) {
    uint u = ksigns[absIdx >> 2u];
    return (u >> ((absIdx & 3u) * 8u)) & 0xFFu;
}

// Pack 4 sign·grid int8 values (grid bytes jbase..jbase+3) for dp4a.
uint packSG(uint gridOff, uint signs, uint jbase) {
    uint res = 0u;
    for (uint e = 0u; e < 4u; e++) {
        uint j = jbase + e;
        int g = int(gridByte(gridOff + j));
        int sg = ((signs & (1u << j)) != 0u) ? -g : g;
        res |= (uint(sg) & 0xFFu) << (e * 8u);
    }
    return res;
}

void main() {
    uint m = gl_WorkGroupID.x * TILE_M + gl_LocalInvocationID.x;
    uint t = gl_WorkGroupID.y * TILE_N + gl_LocalInvocationID.y;
    uint tid = gl_LocalInvocationID.y * TILE_M + gl_LocalInvocationID.x;

    uint mBase = gl_WorkGroupID.x * TILE_M;
    uint tBase = gl_WorkGroupID.y * TILE_N;

    uint rowByteStride = pc.blocksPerRow * SB_BYTES;
    float acc = 0.0;

    for (uint kSB = 0u; kSB < pc.blocksPerRow; kSB++) {
        // ---- 1. Stage weights: 16 rows × 64 element-order uints (grid decode). ----
        for (uint s = 0u; s < 4u; s++) {
            uint idx = tid + s * 256u;       // 0..1023
            uint rLocal = idx >> 6u;
            uint u      = idx & 63u;         // element-order uint
            uint ib32 = u >> 3u;            // sub-block 0..7
            uint w    = u & 7u;             // uint within sub-block 0..7
            uint l    = w >> 1u;            // pair 0..3
            uint hlf = w & 1u;            // which half of the pair's 8 elements
            uint mGlobal = mBase + rLocal;
            uint packed = 0u;
            if (mGlobal < pc.M) {
                uint blockByteBase = mGlobal * rowByteStride + kSB * SB_BYTES;
                uint p  = blockByteBase + 2u + 8u * ib32;
                uint a0 = read4Bytes(p);
                uint a1 = read4Bytes(p + 4u);
                uint gridIdx  = (a0 >> (8u * l)) & 0xFFu;
                uint signsIdx = (a1 >> (7u * l)) & 0x7Fu;
                uint signs    = ksignByte(signsIdx);
                packed = packSG(gridIdx * 8u, signs, hlf * 4u);
            }
            sharedWq[rLocal * UINTS_PER_SB + u] = packed;
        }

        // ---- 2. Stage weight scales: 16 rows × 8 sub-blocks (db). ----
        if (tid < TILE_M * SUBS) {
            uint rLocal = tid >> 3u;
            uint ib32   = tid & 7u;
            uint mGlobal = mBase + rLocal;
            float db = 0.0;
            if (mGlobal < pc.M) {
                uint blockByteBase = mGlobal * rowByteStride + kSB * SB_BYTES;
                float d = readHalf(blockByteBase);
                uint a1 = read4Bytes(blockByteBase + 2u + 8u * ib32 + 4u);
                db = d * (0.5 + float(a1 >> 28)) * 0.25;
            }
            sharedWdb[rLocal * SUBS + ib32] = db;
        }

        // ---- 3. Stage activations: 16 token rows × 64 int8-uints. ----
        for (uint s = 0u; s < 4u; s++) {
            uint idx = tid + s * 256u;
            uint rLocal = idx >> 6u;
            uint u      = idx & 63u;
            uint tGlobal = tBase + rLocal;
            uint v = 0u;
            if (tGlobal < pc.N) {
                v = xq[tGlobal * (pc.K >> 2u) + kSB * UINTS_PER_SB + u];
            }
            sharedXq[rLocal * UINTS_PER_SB + u] = v;
        }

        // ---- 4. Stage activation scales: 16 rows × 8 d_x. ----
        if (tid < TILE_N * SUBS) {
            uint rLocal = tid >> 3u;
            uint ib32   = tid & 7u;
            uint tGlobal = tBase + rLocal;
            float dx = 0.0;
            if (tGlobal < pc.N) {
                dx = xds[tGlobal * (pc.K >> 5u) + kSB * SUBS + ib32].x;
            }
            sharedXd[rLocal * SUBS + ib32] = dx;
        }

        barrier();

        // ---- 5. dp4a over this super-block for output cell (t, m). ----
        {
            uint wRow = gl_LocalInvocationID.x;
            uint tRow = gl_LocalInvocationID.y;
            for (uint ib32 = 0u; ib32 < SUBS; ib32++) {
                uint wbase = wRow * UINTS_PER_SB + ib32 * 8u;
                uint xbase = tRow * UINTS_PER_SB + ib32 * 8u;
                int dotI = 0;
                for (uint g = 0u; g < 8u; g++) {
                    dotI = dotPacked4x8AccSatEXT(int(sharedWq[wbase + g]), int(sharedXq[xbase + g]), dotI);
                }
                acc += sharedWdb[wRow * SUBS + ib32] * (sharedXd[tRow * SUBS + ib32] * float(dotI));
            }
        }

        barrier();
    }

    if (m < pc.M && t < pc.N) {
        c[t * pc.M + m] = acc;
    }
}
