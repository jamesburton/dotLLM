#version 450
// In-place per-feature bias add on an F16 activation: x[t, i] = f16(f32(x[t, i]) + bias[i]) (issue #1474).
// Dispatch: local_size_x = 256, groupCount.x = ceil(rows * width / 256).

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430)          buffer BufX    { float16_t x[]; };
layout(set = 0, binding = 1, std430) readonly buffer BufBias { float bias[]; };

layout(push_constant) uniform PushConstants {
    uint total;   // rows * width
    uint width;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.total) return;
    x[idx] = float16_t(float(x[idx]) + bias[idx % pc.width]);
}
