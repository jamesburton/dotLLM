#version 450
// Test/diagnostic (#1382): mode 0: out[i] = G(seed, tokenIndex, firstIndex + i); mode 1: out[i] = gumbel noise of the Philox word
// ((firstIndex + i) << 8), i.e. of the uniform 24-bit mantissa firstIndex + i, which lets a test sweep the WHOLE uniform domain.
// Used by the exhaustive known-answer test against GumbelNoise.Noise; not on any inference path.
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) writeonly buffer Out { float outG[]; };
layout(push_constant) uniform PushConstants {
    uint count;
    uint firstIndex;
    uint tokenIndex;
    uint seedLo;
    uint seedHi;
    uint mode;
} pc;

#include "gumbel_noise.glsl"

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    uint idx = pc.firstIndex + i;
    outG[i] = pc.mode == 0u ? gumbelNoise(pc.seedLo, pc.seedHi, pc.tokenIndex, idx) : gumbelFromWord(idx << 8);
}
