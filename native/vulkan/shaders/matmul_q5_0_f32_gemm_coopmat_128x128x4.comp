#version 450
// Q5_0 batched GEMM on the shared 128x128 blocked coopmat template (issue #568).
//
//   C[N, M] = B[N, K] @ W_q5_0[M, K]^T,  W dequantised on the fly.
//
// Weight layout (matches matmul_q5_0_f32_gemm.comp / q5_0_dequant_f32.comp): 22-byte blocks of 32
// elements -- fp16 scale `d` at [0..1], uint32 `qh` (the 5th bit of every element) at [2..5],
// qs[16] at [6..21], two 4-bit nibbles per byte:
//   element j      (0..15)  = (qs[j] & 0xF)      | ((qh >>  j      ) & 1) << 4
//   element j + 16 (0..15)  = (qs[j] >> 4)       | ((qh >> (j + 16)) & 1) << 4
//   value = d * (q - 16)
// So a BK=32 K-chunk is exactly one block, and with two lanes per weight row lane 0 stages the low
// nibbles (columns 0..15) and lane 1 the high nibbles (columns 16..31) of the SAME 16 qs bytes.
// 22-byte blocks straddle uint words, so every field is read at an arbitrary byte offset.
//
// PRECISION: as for Q8_0, the scale is folded into the F16 A operand (d*(q-16), |q-16| <= 16), so
// A carries ~2^-11 relative error -- inherent to F16 operands, not to the tile.

#define BM  128
#define BN  128
#define WM  64
#define WN  64
#define NSG 4
#define WAVE 64

#extension GL_GOOGLE_include_directive : require

layout(set = 0, binding = 0, std430) readonly  buffer BufW { uint  weight[]; }; // Q5_0 blob
layout(set = 0, binding = 1, std430) readonly  buffer BufB { float b[]; };      // [N*K]
layout(set = 0, binding = 2, std430) writeonly buffer BufC { float c[]; };      // [N*M]

layout(push_constant) uniform PushConstants {
    uint M;             // output dim (number of weight rows)
    uint K;             // contraction dim (must be a multiple of 32)
    uint N;             // batch size (number of input rows)
    uint blocksPerRow;  // = K / 32
    uint rowUints;      // per-row uint stride
} pc;

#include "gemm_coopmat_blocked_decl.glsl"

const uint BLOCK_BYTES = 22u;   // 2 (fp16 scale) + 4 (qh) + 16 (qs)

const uint A_LANES_PER_ROW = BLOCK_SIZE / BM;        // 2 threads cooperate on one weight row
const uint A_COLS_PER_THR  = BK / A_LANES_PER_ROW;   // 16 codes per thread

uint readByte(uint absByteOff) {
    return (weight[absByteOff >> 2u] >> ((absByteOff & 3u) * 8u)) & 0xFFu;
}

float readHalf(uint absByteOff) {
    return unpackHalf2x16(readByte(absByteOff) | (readByte(absByteOff + 1u) << 8)).x;
}

void gemmStageA(uint ch) {
    uint rowLocal  = g_tid / A_LANES_PER_ROW;
    uint laneOfRow = g_tid % A_LANES_PER_ROW;
    uint mGlobal   = g_mBase + rowLocal;
    uint sBase     = rowLocal * STRIDE;
    uint col0      = laneOfRow * A_COLS_PER_THR;

    bool rowValid = mGlobal < pc.M;
    float d = 0.0;
    uint blockBase = 0u;
    uint qh = 0u;
    if (rowValid) {
        blockBase = mGlobal * (pc.blocksPerRow * BLOCK_BYTES) + ch * BLOCK_BYTES;
        d = readHalf(blockBase);
        qh = readByte(blockBase + 2u) | (readByte(blockBase + 3u) << 8)
           | (readByte(blockBase + 4u) << 16) | (readByte(blockBase + 5u) << 24);
    }

    for (uint j = 0u; j < A_COLS_PER_THR; j++) {
        float q = 0.0;
        if (rowValid) {
            uint byteV = readByte(blockBase + 6u + j);
            uint nib = (laneOfRow == 0u) ? (byteV & 0xFu) : (byteV >> 4);
            uint hi = (qh >> (j + laneOfRow * 16u)) & 1u;
            q = d * float(int(nib | (hi << 4)) - 16);
        }
        sharedA[sBase + col0 + j] = float16_t(q);
    }
}

#define GEMM_M          pc.M
#define GEMM_K          pc.K
#define GEMM_CHUNKS     pc.blocksPerRow
#define GEMM_ROW_BASE   0u
#define GEMM_ROW_LIMIT  pc.N
#define GEMM_B_BUF      b
#define GEMM_C_BUF      c

#include "gemm_coopmat_blocked_main.glsl"
