#version 450
// I2_S (BitNet b1.58 ternary) prefill GEMM — REGISTER-BLOCKED + WIDE-LOAD variant.
//
//   C[N, M] = B[N, K] @ W_i2s[M, K]^T      with W_i2s dequantized on the fly.
//
// A/B comparand for matmul_i2_s_f32_gemm_rb.comp (production). Identical maths,
// identical byte layout and identical 2x2 register-blocked output mapping — the
// only change is the WEIGHT UNPACK: one aligned 32-bit load per thread instead
// of four redundant loads of the same word.
//
// Motivation (issue #229): three cooperative-matrix attempts all lost to the F32
// register-blocked kernel, and the reason turned out to be that this kernel is
// bound by I2_S UNPACKING and shared staging, not by the multiply. So attack the
// unpack instead of the multiply.
//
// Why: the baseline assigns one thread per output cell, so each thread does
// 128 MACs per K-chunk against 128 sharedB + 128 sharedW loads = 0.5 MAC per
// shared load. The kernel is shared-memory-bound, not ALU-bound. Giving each
// thread a 2x2 micro-tile of C reuses each staged value twice: 4 loads feed
// 4 MACs = 1.0 MAC per shared load, doubling arithmetic intensity for the
// same staging cost.
//
// Tiling:
//   Output tile  = 32 rows of C (TILE_M) x 32 cols of C (TILE_N) = 1024 cells.
//   Workgroup    = (16, 16, 1) = 256 threads, each owning a 2x2 micro-tile.
//   K-chunk      = 128 elements (one full I2_S block — forced by the byte
//                  layout, since one packed byte feeds positions
//                  {gp, gp+32, gp+64, gp+96} spanning the whole block).
//
// Shared memory: (32 + 32) x 128 floats = 32 KB. Deliberately half of the
// 64 KB per-workgroup ceiling — a 64x64 tile with 4x4 micro-tiles would want
// 64 KB and does not fit on Xe-LPG alongside a useful occupancy.
//
// The micro-tile is STRIDED (thread lx owns rows {lx, lx+16}) rather than
// blocked (rows {2*lx, 2*lx+1}) so adjacent threads still touch adjacent
// shared addresses, keeping the bank-conflict behaviour of the baseline.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufW { uint  weight[]; };
layout(set = 0, binding = 1, std430) readonly  buffer BufB { float b[]; };
layout(set = 0, binding = 2, std430) writeonly buffer BufC { float c[]; };

layout(push_constant) uniform PushConstants {
    uint M;
    uint K;             // multiple of 128
    uint N;
    uint blocksPerRow;  // = K / 128
    uint rowUints;      // unused here; kept for push-constant layout parity
} pc;

const uint TILE_M = 32u;
const uint TILE_N = 32u;
const uint SUB    = 16u;          // micro-tile stride (= workgroup dim)
const uint I2S_BLOCK = 128u;      // K-chunk = one I2_S block
const uint I2S_BLOCK_BYTES = 32u;

shared float sharedB[TILE_N * I2S_BLOCK];   // 32 x 128 token tile
shared float sharedW[TILE_M * I2S_BLOCK];   // 32 x 128 dequantised weight tile

void main() {
    uint lx = gl_LocalInvocationID.x;   // 0..15 -> weight rows {lx, lx+16}
    uint ly = gl_LocalInvocationID.y;   // 0..15 -> token rows  {ly, ly+16}
    uint tid = ly * SUB + lx;           // 0..255

    uint mBase = gl_WorkGroupID.x * TILE_M;
    uint tBase = gl_WorkGroupID.y * TILE_N;

    uint rowBytes = pc.K >> 2u;        // K/4 packed bytes per row (= blocksPerRow * 32)

    // Per-tensor float32 scale at the weight-buffer tail (byte offset M*(K/4)),
    // word-aligned because K is a multiple of 128.
    uint scaleByteOff = pc.M * rowBytes;
    float scale = uintBitsToFloat(weight[scaleByteOff >> 2u]);

    float acc00 = 0.0;   // (token ly,      weight lx)
    float acc01 = 0.0;   // (token ly,      weight lx+16)
    float acc10 = 0.0;   // (token ly+16,   weight lx)
    float acc11 = 0.0;   // (token ly+16,   weight lx+16)

    for (uint blk = 0u; blk < pc.blocksPerRow; blk++) {
        uint kBase = blk * I2S_BLOCK;

        // ── 1. Stage sharedB[TILE_N, 128] (32x128 floats). 256 threads load 16 each. ──
        for (uint i = 0u; i < 16u; i++) {
            uint bIdx = tid * 16u + i;         // 0..4095
            uint row  = bIdx >> 7u;            // 0..31  (token within tile)
            uint col  = bIdx & 127u;           // 0..127 (element within block)
            uint tGlobal = tBase + row;
            sharedB[bIdx] = (tGlobal < pc.N) ? b[tGlobal * pc.K + kBase + col] : 0.0;
        }

        // ── 2. Dequantise sharedW[TILE_M, 128] via ONE 32-bit load per thread. ──
        // 32 rows x 32 bytes = 1024 bytes; 256 threads decode 4 bytes each.
        //
        // The baseline called readByte() four times here. Those four calls are
        // provably the SAME aligned uint word, so it issued four identical loads
        // plus four shift/mask pairs to recover bytes already in a register:
        //   byteFlat = tid*4 + i, so gp = gp0 + i with gp0 = (tid*4) & 31 (a
        //   multiple of 4, and gp0 <= 28 so i never crosses into the next row);
        //   rowBytes = K/4 is a multiple of 32 because K is a multiple of 128;
        //   blk*I2S_BLOCK_BYTES is 4-aligned. Hence the byte offset
        //   mGlobal*rowBytes + blk*32 + gp0 is 4-aligned and the four bytes are
        //   exactly that one word.
        // So: load it once (4 packed bytes = 16 ternary codes) and extract from
        // the register. The bounds test is loop-invariant, so hoist it too.
        {
            uint gp0      = (tid * 4u) & 31u;      // 4-aligned byte within block
            uint rowLocal = (tid * 4u) >> 5u;      // 0..31  (weight row within tile)
            uint mGlobal  = mBase + rowLocal;
            uint sBase    = rowLocal * I2S_BLOCK;

            if (mGlobal < pc.M) {
                uint byteOff = mGlobal * rowBytes + blk * I2S_BLOCK_BYTES + gp0;
                uint w4 = weight[byteOff >> 2u];   // one aligned 32-bit load

                for (uint j = 0u; j < 4u; j++) {
                    uint pk = (w4 >> (j * 8u)) & 0xFFu;   // little-endian, matches readByte
                    uint gp = gp0 + j;
                    sharedW[sBase + gp]        = float(int((pk >> 6u) & 3u) - 1);
                    sharedW[sBase + gp + 32u]  = float(int((pk >> 4u) & 3u) - 1);
                    sharedW[sBase + gp + 64u]  = float(int((pk >> 2u) & 3u) - 1);
                    sharedW[sBase + gp + 96u]  = float(int( pk        & 3u) - 1);
                }
            } else {
                for (uint j = 0u; j < 4u; j++) {
                    uint gp = gp0 + j;
                    sharedW[sBase + gp]        = 0.0;
                    sharedW[sBase + gp + 32u]  = 0.0;
                    sharedW[sBase + gp + 64u]  = 0.0;
                    sharedW[sBase + gp + 96u]  = 0.0;
                }
            }
        }

        barrier();

        // ── 3. Partial dot products for this K-chunk — 4 loads feed 4 MACs. ──
        uint bOff0 = ly * I2S_BLOCK;
        uint bOff1 = (ly + SUB) * I2S_BLOCK;
        uint wOff0 = lx * I2S_BLOCK;
        uint wOff1 = (lx + SUB) * I2S_BLOCK;

        for (uint j = 0u; j < I2S_BLOCK; j++) {
            float b0 = sharedB[bOff0 + j];
            float b1 = sharedB[bOff1 + j];
            float w0 = sharedW[wOff0 + j];
            float w1 = sharedW[wOff1 + j];
            acc00 += b0 * w0;
            acc01 += b0 * w1;
            acc10 += b1 * w0;
            acc11 += b1 * w1;
        }

        barrier();
    }

    uint m0 = mBase + lx;
    uint m1 = mBase + lx + SUB;
    uint t0 = tBase + ly;
    uint t1 = tBase + ly + SUB;

    if (t0 < pc.N) {
        if (m0 < pc.M) c[t0 * pc.M + m0] = acc00 * scale;
        if (m1 < pc.M) c[t0 * pc.M + m1] = acc01 * scale;
    }
    if (t1 < pc.N) {
        if (m0 < pc.M) c[t1 * pc.M + m0] = acc10 * scale;
        if (m1 < pc.M) c[t1 * pc.M + m1] = acc11 * scale;
    }
}
