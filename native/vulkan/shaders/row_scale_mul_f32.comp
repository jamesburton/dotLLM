#version 450
// y[row, i] *= scales[row] (issue #1171): undoes row_pow2_downscale_f32 on the projected rows. Exact (power-of-two scales).

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer BufY { float y[]; };                 // [rows, n]
layout(set = 0, binding = 1, std430) readonly buffer BufScale { float scales[]; }; // [rows]

layout(push_constant) uniform PushConstants {
    uint total;   // rows * n
    uint n;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.total) return;
    y[i] *= scales[i / pc.n];
}
