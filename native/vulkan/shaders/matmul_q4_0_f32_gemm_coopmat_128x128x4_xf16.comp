#version 450
// Precision-study variant (issue #1109, experiment only): matmul_q4_0_f32_gemm_coopmat_128x128x4.comp with GEMM_ACC_F16 (see the template).
#define GEMM_ACC_F16 1
// Q4_0 batched GEMM on the shared 128x128 blocked coopmat template (issue #1018; template: matmul_q5_0_f32_gemm_coopmat_128x128x4.comp).
//
//   C[N, M] = B[N, K] @ W_q4_0[M, K]^T,  W dequantised on the fly.
//
// Weight layout: 18-byte blocks of 32 elements -- fp16 scale `d` at [0..1], qs[16] at [2..17], two 4-bit nibbles per byte:
//   element j      (0..15) = qs[j] & 0xF       element j + 16 (0..15) = qs[j] >> 4       value = d * (nibble - 8)
// A BK=32 K-chunk is exactly one block; with two lanes per weight row lane 0 stages the low nibbles (columns 0..15) and lane 1 the high
// nibbles (columns 16..31) of the SAME 16 qs bytes. 18-byte blocks are only 2-byte aligned: five raw words always cover the block.
//
// PRECISION: the scale is folded into the F16 A operand (d*(nibble-8), |nibble-8| <= 8), ~2^-11 relative error -- inherent to F16 operands.

#define BM  128
#define BN  128
#define WM  64
#define WN  64
#define NSG 4
#define WAVE 64

#extension GL_GOOGLE_include_directive : require

layout(set = 0, binding = 0, std430) readonly  buffer BufW { uint  weight[]; }; // Q4_0 blob
layout(set = 0, binding = 1, std430) readonly  buffer BufB { vec4 b4[]; };      // [N*K]
layout(set = 0, binding = 2, std430) writeonly buffer BufC { float c[]; };      // [N*M]

layout(push_constant) uniform PushConstants {
    uint M;             // output dim (number of weight rows)
    uint K;             // contraction dim (must be a multiple of 32)
    uint N;             // batch size (number of input rows)
    uint blocksPerRow;  // = K / 32
    uint rowUints;      // per-row uint stride
} pc;

#include "gemm_coopmat_blocked_decl.glsl"

const uint BLOCK_BYTES = 18u;   // 2 (fp16 scale) + 16 (qs)

const uint A_LANES_PER_ROW = BLOCK_SIZE / BM;        // 2 threads cooperate on one weight row
const uint A_COLS_PER_THR  = BK / A_LANES_PER_ROW;   // 16 codes per thread

void gemmStageA(uint ch) {
    uint rowLocal  = g_tid / A_LANES_PER_ROW;
    uint laneOfRow = g_tid % A_LANES_PER_ROW;
    uint mGlobal   = g_mBase + rowLocal;
    uint sBase     = rowLocal * STRIDE + laneOfRow * A_COLS_PER_THR;

    if (mGlobal >= pc.M) {
        for (uint j = 0u; j < A_COLS_PER_THR; j++) sharedA[sBase + j] = float16_t(0.0);
        return;
    }

    uint blockBase = mGlobal * (pc.blocksPerRow * BLOCK_BYTES) + ch * BLOCK_BYTES;
    uint wi = blockBase >> 2u;
    bool hi = (blockBase & 2u) != 0u;
    uint w[5];
    [[unroll]] for (uint i = 0u; i < 5u; i++) w[i] = weight[wi + i];

    float d = unpackHalf2x16(hi ? (w[0] >> 16) : (w[0] & 0xFFFFu)).x;
    uint qs[4];
    [[unroll]] for (uint m = 0u; m < 4u; m++)
        qs[m] = hi ? w[1u + m] : ((w[m] >> 16) | (w[m + 1u] << 16));

    uint nibSh = laneOfRow * 4u;
    [[unroll]] for (uint m = 0u; m < 4u; m++) {
        [[unroll]] for (uint jb = 0u; jb < 4u; jb++) {
            uint nib = (qs[m] >> (jb * 8u + nibSh)) & 0xFu;
            sharedA[sBase + m * 4u + jb] = float16_t(d * float(int(nib) - 8));
        }
    }
}

#define GEMM_M          pc.M
#define GEMM_K          pc.K
#define GEMM_CHUNKS     pc.blocksPerRow
#define GEMM_ROW_BASE   0u
#define GEMM_ROW_LIMIT  pc.N
#define GEMM_B_BUF      b4
#define GEMM_B_VEC4
#define GEMM_C_BUF      c

#include "gemm_coopmat_blocked_main.glsl"
