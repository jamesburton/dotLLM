    }

    float sum0 = (NC > 0u) ? subgroupAdd(acc0) : 0.0;
    float sum1 = (NC > 1u) ? subgroupAdd(acc1) : 0.0;
    float sum2 = (NC > 2u) ? subgroupAdd(acc2) : 0.0;
    float sum3 = (NC > 3u) ? subgroupAdd(acc3) : 0.0;
    float sum4 = (NC > 4u) ? subgroupAdd(acc4) : 0.0;
    float sum5 = (NC > 5u) ? subgroupAdd(acc5) : 0.0;
    float sum6 = (NC > 6u) ? subgroupAdd(acc6) : 0.0;
    float sum7 = (NC > 7u) ? subgroupAdd(acc7) : 0.0;
    if (subgroupElect()) {
        if (NC > 0u) y[0u * pc.M + m] = sum0;
        if (NC > 1u) y[1u * pc.M + m] = sum1;
        if (NC > 2u) y[2u * pc.M + m] = sum2;
        if (NC > 3u) y[3u * pc.M + m] = sum3;
        if (NC > 4u) y[4u * pc.M + m] = sum4;
        if (NC > 5u) y[5u * pc.M + m] = sum5;
        if (NC > 6u) y[6u * pc.M + m] = sum6;
        if (NC > 7u) y[7u * pc.M + m] = sum7;
