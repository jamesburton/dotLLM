#version 450
// In-place scalar multiply: x[i] *= scale.
// Used for Gemma sqrt(hidden) embedding scaling applied to the gathered
// embedding rows before the first transformer layer (mirrors the CPU
// TransformerModel embedding-scale step).
//
// Pointwise, no reduction — one thread per element.
// Dispatch:
//   local_size_x = 256
//   groupCount.x = ceil(n / 256)

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer BufX { float x[]; };

layout(push_constant) uniform PushConstants {
    uint  n;
    float scale;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    x[i] = x[i] * pc.scale;
}
