#version 450
// Sums S split-K partial slabs: out[i] = sum_s partial[s * count + i]. One thread per output element.
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly  buffer BufP { float part[]; };
layout(set = 0, binding = 1, std430) writeonly buffer BufO { float outv[]; };
layout(push_constant) uniform PushConstants { uint count; uint splits; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    float acc = 0.0;
    for (uint s = 0u; s < pc.splits; s++) acc += part[s * pc.count + i];
    outv[i] = acc;
}
