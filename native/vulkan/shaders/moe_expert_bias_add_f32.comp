#version 450
// Per-expert bias add for routed MoE rows (gpt-oss ffn_{gate,up,down}_exps.bias):
//   y[r, i] += bias[indices[r], i]      for r in [0, rows), i in [0, dim)
// bias is [numExperts, dim] row-major. In place on y.
//
// Dispatch: local_size_x = 256, groupCount.x = ceil(rows * dim / 256).

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430)          buffer BufY    { float y[]; };       // [rows, dim]
layout(set = 0, binding = 1, std430) readonly buffer BufBias { float bias[]; };    // [numExperts, dim]
layout(set = 0, binding = 2, std430) readonly buffer BufIdx  { int indices[]; };   // [rows]

layout(push_constant) uniform PushConstants {
    uint rows;
    uint dim;
    uint numExperts;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = pc.rows * pc.dim;
    if (idx >= total) return;

    uint r = idx / pc.dim;
    uint i = idx - r * pc.dim;
    uint e = uint(clamp(indices[r], 0, int(pc.numExperts) - 1));
    y[idx] += bias[e * pc.dim + i];
}
