#version 450
#extension GL_EXT_integer_dot_product : require
// Q6_K MMQ prefill GEMM: integer-dot (dp4a) batched matrix multiply.
//
//   C[N, M] = B[N, K] @ W_q6k[M, K]^T
//
// The activation B[N, K] is pre-quantized to Q8_1 row-wise (quantize_q8_1_rows.comp):
// packed int8 qs + per-32-block (d_x, s_x). Q6_K reconstructs w_i = d · scale[sub16] ·
// (q6_i − 32), with a per-256 super-block fp16 d, a signed-int8 per-16-element scale,
// and a 6-bit quant q6 (0..63) = ql nibble | (qh 2-bit field << 4). Symmetric, so no
// min term (the −32 is folded into each weight byte before the dp4a, like Q6_K MMVQ).
// Per 16-element sub-block s:  sum_i w_i·x_i = d · scale[s] · d_x · dp4a((q6−32), xq).
//
// The seqLen>1 analogue of matmul_q6_k_mmvq.comp (decode) and matmul_q4_k_mmq.comp.
// NOT bit-exact vs the F32-in GEMM (B is int8-quantized first); validated against the
// CPU F32 oracle (argmax + tolerance).
//
// Tiling: 16 token rows × 16 weight cols of C, one thread per cell (workgroup 16×16).
// Per K-super-block, the 16-row weight tile is decoded (ql/qh → signed int8, NATURAL
// element order matching xq) into shared memory once and reused across 16 tokens.
// Each 32-element Q8_1 block (chunk) splits into two 16-element halves with scales
// d·scale[2·grp+8·hf] and d·scale[2·grp+8·hf+1].
//
// Q6_K super-block layout (210 bytes / 256; matches matmul_q6_k_mmvq.comp):
//   [0..127]=ql[128]  [128..191]=qh[64]  [192..207]=scales[16] (s8)  [208,209]=fp16 d.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly  buffer BufW   { uint  weight[]; }; // Q6_K blob
layout(set = 0, binding = 1, std430) readonly  buffer BufXq  { uint  xq[]; };      // [N*K/4]
layout(set = 0, binding = 2, std430) readonly  buffer BufXds { vec2  xds[]; };     // [N*K/32]
layout(set = 0, binding = 3, std430) writeonly buffer BufC   { float c[]; };       // [N*M]

layout(push_constant) uniform PushConstants {
    uint M;            // output dim (weight rows)
    uint K;            // contraction dim (multiple of 256)
    uint N;            // batch size (input rows)
    uint blocksPerRow; // = K / 256 (super-blocks)
    uint rowUints;     // unused
} pc;

const uint TILE_M = 16u;
const uint TILE_N = 16u;
const uint SB_BYTES     = 210u;  // Q6_K super-block bytes
const uint CHUNKS       = 8u;    // 32-element Q8_1 blocks per super-block
const uint UINTS_PER_SB = 64u;   // 256 int8 / 4
const uint SCALES       = 16u;   // per-16-element scales

shared uint  sharedWq[TILE_M * UINTS_PER_SB]; // decoded (q6−32) signed int8, element order
shared uint  sharedXq[TILE_N * UINTS_PER_SB]; // Q8_1 activations
shared float sharedWsc[TILE_M * SCALES];      // d · scale[sub16] per (row, sub16)
shared float sharedXd[TILE_N * CHUNKS];       // d_x per (token, 32-block)

int readSByte(uint absByteOff) {
    uint u = weight[absByteOff >> 2u];
    uint b = (u >> ((absByteOff & 3u) * 8u)) & 0xFFu;
    return int(b) - int((b & 0x80u) << 1);   // sign-extend int8
}

uint read4Bytes(uint absByteOff) {
    uint idx = absByteOff >> 2u;
    uint ph  = absByteOff & 3u;
    uint lo  = weight[idx];
    if (ph == 0u) return lo;
    uint hi = weight[idx + 1u];
    return (lo >> (ph * 8u)) | (hi << ((4u - ph) * 8u));
}

float readHalf(uint absByteOff) {
    uint alignedIdx = absByteOff >> 2u;
    uint byteInWord = absByteOff & 3u;
    uint u = weight[alignedIdx];
    uint half16;
    if (byteInWord <= 2u) {
        half16 = (u >> (byteInWord * 8u)) & 0xFFFFu;
    } else {
        uint uNext = weight[alignedIdx + 1u];
        half16 = ((u >> 24) & 0xFFu) | ((uNext & 0xFFu) << 8);
    }
    return unpackHalf2x16(half16).x;
}

// 4 signed (q6−32) bytes from one ql word + one qh word, packed for dp4a.
uint packQ6Signed(uint ql4, uint qh4, bool useHigh, uint shift) {
    uint res = 0u;
    for (uint e = 0u; e < 4u; e++) {
        uint qlb = (ql4 >> (e * 8u)) & 0xFFu;
        uint qhb = (qh4 >> (e * 8u)) & 0xFFu;
        uint nib = useHigh ? ((qlb >> 4u) & 0xFu) : (qlb & 0xFu);
        uint high2 = (qhb >> shift) & 3u;
        int q6 = int(nib | (high2 << 4u)) - 32;
        res |= (uint(q6) & 0xFFu) << (e * 8u);
    }
    return res;
}

void main() {
    uint m = gl_WorkGroupID.x * TILE_M + gl_LocalInvocationID.x; // weight row / C col
    uint t = gl_WorkGroupID.y * TILE_N + gl_LocalInvocationID.y; // token row / C row
    uint tid = gl_LocalInvocationID.y * TILE_M + gl_LocalInvocationID.x; // 0..255

    uint mBase = gl_WorkGroupID.x * TILE_M;
    uint tBase = gl_WorkGroupID.y * TILE_N;

    uint rowByteStride = pc.blocksPerRow * SB_BYTES;
    float acc = 0.0;

    for (uint kSB = 0u; kSB < pc.blocksPerRow; kSB++) {
        // ---- 1. Stage weights: 16 rows × 64 element-order int8-uints (decode ql/qh). ----
        for (uint s = 0u; s < 4u; s++) {
            uint idx = tid + s * 256u;       // 0..1023
            uint rLocal = idx >> 6u;         // 0..15 weight row
            uint u      = idx & 63u;         // 0..63 element-order uint within super-block
            uint mGlobal = mBase + rLocal;
            uint packed = 0u;
            if (mGlobal < pc.M) {
                uint blockByteBase = mGlobal * rowByteStride + kSB * SB_BYTES;
                uint cc     = u >> 3u;             // chunk 0..7
                uint localU = u & 7u;             // uint within chunk 0..7
                uint q      = localU >> 1u;        // quarter 0..3
                uint eBase  = (localU & 1u) * 4u;  // 0 or 4
                uint hf     = cc >> 2u;            // half 0..1
                uint group  = cc & 3u;            // group 0..3
                bool useHigh = (group >= 2u);
                uint shift   = group * 2u;
                uint qlByteBase = blockByteBase + (hf * 64u + (group & 1u) * 32u) + q * 8u + eBase;
                uint qhByteBase = blockByteBase + 128u + (hf * 32u) + q * 8u + eBase;
                packed = packQ6Signed(read4Bytes(qlByteBase), read4Bytes(qhByteBase), useHigh, shift);
            }
            sharedWq[rLocal * UINTS_PER_SB + u] = packed;
        }

        // ---- 2. Stage weight scales: 16 rows × 16 sub-blocks (d · scale[s]). ----
        if (tid < TILE_M * SCALES) {
            uint rLocal = tid >> 4u;         // 0..15
            uint sIdx   = tid & 15u;         // 0..15
            uint mGlobal = mBase + rLocal;
            float dsc = 0.0;
            if (mGlobal < pc.M) {
                uint blockByteBase = mGlobal * rowByteStride + kSB * SB_BYTES;
                float d = readHalf(blockByteBase + 208u);
                dsc = d * float(readSByte(blockByteBase + 192u + sIdx));
            }
            sharedWsc[rLocal * SCALES + sIdx] = dsc;
        }

        // ---- 3. Stage activations: 16 token rows × 64 int8-uints (element order). ----
        for (uint s = 0u; s < 4u; s++) {
            uint idx = tid + s * 256u;       // 0..1023
            uint rLocal = idx >> 6u;         // 0..15 token row
            uint u      = idx & 63u;         // 0..63
            uint tGlobal = tBase + rLocal;
            uint v = 0u;
            if (tGlobal < pc.N) {
                uint xqRowBase = tGlobal * (pc.K >> 2u);
                v = xq[xqRowBase + kSB * UINTS_PER_SB + u];
            }
            sharedXq[rLocal * UINTS_PER_SB + u] = v;
        }

        // ---- 4. Stage activation scales: 16 rows × 8 d_x (no s_x — Q6_K symmetric). ----
        if (tid < TILE_N * CHUNKS) {
            uint rLocal = tid >> 3u;
            uint cc     = tid & 7u;
            uint tGlobal = tBase + rLocal;
            float dx = 0.0;
            if (tGlobal < pc.N) {
                dx = xds[tGlobal * (pc.K >> 5u) + kSB * CHUNKS + cc].x;
            }
            sharedXd[rLocal * CHUNKS + cc] = dx;
        }

        barrier();

        // ---- 5. dp4a over this super-block for output cell (t, m). ----
        {
            uint wRow = gl_LocalInvocationID.x; // 0..15
            uint tRow = gl_LocalInvocationID.y; // 0..15
            for (uint cc = 0u; cc < CHUNKS; cc++) {
                uint hf    = cc >> 2u;
                uint group = cc & 3u;
                float scA = sharedWsc[wRow * SCALES + hf * 8u + 2u * group];       // first 16 elems
                float scB = sharedWsc[wRow * SCALES + hf * 8u + 2u * group + 1u];  // next 16 elems
                uint wbase = wRow * UINTS_PER_SB + cc * 8u;
                uint xbase = tRow * UINTS_PER_SB + cc * 8u;
                int dotA = 0, dotB = 0;
                for (uint g = 0u; g < 4u; g++) {
                    dotA = dotPacked4x8AccSatEXT(int(sharedWq[wbase + g]),       int(sharedXq[xbase + g]),       dotA);
                    dotB = dotPacked4x8AccSatEXT(int(sharedWq[wbase + 4u + g]),  int(sharedXq[xbase + 4u + g]),  dotB);
                }
                float dX = sharedXd[tRow * CHUNKS + cc];
                acc += dX * (scA * float(dotA) + scB * float(dotB));
            }
        }

        barrier();
    }

    if (m < pc.M && t < pc.N) {
        c[t * pc.M + m] = acc;
    }
}
